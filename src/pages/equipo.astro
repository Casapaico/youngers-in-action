---
import MinimalLayout from '../layouts/MinimalLayout.astro';
import TeamMemberProfile from '../components/ui/TeamMemberProfile.astro';
import TeamMemberCard from '../components/ui/TeamMemberCard.astro';

const direccion = {
  name: 'Jheison', role: 'Director', area: 'Dirección',
  image: { src: '/images/team/Jheison.png', alt: 'Jheison - Director de Youngers in Action' },
  quote: 'Agrega aquí tu frase o visión...',
  socials: [{ platform: 'linkedin' as const, url: 'https://linkedin.com/in/' }, { platform: 'instagram' as const, url: 'https://instagram.com/' }],
  featured: true,
};

const coordinacionGeneral = {
  name: 'Daisy', role: 'Coordinadora General', area: 'Coordinación General',
  image: { src: '/images/team/Fundadora.webp', alt: 'Daisy - Coordinadora General y Fundadora' },
  quote: 'Agrega aquí tu frase o visión...', badges: ['Fundadora', 'Mentora'],
  socials: [{ platform: 'linkedin' as const, url: 'https://linkedin.com/in/' }, { platform: 'instagram' as const, url: 'https://instagram.com/' }],
  featured: true,
};

const areasCoordinacion = [
  { name: 'Alex', role: 'Coordinador', area: 'Programas y Proyectos', image: { src: '/images/team/alex.webp', alt: 'Alex - Coordinador de Programas y Proyectos' }, quote: 'Agrega aquí tu frase o visión...', socials: [{ platform: 'linkedin' as const, url: 'https://linkedin.com/in/' }] },
  { name: 'Por Elegir', role: 'Coordinador/a', area: 'Fortalecimiento Organizacional', quote: 'Próximamente...' },
  { name: 'Por Elegir', role: 'Coordinador/a', area: 'Comunicaciones y Alianzas', quote: 'Próximamente...' },
];

const mentores = [
  { name: 'Wildo', role: 'Mentor', image: { src: '/images/team/wildo.webp', alt: 'Wildo - Mentor' }, bio: 'Agrega aquí una breve descripción o frase...' },
  { name: 'Daisy', role: 'Mentora', image: { src: '/images/team/Fundadora.webp', alt: 'Daisy - Mentora' }, bio: 'Fundadora y mentora comprometida con el empoderamiento juvenil.', badges: ['Fundadora'] },
];
---

<MinimalLayout
  title="Nuestro Equipo"
  description="Conoce al equipo de jóvenes líderes que impulsa Youngers in Action."
  headerVariant="dark"
>
  <!-- Hero -->
  <section class="relative flex min-h-screen items-center justify-center overflow-hidden bg-neutral-900">
    <div class="absolute inset-0 opacity-20" aria-hidden="true">
      <div class="absolute top-1/4 left-1/4 h-96 w-96 rounded-full bg-[#FFB800] blur-3xl"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
      <span class="mb-4 inline-block text-sm font-medium uppercase tracking-widest text-[#FFB800]" data-reveal>El equipo</span>
      <h1 class="font-display text-4xl font-bold text-white sm:text-5xl md:text-6xl lg:text-7xl" data-reveal>Nuestro Equipo</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-neutral-300 sm:text-xl" data-reveal style="--delay: 200ms">
        Conoce a las personas que hacen posible Youngers in Action. Un equipo comprometido con el empoderamiento de las juventudes.
      </p>
    </div>
  </section>

  <!-- Dirección - Split Screen -->
  <section class="split-section min-h-screen">
    <div class="relative overflow-hidden">
      {direccion.image && (
        <img src={direccion.image.src} alt={direccion.image.alt} class="h-full w-full object-cover" />
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
      <div class="absolute bottom-8 left-8">
        <span class="rounded-full bg-[#FFB800] px-3 py-1 text-xs font-semibold text-neutral-900">{direccion.area}</span>
      </div>
    </div>
    <div class="flex flex-col justify-center bg-white px-8 py-16 md:px-16">
      <span class="mb-2 text-sm font-medium uppercase tracking-widest text-[#FFB800]" data-reveal>Dirección</span>
      <h2 class="font-display text-4xl font-bold text-neutral-900 sm:text-5xl" data-reveal>{direccion.name}</h2>
      <p class="mt-2 text-lg text-neutral-500" data-reveal style="--delay: 100ms">{direccion.role}</p>
      {direccion.quote && <p class="mt-6 text-lg italic text-neutral-600" data-reveal style="--delay: 200ms">"{direccion.quote}"</p>}
    </div>
  </section>

  <!-- Coordinación General - Split Screen (reversed) -->
  <section class="split-section min-h-screen">
    <div class="flex flex-col justify-center bg-neutral-900 px-8 py-16 md:px-16 order-2 md:order-1">
      <span class="mb-2 text-sm font-medium uppercase tracking-widest text-[#FFB800]" data-reveal>Coordinación General</span>
      <h2 class="font-display text-4xl font-bold text-white sm:text-5xl" data-reveal>{coordinacionGeneral.name}</h2>
      <p class="mt-2 text-lg text-neutral-400" data-reveal style="--delay: 100ms">{coordinacionGeneral.role}</p>
      {coordinacionGeneral.badges && (
        <div class="mt-4 flex gap-2" data-reveal style="--delay: 200ms">
          {coordinacionGeneral.badges.map((badge) => (
            <span class="rounded-full bg-[#FFB800]/20 px-3 py-1 text-xs font-medium text-[#FFB800]">{badge}</span>
          ))}
        </div>
      )}
      {coordinacionGeneral.quote && <p class="mt-6 text-lg italic text-neutral-300" data-reveal style="--delay: 300ms">"{coordinacionGeneral.quote}"</p>}
    </div>
    <div class="relative overflow-hidden order-1 md:order-2">
      {coordinacionGeneral.image && (
        <img src={coordinacionGeneral.image.src} alt={coordinacionGeneral.image.alt} class="h-full w-full object-cover" />
      )}
    </div>
  </section>

  <!-- Mentores -->
  <section class="bg-neutral-50 py-24">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <div class="text-center" data-reveal>
        <span class="text-sm font-medium uppercase tracking-widest text-[#FFB800]">Mentoría</span>
        <h2 class="mt-4 font-display text-3xl font-bold text-neutral-900 sm:text-4xl">Nuestros Mentores</h2>
      </div>

      <div class="mx-auto mt-12 grid max-w-3xl gap-8 sm:grid-cols-2" data-reveal-stagger>
        {mentores.map((mentor) => (
          <TeamMemberCard {...mentor} />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#FFB800] py-20">
    <div class="mx-auto max-w-4xl px-6 text-center lg:px-8">
      <h2 class="font-display text-3xl font-bold text-neutral-900 sm:text-4xl" data-reveal>¿Quieres ser parte del equipo?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-neutral-800/80" data-reveal style="--delay: 150ms">
        Buscamos jóvenes comprometidos con el empoderamiento juvenil.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row" data-reveal style="--delay: 300ms">
        <a href="/voluntariado" class="inline-flex items-center justify-center rounded-full bg-neutral-900 px-8 py-3.5 font-semibold text-white transition-all hover:bg-neutral-800">Únete como voluntario/a</a>
        <a href="/contacto" class="inline-flex items-center justify-center rounded-full border-2 border-neutral-900/30 px-8 py-3.5 font-semibold text-neutral-900 transition-all hover:border-neutral-900">Contáctanos</a>
      </div>
    </div>
  </section>
</MinimalLayout>
