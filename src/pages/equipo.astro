---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Section from '../components/ui/Section.astro';
import TeamMemberProfile from '../components/ui/TeamMemberProfile.astro';
import TeamMemberCard from '../components/ui/TeamMemberCard.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';

// Estructura organizacional
// Dirección -> Coordinador General -> Programas y Proyectos / Fortalecimiento Organizacional / Comunicaciones y Alianzas

// Dirección
const direccion = {
  name: 'Jheison',
  role: 'Director',
  area: 'Dirección',
  image: { src: '/images/team/Jheison.png', alt: 'Jheison - Director de Youngers in Action' },
  quote: 'Agrega aquí tu frase o visión...',
  socials: [
    { platform: 'linkedin' as const, url: 'https://linkedin.com/in/' },
    { platform: 'instagram' as const, url: 'https://instagram.com/' },
  ],
  featured: true,
};

// Coordinación General
const coordinacionGeneral = {
  name: 'Daisy',
  role: 'Coordinadora General',
  area: 'Coordinación General',
  image: { src: '/images/team/Fundadora.webp', alt: 'Daisy - Coordinadora General y Fundadora' },
  quote: 'Agrega aquí tu frase o visión...',
  badges: ['Fundadora', 'Mentora'],
  socials: [
    { platform: 'linkedin' as const, url: 'https://linkedin.com/in/' },
    { platform: 'instagram' as const, url: 'https://instagram.com/' },
  ],
  featured: true,
};

// Áreas de coordinación
const areasCoordinacion = [
  {
    name: 'Alex',
    role: 'Coordinador',
    area: 'Programas y Proyectos',
    image: { src: '/images/team/alex.webp', alt: 'Alex - Coordinador de Programas y Proyectos' },
    quote: 'Agrega aquí tu frase o visión...',
    socials: [
      { platform: 'linkedin' as const, url: 'https://linkedin.com/in/' },
    ],
  },
  {
    name: 'Por Elegir',
    role: 'Coordinador/a',
    area: 'Fortalecimiento Organizacional',
    quote: 'Próximamente...',
  },
  {
    name: 'Por Elegir',
    role: 'Coordinador/a',
    area: 'Comunicaciones y Alianzas',
    quote: 'Próximamente...',
  },
];

// Mentores
const mentores = [
  {
    name: 'Wildo',
    role: 'Mentor',
    image: { src: '/images/team/wildo.webp', alt: 'Wildo - Mentor' },
    bio: 'Agrega aquí una breve descripción o frase...',
  },
  {
    name: 'Daisy',
    role: 'Mentora',
    image: { src: '/images/team/Fundadora.webp', alt: 'Daisy - Mentora' },
    bio: 'Fundadora y mentora comprometida con el empoderamiento juvenil.',
    badges: ['Fundadora'],
  },
];

// Valores del equipo
const teamValues = [
  {
    icon: '🎯',
    title: 'Liderazgo juvenil',
    description: 'Jóvenes liderando para jóvenes, impulsando el cambio desde nuestra generación.',
  },
  {
    icon: '🤝',
    title: 'Trabajo colaborativo',
    description: 'Unidos por un propósito común, construimos juntos el futuro.',
  },
  {
    icon: '💡',
    title: 'Innovación social',
    description: 'Creamos soluciones creativas para los desafíos de nuestra comunidad.',
  },
  {
    icon: '💛',
    title: 'Compromiso con el impacto',
    description: 'Cada acción está orientada a generar cambio real y medible.',
  },
];
---

<PageLayout
  title="Nuestro Equipo - Youngers in Action"
  description="Conoce al equipo de jóvenes líderes que impulsa Youngers in Action y trabaja para que ninguna juventud se quede atrás."
>
  <!-- Hero -->
  <Hero
    title="Nuestro Equipo"
    subtitle="Conoce a las personas que hacen posible Youngers in Action. Un equipo comprometido con el empoderamiento y desarrollo de las juventudes."
    size="md"
    align="center"
  />

  <!-- Organigrama visual simple -->
  <Section background="white" spacing="lg">
    <div class="text-center" data-reveal>
      <span class="inline-block rounded-full bg-neutral-100 px-4 py-1 text-sm font-medium text-neutral-700">
        Estructura Organizacional
      </span>
      <h2 class="mt-4 font-display text-3xl font-bold text-neutral-900 sm:text-4xl">
        Cómo nos organizamos
      </h2>
    </div>

    <!-- Organigrama simplificado -->
    <div class="mt-12 flex flex-col items-center gap-4" data-reveal>
      <!-- Dirección -->
      <div class="rounded-xl bg-primary-400 px-6 py-3 font-semibold text-neutral-900 shadow-lg">
        Dirección
      </div>
      <div class="h-8 w-0.5 bg-neutral-300"></div>

      <!-- Coordinación General -->
      <div class="rounded-xl bg-secondary-400 px-6 py-3 font-semibold text-white shadow-lg">
        Coordinación General
      </div>
      <div class="h-8 w-0.5 bg-neutral-300"></div>

      <!-- Áreas -->
      <div class="flex flex-wrap justify-center gap-4">
        <div class="rounded-xl bg-neutral-100 px-4 py-2 text-sm font-medium text-neutral-700 ring-1 ring-neutral-200">
          Programas y Proyectos
        </div>
        <div class="rounded-xl bg-neutral-100 px-4 py-2 text-sm font-medium text-neutral-700 ring-1 ring-neutral-200">
          Fortalecimiento Organizacional
        </div>
        <div class="rounded-xl bg-neutral-100 px-4 py-2 text-sm font-medium text-neutral-700 ring-1 ring-neutral-200">
          Comunicaciones y Alianzas
        </div>
      </div>
    </div>
  </Section>

  <!-- Dirección -->
  <Section background="gray" spacing="lg">
    <div class="text-center" data-reveal>
      <span class="inline-block rounded-full bg-primary-100 px-4 py-1 text-sm font-medium text-primary-700">
        Dirección
      </span>
      <h2 class="mt-4 font-display text-3xl font-bold text-neutral-900 sm:text-4xl">
        Liderazgo de la organización
      </h2>
    </div>

    <div class="mx-auto mt-12 max-w-4xl" data-reveal>
      <TeamMemberProfile {...direccion} imagePosition="left" />
    </div>
  </Section>

  <!-- Coordinación General -->
  <Section background="white" spacing="lg">
    <div class="text-center" data-reveal>
      <span class="inline-block rounded-full bg-secondary-100 px-4 py-1 text-sm font-medium text-secondary-700">
        Coordinación General
      </span>
      <h2 class="mt-4 font-display text-3xl font-bold text-neutral-900 sm:text-4xl">
        Gestión y estrategia
      </h2>
    </div>

    <div class="mx-auto mt-12 max-w-4xl" data-reveal>
      <TeamMemberProfile {...coordinacionGeneral} imagePosition="right" />
    </div>
  </Section>

  <!-- Áreas de Coordinación -->
  <Section background="gray" spacing="lg">
    <div class="text-center" data-reveal>
      <span class="inline-block rounded-full bg-accent-100 px-4 py-1 text-sm font-medium text-accent-700">
        Áreas
      </span>
      <h2 class="mt-4 font-display text-3xl font-bold text-neutral-900 sm:text-4xl">
        Coordinaciones de área
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-600">
        Cada área trabaja de manera coordinada para lograr nuestros objetivos.
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-4xl space-y-8" data-reveal-stagger>
      {areasCoordinacion.map((member, index) => (
        <TeamMemberProfile
          {...member}
          imagePosition={index % 2 === 0 ? 'left' : 'right'}
        />
      ))}
    </div>
  </Section>

  <!-- Mentores -->
  <Section background="white" spacing="lg">
    <div class="text-center" data-reveal>
      <span class="inline-block rounded-full bg-primary-100 px-4 py-1 text-sm font-medium text-primary-700">
        Mentoría
      </span>
      <h2 class="mt-4 font-display text-3xl font-bold text-neutral-900 sm:text-4xl">
        Nuestros Mentores
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-600">
        Personas comprometidas que guían y acompañan el crecimiento de nuestra organización.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-3xl gap-8 sm:grid-cols-2" data-reveal-stagger>
      {mentores.map((mentor) => (
        <TeamMemberCard {...mentor} />
      ))}
    </div>
  </Section>

  <!-- Valores del equipo -->
  <Section background="gray" spacing="lg">
    <div class="text-center" data-reveal>
      <h2 class="font-display text-3xl font-bold text-neutral-900 sm:text-4xl">
        Nuestros valores
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-600">
        Los principios que guían nuestro trabajo diario.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {teamValues.map((value) => (
        <div class="rounded-xl bg-white p-6 text-center ring-1 ring-neutral-200 hover-lift">
          <span class="text-4xl" aria-hidden="true">{value.icon}</span>
          <h3 class="mt-4 font-display text-lg font-bold text-neutral-900">{value.title}</h3>
          <p class="mt-2 text-sm text-neutral-600">{value.description}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- CTA -->
  <CtaBanner
    title="¿Quieres ser parte del equipo?"
    description="Buscamos jóvenes comprometidos con el empoderamiento juvenil. No necesitas experiencia previa, solo ganas de aportar."
    primaryCTA={{ label: 'Únete como voluntario/a', href: '/voluntariado' }}
    secondaryCTA={{ label: 'Contáctanos', href: '/contacto' }}
    background="secondary"
  />
</PageLayout>
