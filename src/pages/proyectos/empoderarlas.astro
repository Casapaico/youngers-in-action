---
import MinimalLayout from '../../layouts/MinimalLayout.astro';
import OdsCard from '../../components/ui/OdsCard.astro';

const odsRelacionados = [4, 8, 9, 10, 16];

const areasAfectadas = [
  { area: 'Ética', porcentaje: 85, color: 'bg-red-500' },
  { area: 'Emocional', porcentaje: 90, color: 'bg-orange-500' },
  { area: 'Económico', porcentaje: 75, color: 'bg-[#FFB800]' },
  { area: 'Social', porcentaje: 88, color: 'bg-green-500' },
  { area: 'Cognitivo', porcentaje: 70, color: 'bg-blue-500' },
  { area: 'Físico', porcentaje: 65, color: 'bg-indigo-500' },
  { area: 'Cultural', porcentaje: 80, color: 'bg-purple-500' },
];

const pilares = [
  { numero: '01', titulo: 'Aprendizaje', descripcion: 'Formación en habilidades blandas, liderazgo y educación financiera adaptada a su edad.', icono: '📚' },
  { numero: '02', titulo: 'Inmersión', descripcion: 'Experiencias prácticas que conectan el conocimiento con situaciones reales de su entorno.', icono: '🌊' },
  { numero: '03', titulo: 'Involucramiento', descripcion: 'Participación activa de familias, docentes y comunidad educativa en el proceso formativo.', icono: '🤝' },
  { numero: '04', titulo: 'Resultados', descripcion: 'Medición de impacto y generación de propuestas concretas desde las y los participantes.', icono: '🎯' },
];

const equipo = {
  mentores: [
    { nombre: 'Ana Lucía Vargas', rol: 'Mentora de Liderazgo' },
    { nombre: 'Carlos Mendoza', rol: 'Mentor de Finanzas' },
    { nombre: 'María José Torres', rol: 'Mentora de Comunicación' },
    { nombre: 'Diego Ramírez', rol: 'Mentor de Innovación' },
    { nombre: 'Lucía Fernández', rol: 'Mentora de Emprendimiento' },
    { nombre: 'Roberto Sánchez', rol: 'Mentor de Tecnología' },
  ],
  autoridades: [
    { nombre: 'Dra. Patricia Huamán', rol: 'Directora I.E. María Auxiliadora' },
    { nombre: 'Mg. Juan Carlos Quispe', rol: 'Coordinador Académico' },
    { nombre: 'Lic. Rosa María Díaz', rol: 'Jefa de Tutoría' },
  ],
  respaldos: [
    { nombre: 'UGEL 05', tipo: 'Respaldo Institucional' },
    { nombre: 'SENAJU', tipo: 'Alianza Estratégica' },
  ],
};

const resultados = [
  { metrica: '+85%', descripcion: 'Participación activa en todas las sesiones' },
  { metrica: '35', descripcion: 'Escolares formados en habilidades de vida' },
  { metrica: '12', descripcion: 'Iniciativas generadas por participantes' },
  { metrica: '5', descripcion: 'Sesiones completadas por grado' },
];

const impactoPropuestas = [
  { categoria: 'Personal', porcentaje: 45, descripcion: 'Desarrollo de autoestima y metas individuales' },
  { categoria: 'Académico', porcentaje: 35, descripcion: 'Mejora en rendimiento y motivación escolar' },
  { categoria: 'Comunitario', porcentaje: 20, descripcion: 'Propuestas de impacto en su entorno' },
];
---

<MinimalLayout
  title="EmpoderArLAS - Proyecto"
  description="Programa de empoderamiento para escolares de 10-12 años enfocado en habilidades de vida, liderazgo y desarrollo integral alineado con los ODS."
  headerVariant="yellow"
>
  <!-- 1. HERO -->
  <section class="relative flex min-h-screen items-center justify-center overflow-hidden bg-neutral-900">
    <!-- Imagen de fondo -->
    <img
      src="/images/empoderarlas5.png"
      alt="Jóvenes de EmpoderArLAS en taller"
      class="absolute inset-0 h-full w-full object-cover object-center"
      loading="eager"
    />
    <!-- Overlay oscuro para legibilidad -->
    <div class="absolute inset-0 bg-neutral-900/65" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
      <span class="mb-4 inline-flex items-center gap-1.5 rounded-full bg-green-500/20 px-4 py-1.5 text-sm font-semibold text-green-400" data-reveal>
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400"></span>
        Proyecto Activo 2024
      </span>
      <h1 class="mt-4 font-display text-4xl font-bold text-white sm:text-5xl md:text-6xl lg:text-7xl" data-reveal>
        Empoder<span class="text-[#FFB800]">Ar</span>LAS
      </h1>
      <p class="mx-auto mt-6 max-w-3xl text-lg text-neutral-300 sm:text-xl" data-reveal style="--delay: 200ms">
        Formando líderes del mañana: programa de empoderamiento integral para escolares comprometidos con su desarrollo personal y comunitario.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-3" data-reveal style="--delay: 400ms">
        {odsRelacionados.map((num) => (
          <OdsCard number={num} size="sm" />
        ))}
      </div>

      <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row" data-reveal style="--delay: 500ms">
        <a href="#metodologia" class="inline-flex items-center justify-center rounded-full bg-[#FFB800] px-8 py-3.5 font-semibold text-neutral-900 transition-all hover:bg-[#E5A600] hover:shadow-lg">
          Conoce la metodología
        </a>
        <a href="/voluntariado" class="inline-flex items-center justify-center rounded-full border-2 border-white/30 px-8 py-3.5 font-semibold text-white transition-all hover:border-white hover:bg-white/10">
          Únete como mentor
        </a>
      </div>
    </div>
  </section>

  <!-- 2. ¿POR QUÉ NACE? - Split Screen -->
  <section class="split-section min-h-screen">
    <div class="relative flex flex-col justify-center bg-white px-8 py-16 md:px-16 overflow-hidden">
      <!-- Logo W de fondo -->
      <img
        src="/images/logo-w.png"
        alt=""
        aria-hidden="true"
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4/5 opacity-30 pointer-events-none select-none"
      />
      <span class="relative mb-2 text-sm font-medium uppercase tracking-widest text-[#FFB800]" data-reveal>Contexto</span>
      <h2 class="relative font-display text-3xl font-bold text-neutral-900 sm:text-4xl" data-reveal>¿Por qué nace EmpoderArLAS?</h2>
      <div class="relative mt-6 space-y-4 text-lg text-neutral-600" data-reveal style="--delay: 150ms">
        <p>
          En el Perú, miles de niñas y adolescentes enfrentan barreras que limitan su desarrollo integral. La falta de acceso a educación de calidad, estereotipos de género y escasas oportunidades de liderazgo afectan su potencial.
        </p>
        <p>
          <strong class="text-neutral-900">EmpoderArLAS</strong> surge como respuesta a esta realidad, creando espacios seguros donde escolares de 10 a 12 años desarrollan habilidades de vida, fortalecen su autoestima y descubren su capacidad de generar cambio.
        </p>
      </div>
    </div>
    <div class="relative overflow-hidden">
      <img
        src="/images/yiaction12.png"
        alt="Jóvenes de Youngers in Action presentando proyectos"
        class=""
        style="position: absolute; top: 0; right: 0; height: 133.33%; width: auto; max-width: none;"
        loading="lazy"
      />
      <div class="absolute bottom-8 left-8 rounded-xl bg-[#FFB800] p-4 shadow-lg">
        <p class="font-display text-3xl font-bold text-neutral-900">35</p>
        <p class="text-sm font-medium text-neutral-800">Escolares impactados</p>
      </div>
    </div>
  </section>

  <!-- 3. ÁREAS AFECTADAS -->
  <section class="relative overflow-hidden" style="background-color: #FEF3E2;">
    <!-- Imagen de fondo completa de izquierda a derecha -->
    <img
      src="/images/roomguys.png"
      alt="Escolares en taller de EmpoderArLAS"
      class="absolute inset-0 w-full h-full object-cover"
      style="object-position: center 80%;"
      loading="lazy"
    />
    <!-- Overlay suave para legibilidad -->
    <div class="absolute inset-0" style="background: rgba(254, 243, 226, 0.65);" aria-hidden="true"></div>

    <!-- Contenido -->
    <div class="relative z-10 mx-auto max-w-7xl px-6 py-20 lg:px-8">
      <div class="text-center" data-reveal>
        <span class="text-sm font-medium uppercase tracking-widest text-[#FFB800]">Diagnóstico</span>
        <h2 class="mt-4 font-display text-3xl font-bold text-neutral-900 sm:text-4xl">Áreas del desarrollo afectadas</h2>
        <p class="mx-auto mt-4 max-w-2xl text-neutral-600">
          Identificamos las dimensiones donde nuestros participantes necesitan mayor acompañamiento.
        </p>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
        {areasAfectadas.map((item) => (
          <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-orange-100">
            <div class="flex items-center justify-between">
              <h3 class="font-semibold text-neutral-900">{item.area}</h3>
              <span class="font-display text-2xl font-bold text-neutral-900">{item.porcentaje}%</span>
            </div>
            <div class="mt-3 h-2 overflow-hidden rounded-full bg-orange-50">
              <div
                class={`h-full rounded-full ${item.color} transition-all duration-1000`}
                style={`width: ${item.porcentaje}%`}
              />
            </div>
            <p class="mt-2 text-xs text-neutral-500">Nivel de intervención requerido</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. METODOLOGÍA - 4 Pilares -->
  <section id="metodologia" class="relative bg-neutral-900 py-24 overflow-hidden">
    <!-- Logo W de fondo -->
    <img
      src="/images/logo-w-dark.png"
      alt=""
      aria-hidden="true"
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-2/3 opacity-10 pointer-events-none select-none"
    />
    <div class="relative z-10 mx-auto max-w-6xl px-6 lg:px-8">
      <div class="text-center" data-reveal>
        <span class="text-sm font-medium uppercase tracking-widest text-[#FFB800]">Metodología</span>
        <h2 class="mt-4 font-display text-3xl font-bold text-white sm:text-4xl">Nuestros 4 pilares</h2>
        <p class="mx-auto mt-4 max-w-2xl text-neutral-400">
          Un enfoque integral que combina teoría y práctica para generar transformación real.
        </p>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
        {pilares.map((pilar) => (
          <article class="group rounded-2xl bg-white/10 p-6 ring-1 ring-white/10 transition-all hover:shadow-lg hover:ring-[#FFB800]/30">
            <span class="font-display text-5xl font-bold text-white/20 transition-colors group-hover:text-[#FFB800]/40">
              {pilar.numero}
            </span>
            <span class="mt-2 block text-3xl" aria-hidden="true">{pilar.icono}</span>
            <h3 class="mt-2 font-display text-xl font-semibold text-white">{pilar.titulo}</h3>
            <p class="mt-2 text-neutral-400">{pilar.descripcion}</p>
          </article>
        ))}
      </div>
    </div>
  </section>




  <!-- 9. CTA -->
  <section class="bg-neutral-900 py-20">
    <div class="mx-auto max-w-4xl px-6 text-center lg:px-8">
      <h2 class="font-display text-3xl font-bold text-white sm:text-4xl" data-reveal>
        Sé parte del cambio
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-neutral-400" data-reveal style="--delay: 150ms">
        Únete como mentor voluntario o apoya con una donación para que más escolares accedan a EmpoderArLAS.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row" data-reveal style="--delay: 300ms">
        <a href="/voluntariado" class="inline-flex items-center justify-center rounded-full bg-[#FFB800] px-8 py-3.5 font-semibold text-neutral-900 transition-all hover:bg-[#E5A600]">
          Quiero ser mentor
        </a>
      </div>
    </div>
  </section>
</MinimalLayout>
