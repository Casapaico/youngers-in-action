---
import MinimalLayout from '../../layouts/MinimalLayout.astro';
import OdsCard from '../../components/ui/OdsCard.astro';

const activeProject = {
  title: 'EmpoderArLAS',
  description: 'Programa de empoderamiento juvenil comunitario para escolares de 10-12 años. Desarrollamos habilidades de liderazgo, autoestima y propuestas de cambio a través de 5 sesiones por grado con enfoque equitativo de género.',
  location: 'Lima, Perú',
  ods: [4, 8, 9, 10, 16] as number[],
  href: '/proyectos/empoderarlas',
  stats: {
    beneficiaries: '35',
    participation: '85%',
    sessions: '5',
  },
};

const upcomingProjects = [
  {
    title: 'EmpoderArLAS 2.0',
    description: 'Expansión del programa a nuevas instituciones educativas y grados. Incorporación de módulos de educación digital y sostenibilidad ambiental.',
    location: 'Lima Metropolitana',
    ods: [4, 5, 13, 17] as number[],
    timeline: '2025',
  },
  {
    title: 'Líderes del Mañana',
    description: 'Programa de formación de facilitadores juveniles para multiplicar el impacto de EmpoderArLAS en sus comunidades.',
    location: 'Perú',
    ods: [4, 8, 17] as number[],
    timeline: '2025',
  },
];

const odsNumbers = [4, 5, 8, 9, 10, 16, 17];

const pilares = [
  { numero: '01', titulo: 'Aprendizaje', descripcion: 'Formación en habilidades blandas y conocimientos adaptados al contexto.' },
  { numero: '02', titulo: 'Inmersión', descripcion: 'Experiencias prácticas que conectan teoría con realidad.' },
  { numero: '03', titulo: 'Involucramiento', descripcion: 'Participación activa de familias y comunidad educativa.' },
  { numero: '04', titulo: 'Resultados en aula', descripcion: 'Medición de impacto y propuestas concretas de los participantes.' },
];
---

<MinimalLayout
  title="Proyectos"
  description="Conoce los proyectos de Youngers in Action: EmpoderArLAS y más iniciativas para el empoderamiento juvenil alineadas con los ODS."
  headerVariant="dark"
>
  <!-- Hero Fullscreen -->
  <section class="relative flex min-h-screen items-center justify-center overflow-hidden bg-neutral-900">
    <div class="absolute inset-0 opacity-20" aria-hidden="true">
      <div class="absolute top-1/4 left-10 h-96 w-96 rounded-full bg-[#FFB800] blur-3xl"></div>
      <div class="absolute bottom-10 right-1/4 h-64 w-64 rounded-full bg-blue-500 blur-3xl"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
      <span class="mb-4 inline-block text-sm font-medium uppercase tracking-widest text-[#FFB800]" data-reveal>Nuestras iniciativas</span>
      <h1 class="font-display text-4xl font-bold text-white sm:text-5xl md:text-6xl lg:text-7xl" data-reveal>
        Nuestros proyectos
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-neutral-300 sm:text-xl" data-reveal style="--delay: 200ms">
        Iniciativas diseñadas por y para jóvenes, alineadas con los ODS y con impacto medible en la comunidad educativa.
      </p>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="bg-[#FFB800] py-10">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-2 gap-6 text-center md:grid-cols-4" data-reveal-stagger>
        <div>
          <p class="font-display text-4xl font-bold text-neutral-900">1</p>
          <p class="mt-1 text-sm text-neutral-800/70">Proyectos activos</p>
        </div>
        <div>
          <p class="font-display text-4xl font-bold text-neutral-900">35</p>
          <p class="mt-1 text-sm text-neutral-800/70">Beneficiarios 2024</p>
        </div>
        <div>
          <p class="font-display text-4xl font-bold text-neutral-900">7</p>
          <p class="mt-1 text-sm text-neutral-800/70">ODS trabajados</p>
        </div>
        <div>
          <p class="font-display text-4xl font-bold text-neutral-900">2</p>
          <p class="mt-1 text-sm text-neutral-800/70">En planificación</p>
        </div>
      </div>
    </div>
  </section>

  <!-- EmpoderArLAS - Split Screen -->
  <section class="split-section min-h-screen">
    <div class="relative overflow-hidden bg-neutral-100">
      <img
        src="/images/fondo_de_inicio_2.png"
        alt="Escolares en sesión de EmpoderArLAS"
        class="h-full w-full object-cover"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-black/10"></div>
      <div class="absolute left-6 top-6">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-green-500 px-3 py-1 text-sm font-semibold text-white">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-white"></span>
          Activo
        </span>
      </div>
    </div>
    <div class="flex flex-col justify-center bg-white px-8 py-16 md:px-16">
      <span class="mb-2 text-sm font-medium uppercase tracking-widest text-[#FFB800]" data-reveal>Proyecto insignia</span>
      <h2 class="font-display text-4xl font-bold text-neutral-900 sm:text-5xl" data-reveal>{activeProject.title}</h2>
      <p class="mt-2 text-neutral-500" data-reveal style="--delay: 100ms">{activeProject.location}</p>
      <p class="mt-6 text-lg text-neutral-600" data-reveal style="--delay: 200ms">{activeProject.description}</p>

      <div class="mt-8 grid grid-cols-3 gap-4 border-t border-neutral-200 pt-8" data-reveal style="--delay: 300ms">
        <div>
          <p class="font-display text-3xl font-bold text-neutral-900">{activeProject.stats.beneficiaries}</p>
          <p class="text-sm text-neutral-500">Beneficiarios</p>
        </div>
        <div>
          <p class="font-display text-3xl font-bold text-neutral-900">{activeProject.stats.participation}</p>
          <p class="text-sm text-neutral-500">Participación</p>
        </div>
        <div>
          <p class="font-display text-3xl font-bold text-neutral-900">{activeProject.stats.sessions}</p>
          <p class="text-sm text-neutral-500">Sesiones/grado</p>
        </div>
      </div>

      <div class="mt-8" data-reveal style="--delay: 400ms">
        <a
          href={activeProject.href}
          class="inline-flex items-center gap-2 rounded-full bg-[#FFB800] px-8 py-3.5 font-semibold text-neutral-900 transition-all hover:bg-[#E5A600] hover:shadow-lg"
        >
          Ver proyecto completo
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Proyectos en desarrollo -->
  <section class="bg-neutral-50 py-24">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <div class="text-center" data-reveal>
        <span class="text-sm font-medium uppercase tracking-widest text-[#FFB800]">Próximamente</span>
        <h2 class="mt-4 font-display text-3xl font-bold text-neutral-900 sm:text-4xl">Proyectos en desarrollo</h2>
        <p class="mx-auto mt-4 max-w-2xl text-neutral-600">
          Iniciativas que estamos diseñando para ampliar nuestro impacto en 2025.
        </p>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-2" data-reveal-stagger>
        {upcomingProjects.map((project) => (
          <article class="group rounded-2xl bg-white p-8 ring-1 ring-neutral-200 transition-all hover:shadow-lg hover:ring-[#FFB800]/20">
            <div class="flex items-center justify-between">
              <span class="text-3xl">🚀</span>
              <span class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-600">{project.timeline}</span>
            </div>
            <h3 class="mt-4 font-display text-xl font-bold text-neutral-900">{project.title}</h3>
            <p class="mt-1 text-sm text-neutral-500">{project.location}</p>
            <p class="mt-4 text-neutral-600">{project.description}</p>
            <div class="mt-6">
              <p class="mb-2 text-xs font-medium uppercase tracking-wide text-neutral-400">ODS objetivo:</p>
              <div class="flex flex-wrap gap-2">
                {project.ods.map((num) => (
                  <OdsCard number={num} size="sm" showTitle={false} />
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Metodología -->
  <section class="bg-white py-24">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <div class="text-center" data-reveal>
        <span class="text-sm font-medium uppercase tracking-widest text-[#FFB800]">Metodología</span>
        <h2 class="mt-4 font-display text-3xl font-bold text-neutral-900 sm:text-4xl">¿Cómo diseñamos nuestros proyectos?</h2>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
        {pilares.map((pilar) => (
          <div class="group rounded-2xl bg-neutral-50 p-6 ring-1 ring-neutral-200 transition-all hover:shadow-md hover:ring-[#FFB800]/20">
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-[#FFB800] font-display text-xl font-bold text-neutral-900">
              {pilar.numero}
            </div>
            <h3 class="mt-4 font-display text-lg font-semibold text-neutral-900">{pilar.titulo}</h3>
            <p class="mt-2 text-sm text-neutral-600">{pilar.descripcion}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ODS -->
  <section class="bg-neutral-900 py-20">
    <div class="mx-auto max-w-5xl px-6 text-center lg:px-8">
      <h2 class="font-display text-2xl font-semibold text-white sm:text-3xl" data-reveal>Nuestro enfoque ODS</h2>
      <p class="mx-auto mt-4 max-w-2xl text-neutral-400" data-reveal style="--delay: 150ms">
        Todos nuestros proyectos están alineados con los Objetivos de Desarrollo Sostenible.
      </p>
      <ul class="mt-10 flex flex-wrap justify-center gap-4" role="list" data-reveal-stagger>
        {odsNumbers.map((num) => (
          <li><OdsCard number={num} size="sm" /></li>
        ))}
      </ul>
      <a href="/ods" class="mt-8 inline-block text-sm font-medium text-[#FFB800] transition-colors hover:text-white" data-reveal style="--delay: 300ms">
        Conoce más sobre nuestro enfoque ODS →
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#FFB800] py-20">
    <div class="mx-auto max-w-4xl px-6 text-center lg:px-8">
      <h2 class="font-display text-3xl font-bold text-neutral-900 sm:text-4xl" data-reveal>
        ¿Tienes una idea de proyecto?
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-neutral-800/80" data-reveal style="--delay: 150ms">
        Buscamos jóvenes con iniciativas alineadas a los ODS. Si tienes una propuesta, queremos escucharte.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row" data-reveal style="--delay: 300ms">
        <a href="/contacto?asunto=propuesta" class="inline-flex items-center justify-center rounded-full bg-neutral-900 px-8 py-3.5 font-semibold text-white transition-all hover:bg-neutral-800">
          Propón tu proyecto
        </a>
        <a href="/voluntariado" class="inline-flex items-center justify-center rounded-full border-2 border-neutral-900/30 px-8 py-3.5 font-semibold text-neutral-900 transition-all hover:border-neutral-900">
          Únete como voluntario
        </a>
      </div>
    </div>
  </section>
</MinimalLayout>
