        <h3 class="mt-2 font-display text-2xl font-bold text-neutral-900">${titular.nombre}</h3>
        <p class="mt-1 text-neutral-600">${titular.tipo}</p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <div class="rounded-xl bg-white p-4 shadow-sm">
            <span class="text-xl">📍</span>
            <p class="mt-2 text-sm font-medium text-neutral-700">Domicilio</p>
