      <div class="mt-6 rounded-xl bg-neutral-100 p-4"><p class="text-sm text-neutral-700"><strong>🔧 Gestión:</strong> Puedes configurar tu navegador para rechazar cookies.</p></div>
    `,
  },
  {
    id: 'cambios',
    icono: '🔄',
    titulo: 'Cambios a esta política',
    requerido: false,
    contenido: `
      <div class="rounded-2xl bg-neutral-50 p-6 ring-1 ring-neutral-200">
        <p>Podemos actualizar esta política periódicamente. Cuando lo hagamos:</p>
        <ul class="mt-4 space-y-3">
          <li class="flex items-start gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#FFB800]/20 text-xs font-bold text-[#FFB800]">1</span><span>Actualizaremos la fecha de "última modificación"</span></li>
          <li class="flex items-start gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#FFB800]/20 text-xs font-bold text-[#FFB800]">2</span><span>Para cambios significativos, te notificaremos por correo electrónico</span></li>
          <li class="flex items-start gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#FFB800]/20 text-xs font-bold text-[#FFB800]">3</span><span>Publicaremos un aviso visible en nuestro sitio web</span></li>
        </ul>
      </div>
    `,
  },
  {
    id: 'contacto',
    icono: '💬',
    titulo: 'Contacto para temas de privacidad',
    requerido: true,
    contenido: `
      <div class="text-center">
        <p class="text-lg">Para cualquier consulta relacionada con esta política o el tratamiento de tus datos:</p>
        <div class="mt-8 inline-flex flex-col items-center gap-4 rounded-2xl bg-neutral-50 p-8 ring-1 ring-neutral-200">
          <span class="text-5xl">📧</span>
          <div>
            <p class="text-sm font-medium text-neutral-500">Responsable de datos personales</p>
            <p class="font-display text-lg font-semibold text-neutral-900">${titular.nombre}</p>
            <a href="mailto:${titular.email}" class="mt-2 block font-display text-2xl font-bold text-[#FFB800] hover:text-[#E5A600]">${titular.email}</a>
          </div>
          <p class="text-sm text-neutral-500">Respondemos en un plazo máximo de 10 días hábiles</p>
        </div>
      </div>
    `,
  },
];
---

<MinimalLayout
  title="Política de Privacidad"
  description="Política de Privacidad de Youngers in Action conforme a la Ley N.º 29733 de Protección de Datos Personales del Perú."
  headerVariant="yellow"
>
  <!-- Hero -->
  <section class="relative flex min-h-[60vh] items-center justify-center overflow-hidden bg-neutral-900">
    <div class="absolute inset-0 opacity-20" aria-hidden="true">
      <div class="absolute top-10 right-10 h-64 w-64 rounded-full bg-[#FFB800] blur-3xl animate-pulse"></div>
      <div class="absolute bottom-10 left-10 h-48 w-48 rounded-full bg-blue-500 blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
      <span class="text-6xl" data-reveal>🔒</span>
      <h1 class="mt-6 font-display text-4xl font-bold text-white sm:text-5xl" data-reveal>Política de Privacidad</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-neutral-300" data-reveal style="--delay: 150ms">
        Conforme a la Ley N.º 29733 - Ley de Protección de Datos Personales del Perú
      </p>
      <p class="mt-6 text-sm text-neutral-500" data-reveal style="--delay: 300ms">Última actualización: {fechaActualizacion}</p>

      <div class="mt-10 rounded-2xl bg-white/10 p-6 text-left backdrop-blur ring-1 ring-white/20" data-reveal style="--delay: 400ms">
        <h2 class="flex items-center gap-2 font-semibold text-white"><span>📌</span> Resumen ejecutivo</h2>
        <div class="mt-4 grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-xl bg-white/10 p-3"><p class="text-neutral-200">🏢 <strong>Responsable:</strong> Youngers in Action</p></div>
          <div class="rounded-xl bg-white/10 p-3"><p class="text-neutral-200">🎯 <strong>Finalidad:</strong> Gestión de voluntariado y programas</p></div>
          <div class="rounded-xl bg-white/10 p-3"><p class="text-neutral-200">⚖️ <strong>Derechos:</strong> ARCO</p></div>
          <div class="rounded-xl bg-white/10 p-3"><p class="text-neutral-200">📧 <strong>Contacto:</strong> {titular.email}</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Compliance Bar -->
  <section class="border-b border-neutral-200 bg-green-50 py-3">
    <div class="mx-auto max-w-7xl px-6">
      <p class="flex items-center justify-center gap-2 text-sm text-green-800">
        <span>✅</span>
        <span>Esta política cumple con los requisitos de la <strong>Ley N.º 29733</strong> y su Reglamento D.S. N.º 003-2013-JUS</span>
      </p>
    </div>
  </section>

  <!-- Nav -->
  <section class="sticky top-0 z-40 border-b border-neutral-200 bg-white/95 backdrop-blur">
    <div class="mx-auto max-w-7xl px-6">
      <nav class="scrollbar-hide flex gap-1 overflow-x-auto py-3" aria-label="Secciones">
        {secciones.map((seccion) => (
          <a
            href={`#${seccion.id}`}
            class:list={[
              "flex shrink-0 items-center gap-2 rounded-full px-4 py-2 text-sm font-medium transition-all hover:bg-[#FFB800]/10 hover:text-neutral-900",
              seccion.requerido ? "text-neutral-700" : "text-neutral-500"
            ]}
          >
            <span>{seccion.icono}</span>
            <span class="hidden lg:inline">{seccion.titulo}</span>
            {seccion.requerido && <span class="hidden h-1.5 w-1.5 rounded-full bg-red-400 sm:block" title="Requerido por ley"></span>}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- Accordion Content -->
  <section class="bg-neutral-50 py-16">
    <div class="mx-auto max-w-4xl space-y-6 px-6">
      {secciones.map((seccion) => (
        <article
          id={seccion.id}
          class="group rounded-2xl bg-white shadow-sm ring-1 ring-neutral-200 transition-all hover:shadow-md scroll-mt-32"
        >
          <button
            class="accordion-trigger flex w-full items-center justify-between p-6 text-left"
            aria-expanded="true"
            aria-controls={`content-${seccion.id}`}
          >
            <div class="flex items-center gap-4">
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-neutral-50 text-2xl ring-1 ring-neutral-200 transition-transform group-hover:scale-110">
                {seccion.icono}
              </span>
              <div class="flex items-center gap-3">
                <h2 class="font-display text-xl font-bold text-neutral-900">{seccion.titulo}</h2>
                {seccion.requerido && <span class="rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-700">Obligatorio</span>}
              </div>
            </div>
            <span class="accordion-icon flex h-8 w-8 items-center justify-center rounded-full bg-neutral-100 text-neutral-500 transition-transform">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </span>
          </button>
          <div id={`content-${seccion.id}`} class="accordion-content overflow-hidden">
            <div class="border-t border-neutral-100 px-6 pb-6 pt-4">
              <div class="prose prose-neutral max-w-none" set:html={seccion.contenido} />
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Legal Footer -->
  <section class="bg-neutral-900 py-12">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <div class="rounded-2xl bg-white/5 p-8 ring-1 ring-white/10">
        <span class="text-4xl">⚖️</span>
        <h2 class="mt-4 font-display text-xl font-semibold text-white">Marco legal aplicable</h2>
        <div class="mt-6 flex flex-wrap justify-center gap-4">
          <div class="rounded-xl bg-white/10 px-4 py-2"><p class="text-sm text-neutral-300">Ley N.º 29733</p><p class="text-xs text-neutral-500">Protección de Datos Personales</p></div>
          <div class="rounded-xl bg-white/10 px-4 py-2"><p class="text-sm text-neutral-300">D.S. N.º 003-2013-JUS</p><p class="text-xs text-neutral-500">Reglamento</p></div>
          <div class="rounded-xl bg-white/10 px-4 py-2"><p class="text-sm text-neutral-300">APDP</p><p class="text-xs text-neutral-500">Autoridad de Protección de Datos</p></div>
        </div>
        <p class="mt-6 text-sm text-neutral-400">Jurisdicción: Lima, Perú</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-white py-12">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <p class="text-neutral-600">¿Tienes preguntas sobre cómo tratamos tus datos?</p>
      <div class="mt-6 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/contacto" class="inline-flex items-center gap-2 rounded-full bg-[#FFB800] px-6 py-3 font-semibold text-neutral-900 transition-all hover:bg-[#E5A600]">Contáctanos</a>
        <a href="/terminos" class="inline-flex items-center gap-2 rounded-full bg-neutral-100 px-6 py-3 font-semibold text-neutral-700 transition-all hover:bg-neutral-200">Ver Términos y Condiciones</a>
      </div>
    </div>
  </section>
</MinimalLayout>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  .accordion-content { max-height: 3000px; transition: max-height 0.3s ease-out; }
  .accordion-content.collapsed { max-height: 0; }
  .accordion-trigger[aria-expanded="false"] .accordion-icon { transform: rotate(-90deg); }
  .prose ul { list-style: none; padding-left: 0; }
  .prose p { margin-bottom: 0; }
  .prose p + p { margin-top: 1rem; }
</style>

<script>
  document.querySelectorAll('.accordion-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      const contentId = trigger.getAttribute('aria-controls');
      const content = document.getElementById(contentId || '');
      trigger.setAttribute('aria-expanded', (!expanded).toString());
      if (content) content.classList.toggle('collapsed', expanded);
    });
  });

  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      e.preventDefault();
      const href = anchor.getAttribute('href');
      if (href) {
        const target = document.querySelector(href);
        target?.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
</script>
