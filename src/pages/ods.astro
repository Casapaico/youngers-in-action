---
import MinimalLayout from '../layouts/MinimalLayout.astro';
import OdsCard from '../components/ui/OdsCard.astro';

const odsData = [
  {
    number: 4, title: 'Educación de calidad', color: '#C5192D',
    descripcion: 'Garantizar una educación inclusiva, equitativa y de calidad, y promover oportunidades de aprendizaje durante toda la vida para todos.',
    comoContribuimos: [
      'EmpoderArLAS desarrolla habilidades blandas y liderazgo en escolares de 10-12 años',
      'Formación en educación financiera adaptada a la edad de los participantes',
      'Metodología que complementa la educación formal con experiencias prácticas',
      'Capacitación a mentores voluntarios en técnicas pedagógicas innovadoras',
    ],
    meta: 'Meta 4.4: Aumentar las competencias para acceder al empleo, trabajo decente y emprendimiento',
    impacto: { valor: '35', descripcion: 'escolares formados en habilidades de vida' },
  },
  {
    number: 5, title: 'Igualdad de género', color: '#FF3A21',
    descripcion: 'Lograr la igualdad entre los géneros y empoderar a todas las mujeres y las niñas.',
    comoContribuimos: [
      'EmpoderArLAS prioriza la participación equitativa de niñas y niños',
      'Sesiones específicas sobre autoestima y liderazgo femenino',
      'Mentoras mujeres como modelos a seguir para las participantes',
      'Análisis de género en todas las propuestas generadas por participantes',
    ],
    meta: 'Meta 5.5: Asegurar la participación plena y efectiva de las mujeres en todos los niveles',
    impacto: { valor: '50%', descripcion: 'de participantes son niñas empoderadas' },
  },
  {
    number: 3, title: 'Salud y bienestar', color: '#4C9F38',
    descripcion: 'Garantizar una vida sana y promover el bienestar para todos en todas las edades.',
    comoContribuimos: [
      'Sesiones enfocadas en salud mental y bienestar emocional',
      'Desarrollo de autoestima y manejo de emociones en escolares',
      'Espacios seguros donde los participantes pueden expresarse libremente',
      'Herramientas para identificar y comunicar estados emocionales',
    ],
    meta: 'Meta 3.4: Promover la salud mental y el bienestar',
    impacto: { valor: '85%', descripcion: 'reportan mayor confianza en sí mismos' },
  },
  {
    number: 8, title: 'Trabajo decente y crecimiento económico', color: '#A21942',
    descripcion: 'Promover el crecimiento económico sostenido, inclusivo y sostenible, el empleo pleno y productivo y el trabajo decente para todos.',
    comoContribuimos: [
      'Educación financiera desde temprana edad para toma de decisiones informadas',
      'Desarrollo de habilidades de emprendimiento y pensamiento económico',
      'Formación en soft skills demandadas por el mercado laboral',
      'Conexión con voluntarios profesionales que comparten experiencias laborales',
    ],
    meta: 'Meta 8.6: Reducir la proporción de jóvenes sin empleo ni formación',
    impacto: { valor: '12', descripcion: 'iniciativas de emprendimiento generadas' },
  },
  {
    number: 17, title: 'Alianzas para lograr los objetivos', color: '#19486A',
    descripcion: 'Fortalecer los medios de implementación y revitalizar la Alianza Mundial para el Desarrollo Sostenible.',
    comoContribuimos: [
      'Alianza estratégica con SENAJU para articular esfuerzos juveniles',
      'Colaboración con UGEL 05 para acceso a instituciones educativas',
      'Participación en foros internacionales como CEPAL ONU',
      'Red de voluntarios y mentores de diversas organizaciones',
    ],
    meta: 'Meta 17.17: Fomentar alianzas eficaces en las esferas pública, público-privada y de la sociedad civil',
    impacto: { valor: '10+', descripcion: 'alianzas institucionales activas' },
  },
];
---

<MinimalLayout
  title="Objetivos de Desarrollo Sostenible"
  description="Conoce cómo Youngers in Action contribuye a los ODS 3, 4, 5, 8 y 17. Trabajamos alineados con la Agenda 2030 y SENAJU."
  headerVariant="dark"
>
  <!-- Hero -->
  <section class="relative flex min-h-screen items-center justify-center overflow-hidden bg-neutral-900">
    <div class="absolute inset-0 opacity-20" aria-hidden="true">
      <div class="absolute top-10 left-10 h-64 w-64 rounded-full bg-[#C5192D] blur-3xl"></div>
      <div class="absolute top-1/2 right-20 h-48 w-48 rounded-full bg-[#4C9F38] blur-3xl"></div>
      <div class="absolute bottom-10 left-1/3 h-56 w-56 rounded-full bg-[#19486A] blur-3xl"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-5xl px-6 text-center">
      <span class="mb-4 inline-block text-sm font-medium uppercase tracking-widest text-[#FFB800]" data-reveal>Agenda 2030</span>
      <h1 class="font-display text-4xl font-bold text-white sm:text-5xl lg:text-7xl" data-reveal>
        Nuestro compromiso con los ODS
      </h1>
      <p class="mx-auto mt-6 max-w-3xl text-lg text-neutral-300 sm:text-xl" data-reveal style="--delay: 200ms">
        Trabajamos alineados con los Objetivos de Desarrollo Sostenible de las Naciones Unidas y las prioridades de SENAJU para las juventudes peruanas.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-3" data-reveal style="--delay: 400ms">
        {odsData.map((ods) => (
          <a
            href={`#ods-${ods.number}`}
            class="flex h-16 w-16 items-center justify-center rounded-xl text-2xl font-bold text-white transition-transform hover:scale-110"
            style={`background-color: ${ods.color};`}
            aria-label={`Ir a ODS ${ods.number}: ${ods.title}`}
          >
            {ods.number}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="bg-white py-12 shadow-sm">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-2 gap-6 text-center md:grid-cols-4" data-reveal-stagger>
        <div>
          <p class="font-display text-4xl font-bold text-neutral-900">5</p>
          <p class="mt-1 text-sm text-neutral-600">ODS priorizados</p>
        </div>
        <div>
          <p class="font-display text-4xl font-bold text-neutral-900">35</p>
          <p class="mt-1 text-sm text-neutral-600">Beneficiarios directos</p>
        </div>
        <div>
          <p class="font-display text-4xl font-bold text-neutral-900">10+</p>
          <p class="mt-1 text-sm text-neutral-600">Alianzas activas</p>
        </div>
        <div>
          <p class="font-display text-4xl font-bold text-neutral-900">100%</p>
          <p class="mt-1 text-sm text-neutral-600">Alineación Agenda 2030</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Each ODS in split-screen alternating -->
  {odsData.map((ods, index) => (
    <section id={`ods-${ods.number}`} class:list={['min-h-screen', index % 2 === 0 ? 'bg-white' : 'bg-neutral-50']}>
      <div class:list={['split-section min-h-screen', index % 2 !== 0 && 'direction-rtl']}>
        <!-- Color side -->
        <div
          class:list={[
            'flex flex-col justify-center px-8 py-16 md:px-16',
            index % 2 !== 0 && 'order-2 md:order-none',
          ]}
          style={`background-color: ${ods.color};`}
        >
          <span class="font-display text-8xl font-bold text-white/20">{ods.number}</span>
          <h2 class="mt-4 font-display text-3xl font-bold text-white sm:text-4xl">{ods.title}</h2>
          <p class="mt-4 text-lg text-white/80">{ods.descripcion}</p>
          <div class="mt-8 rounded-xl bg-white/10 p-4 backdrop-blur">
            <p class="text-sm font-medium text-white/90">{ods.meta}</p>
          </div>
          <div class="mt-6 flex items-center gap-4">
            <span class="font-display text-4xl font-bold text-white">{ods.impacto.valor}</span>
            <span class="text-sm text-white/80">{ods.impacto.descripcion}</span>
          </div>
        </div>

        <!-- Content side -->
        <div
          class:list={[
            'flex flex-col justify-center px-8 py-16 md:px-16',
            index % 2 !== 0 && 'order-1 md:order-none',
          ]}
        >
          <h3 class="font-display text-xl font-semibold text-neutral-900" data-reveal>
            ¿Cómo contribuimos desde YIA?
          </h3>
          <ul class="mt-6 space-y-4" data-reveal-stagger>
            {ods.comoContribuimos.map((item) => (
              <li class="flex items-start gap-3">
                <span
                  class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-xs text-white"
                  style={`background-color: ${ods.color};`}
                >
                  ✓
                </span>
                <span class="text-neutral-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  ))}

  <!-- Impact Numbers -->
  <section class="bg-neutral-900 py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="text-center" data-reveal>
        <span class="text-sm font-medium uppercase tracking-widest text-[#FFB800]">Medición de impacto</span>
        <h2 class="mt-4 font-display text-3xl font-bold text-white sm:text-4xl">Nuestro impacto en números</h2>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
        <div class="rounded-xl bg-white/10 p-6 text-center backdrop-blur">
          <p class="font-display text-4xl font-bold text-[#FFB800]">35</p>
          <p class="mt-1 text-sm text-white/80">Escolares impactados</p>
        </div>
        <div class="rounded-xl bg-white/10 p-6 text-center backdrop-blur">
          <p class="font-display text-4xl font-bold text-[#FFB800]">85%</p>
          <p class="mt-1 text-sm text-white/80">Participación activa</p>
        </div>
        <div class="rounded-xl bg-white/10 p-6 text-center backdrop-blur">
          <p class="font-display text-4xl font-bold text-[#FFB800]">12</p>
          <p class="mt-1 text-sm text-white/80">Iniciativas generadas</p>
        </div>
        <div class="rounded-xl bg-white/10 p-6 text-center backdrop-blur">
          <p class="font-display text-4xl font-bold text-[#FFB800]">67.7%</p>
          <p class="mt-1 text-sm text-white/80">Propuestas personales</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#FFB800] py-20">
    <div class="mx-auto max-w-4xl px-6 text-center lg:px-8">
      <h2 class="font-display text-3xl font-bold text-neutral-900 sm:text-4xl" data-reveal>
        Sé parte del cambio que el mundo necesita
      </h2>
      <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row" data-reveal style="--delay: 200ms">
        <a href="/voluntariado" class="inline-flex items-center justify-center rounded-full bg-neutral-900 px-8 py-3.5 font-semibold text-white transition-all hover:bg-neutral-800">
          Quiero ser voluntario
        </a>
        <a href="/proyectos/empoderarlas" class="inline-flex items-center justify-center rounded-full border-2 border-neutral-900/30 px-8 py-3.5 font-semibold text-neutral-900 transition-all hover:border-neutral-900">
          Conoce EmpoderArLAS
        </a>
      </div>
    </div>
  </section>
</MinimalLayout>

<style>
  .direction-rtl {
    direction: ltr;
  }
  @media (min-width: 769px) {
    .direction-rtl {
      grid-template-columns: 1fr 1fr;
    }
    .direction-rtl > :first-child {
      order: 2;
    }
    .direction-rtl > :last-child {
      order: 1;
    }
  }
</style>
