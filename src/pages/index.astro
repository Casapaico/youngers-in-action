---
import BaseLayout from '../layouts/BaseLayout.astro';
import MinimalHeader from '../components/layout/MinimalHeader.astro';
import FullscreenMenu from '../components/layout/FullscreenMenu.astro';
import DotNavigation from '../components/layout/DotNavigation.astro';
import ImpactGame from '../components/ImpactGame.astro';

const sections = [
  { id: 'game', label: 'Juego' },
  { id: 'hero', label: 'Inicio' },
  { id: 'programa', label: 'EmpoderArLAS' },
  { id: 'impacto', label: 'Impacto' },
  { id: 'sumate', label: 'Súmate' },
  { id: 'aliados', label: 'Aliados' },
];

const socialLinks = [
  { label: 'Instagram', href: 'https://www.instagram.com/youngersinaction/', icon: 'instagram' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/youngers-in-action/', icon: 'linkedin' },
  { label: 'Facebook', href: 'https://www.facebook.com/YoungersinAction/', icon: 'facebook' },
];
---

<BaseLayout
  title="Empoderando juventudes para que nadie quede atrás"
  description="ONG juvenil en Lima, Perú. Empoderamos a escolares de 10-12 años a través de EmpoderArLAS, programa alineado con los ODS y SENAJU."
>
  <FullscreenMenu />
  <MinimalHeader variant="light" />
  <DotNavigation sections={sections} />

  <div class="fullpage-container">

    <!-- ==============================
         0. MINI-JUEGO
         ============================== -->
    <ImpactGame />

    <!-- ==============================
         1. HERO
         ============================== -->
    <section id="hero" class="fullpage-section">
      <div class="split-section">
        <!-- Left panel -->
        <div class="flex flex-col justify-center bg-white px-8 py-24 md:px-12 lg:px-16">
          <span class="mb-8 text-xs font-medium uppercase tracking-[0.2em] text-neutral-400" data-reveal>
            ONG juvenil · Lima, Perú
          </span>
          <h1
            class="font-display text-4xl font-bold leading-[1.1] text-neutral-900 sm:text-5xl lg:text-[3.5rem]"
            data-reveal
            style="--delay:100ms"
          >
            Empoderamos<br />
            juventudes<br />
            para que nadie<br />
            quede atrás
          </h1>
          <div class="mt-10 flex flex-col gap-3 sm:flex-row" data-reveal style="--delay:250ms">
            <a
              href="/proyectos/empoderarlas"
              class="inline-flex items-center justify-center rounded-full bg-neutral-900 px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#FFB800] hover:text-neutral-900"
            >
              Conoce EmpoderArLAS
            </a>
            <a
              href="/voluntariado"
              class="inline-flex items-center justify-center rounded-full border border-neutral-200 px-7 py-3 text-sm font-semibold text-neutral-700 transition-colors hover:border-neutral-900 hover:text-neutral-900"
            >
              Sé voluntario
            </a>
          </div>
        </div>
        <!-- Right panel: photo -->
        <div class="hidden overflow-hidden md:block">
          <img
            src="/images/fondo_de_inicio.png"
            alt="Jóvenes de Youngers in Action"
            class="h-full w-full object-cover"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <!-- ==============================
         2. PROGRAMA
         ============================== -->
    <section id="programa" class="fullpage-section">
      <div class="split-section">
        <!-- Left panel -->
        <div class="flex flex-col justify-center bg-[#FFB800] px-8 py-24 md:px-12 lg:px-16">
          <span class="mb-8 text-xs font-medium uppercase tracking-[0.2em] text-neutral-700/50" data-reveal>
            Nuestro programa
          </span>
          <h2
            class="font-display text-4xl font-bold leading-[1.1] text-neutral-900 sm:text-5xl lg:text-[3.5rem]"
            data-reveal
            style="--delay:100ms"
          >
            EmpoderArLAS
          </h2>
          <p class="mt-5 max-w-xs text-base leading-relaxed text-neutral-800/70" data-reveal style="--delay:200ms">
            Formamos escolares de 10 a 12 años en habilidades blandas, liderazgo y ciudadanía activa.
          </p>
          <a
            href="/proyectos/empoderarlas"
            class="mt-10 inline-flex w-fit items-center gap-2 rounded-full bg-neutral-900 px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-white hover:text-neutral-900"
            data-reveal
            style="--delay:300ms"
          >
            Ver el programa
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
        <!-- Right panel: photo -->
        <div class="hidden overflow-hidden md:block">
          <img
            src="/images/fondo_de_inicio_2.png"
            alt="Escolares en EmpoderArLAS"
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- ==============================
         3. IMPACTO
         ============================== -->
    <section id="impacto" class="fullpage-section">
      <div class="split-section">
        <!-- Left panel -->
        <div class="flex flex-col justify-center bg-neutral-900 px-8 py-24 md:px-12 lg:px-16">
          <span class="mb-10 text-xs font-medium uppercase tracking-[0.2em] text-neutral-500" data-reveal>
            EmpoderArLAS 2024
          </span>

          <div class="space-y-8" data-reveal-stagger>
            <div>
              <div class="flex items-baseline gap-0.5">
                <span class="stat-number font-display text-6xl font-bold text-white" data-target="35" data-animated="false">0</span>
              </div>
              <p class="mt-1 text-sm text-neutral-500">Escolares impactados</p>
            </div>
            <div>
              <div class="flex items-baseline gap-0.5">
                <span class="stat-number font-display text-6xl font-bold text-white" data-target="85" data-animated="false">0</span>
                <span class="font-display text-3xl font-bold text-[#FFB800]">%</span>
              </div>
              <p class="mt-1 text-sm text-neutral-500">Participación activa</p>
            </div>
            <div>
              <div class="flex items-baseline gap-0.5">
                <span class="stat-number font-display text-6xl font-bold text-white" data-target="12" data-animated="false">0</span>
              </div>
              <p class="mt-1 text-sm text-neutral-500">Iniciativas generadas</p>
            </div>
          </div>
        </div>
        <!-- Right panel: photo -->
        <div class="relative hidden overflow-hidden md:block">
          <img
            src="/images/fondo_de_inicio.png"
            alt="Impacto de Youngers in Action"
            class="h-full w-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-neutral-900/20"></div>
        </div>
      </div>
    </section>

    <!-- ==============================
         4. SÚMATE
         ============================== -->
    <section id="sumate" class="fullpage-section">
      <div class="split-section">
        <!-- Left panel -->
        <div class="flex flex-col justify-center bg-white px-8 py-24 md:px-12 lg:px-16">
          <span class="mb-8 text-xs font-medium uppercase tracking-[0.2em] text-neutral-400" data-reveal>
            Únete
          </span>
          <h2
            class="font-display text-4xl font-bold leading-[1.1] text-neutral-900 sm:text-5xl"
            data-reveal
            style="--delay:100ms"
          >
            Sé parte<br />del cambio
          </h2>

          <div class="mt-10 flex flex-col gap-3" data-reveal style="--delay:250ms">
            <a
              href="/voluntariado"
              class="group flex items-center justify-between rounded-xl border border-neutral-100 bg-neutral-50 px-5 py-4 transition-all hover:border-[#FFB800] hover:bg-[#FFB800]/5"
            >
              <span class="text-sm font-semibold text-neutral-900">Voluntariado</span>
              <svg class="h-4 w-4 text-neutral-300 transition-all group-hover:translate-x-0.5 group-hover:text-[#FFB800]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a
              href="/contacto"
              class="group flex items-center justify-between rounded-xl border border-neutral-100 bg-neutral-50 px-5 py-4 transition-all hover:border-[#FFB800] hover:bg-[#FFB800]/5"
            >
              <span class="text-sm font-semibold text-neutral-900">Alianza institucional</span>
              <svg class="h-4 w-4 text-neutral-300 transition-all group-hover:translate-x-0.5 group-hover:text-[#FFB800]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a
              href="/contacto"
              class="group flex items-center justify-between rounded-xl border border-neutral-100 bg-neutral-50 px-5 py-4 transition-all hover:border-[#FFB800] hover:bg-[#FFB800]/5"
            >
              <span class="text-sm font-semibold text-neutral-900">Contacto</span>
              <svg class="h-4 w-4 text-neutral-300 transition-all group-hover:translate-x-0.5 group-hover:text-[#FFB800]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
        <!-- Right panel: accent -->
        <div class="hidden items-center justify-center overflow-hidden bg-[#FFB800] md:flex">
          <span class="select-none font-display text-[22vw] font-bold leading-none text-neutral-900/[0.07]">
            YIA
          </span>
        </div>
      </div>
    </section>

    <!-- ==============================
         5. ALIADOS + FOOTER
         ============================== -->
    <section id="aliados" class="fullpage-section bg-neutral-950 text-white">
      <div class="mx-auto flex h-full min-h-screen max-w-4xl flex-col items-center justify-center px-8 py-16">
        <span class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-neutral-600" data-reveal>
          Instituciones que confían en nosotros
        </span>
        <h2
          class="mb-16 font-display text-2xl font-bold text-white"
          data-reveal
          style="--delay:100ms"
        >
          Nos respaldan
        </h2>

        <div
          class="grid grid-cols-2 items-center justify-items-center gap-10 sm:grid-cols-4 md:gap-16"
          data-reveal-stagger
        >
          {[
            { src: '/logos/senaju.svg', alt: 'SENAJU' },
            { src: '/logos/ugel.svg', alt: 'UGEL 05' },
            { src: '/logos/aliado3.svg', alt: 'Aliado educativo' },
            { src: '/logos/aliado4.svg', alt: 'Aliado institucional' },
          ].map((logo) => (
            <img
              src={logo.src}
              alt={logo.alt}
              class="h-12 w-auto max-w-[140px] object-contain opacity-40 transition-opacity hover:opacity-100"
              loading="lazy"
            />
          ))}
        </div>

        <div class="mt-20 flex flex-col items-center gap-6">
          <a href="/" aria-label="Inicio">
            <img src="/images/logoyia.png" alt="Youngers in Action" class="h-8 rounded-lg" />
          </a>
          <div class="flex gap-5">
            {socialLinks.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-neutral-600 transition-colors hover:text-[#FFB800]"
                aria-label={social.label}
              >
                {social.icon === 'instagram' && (
                  <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                )}
                {social.icon === 'linkedin' && (
                  <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                )}
                {social.icon === 'facebook' && (
                  <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                )}
              </a>
            ))}
          </div>
          <div class="flex flex-wrap items-center justify-center gap-4 text-xs text-neutral-600">
            <a href="/privacidad" class="transition-colors hover:text-neutral-400">Privacidad</a>
            <span>·</span>
            <a href="/terminos" class="transition-colors hover:text-neutral-400">Términos</a>
            <span>·</span>
            <span>&copy; {new Date().getFullYear()} Youngers in Action</span>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  class HomeCounterAnimation {
    private observer: IntersectionObserver;
    private duration = 2000;

    constructor() {
      this.observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              this.animateSection(entry.target as HTMLElement);
              this.observer.unobserve(entry.target);
            }
          });
        },
        {
          root: document.querySelector('.fullpage-container'),
          threshold: 0.4,
        }
      );

      const impacto = document.getElementById('impacto');
      if (impacto) this.observer.observe(impacto);
    }

    private animateSection(section: HTMLElement): void {
      const numbers = section.querySelectorAll('.stat-number[data-animated="false"]');
      numbers.forEach((el, index) => {
        const element = el as HTMLElement;
        const target = parseInt(element.dataset.target || '0', 10);
        setTimeout(() => this.animateNumber(element, target), index * 150);
      });
    }

    private animateNumber(element: HTMLElement, target: number): void {
      element.dataset.animated = 'true';
      const startTime = performance.now();

      const animate = (currentTime: number) => {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / this.duration, 1);
        const easeProgress = 1 - Math.pow(1 - progress, 4);
        const currentValue = Math.round(target * easeProgress);
        element.textContent = currentValue.toString();
        if (progress < 1) requestAnimationFrame(animate);
        else element.textContent = target.toString();
      };

      requestAnimationFrame(animate);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new HomeCounterAnimation());
  } else {
    new HomeCounterAnimation();
  }
</script>
