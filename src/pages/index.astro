---
import BaseLayout from '../layouts/BaseLayout.astro';
import MinimalHeader from '../components/layout/MinimalHeader.astro';
import FullscreenMenu from '../components/layout/FullscreenMenu.astro';
import DotNavigation from '../components/layout/DotNavigation.astro';
import ImpactGame from '../components/ImpactGame.astro';

const sections = [
  { id: 'game', label: 'Juego' },
  { id: 'hero', label: 'Inicio' },
  { id: 'programa', label: 'EmpoderArLAS' },
  { id: 'sumate', label: 'ODS' },
  { id: 'cambio', label: 'Únete' },
  { id: 'aliados', label: 'Aliados' },
];

const socialLinks = [
  { label: 'Instagram', href: 'https://www.instagram.com/youngersinaction/', icon: 'instagram' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/youngers-in-action/', icon: 'linkedin' },
  { label: 'Facebook', href: 'https://www.facebook.com/YoungersinAction/', icon: 'facebook' },
];
---

<BaseLayout
  title="Empoderando juventudes para que nadie quede atrás"
  description="ONG juvenil en Lima, Perú. Empoderamos a escolares de 10-12 años a través de EmpoderArLAS, programa alineado con los ODS y SENAJU."
>
  <FullscreenMenu />
  <MinimalHeader variant="yellow" />
  <DotNavigation sections={sections} />

  <div class="fullpage-container">

    <!-- ==============================
         0. MINI-JUEGO
         ============================== -->
    <ImpactGame />

    <!-- ==============================
         1. HERO
         ============================== -->
    <section id="hero" class="fullpage-section relative overflow-hidden bg-white">

      <!-- IMAGEN DESKTOP: cubre todo desde debajo del header -->
      <div class="absolute right-0 left-0 z-[0] hidden md:block"
           style="top: var(--header-h, 80px); height: calc(100% - var(--header-h, 80px));">
        <img
          src="/images/hero-main.jpg"
          alt="Jóvenes de Youngers in Action"
          class="h-full w-full object-cover"
          style="object-position: 65% center"
          loading="eager"
        />
      </div>

      <!-- IMAGEN MÓVIL: aparece en la mitad inferior con fundido hacia arriba -->
      <div class="absolute inset-x-0 bottom-0 z-[0] h-[50%] md:hidden">
        <img
          src="/images/hero-main.jpg"
          alt=""
          aria-hidden="true"
          class="h-full w-full object-cover"
          style="object-position: 65% top"
          loading="eager"
        />
        <!-- Gradiente blanco→transparente que fusiona la imagen con el fondo -->
        <div class="absolute inset-0 bg-gradient-to-b from-white via-white/30 to-transparent pointer-events-none"></div>
      </div>

      <!-- CONTENIDO: texto y botones encima de todo -->
      <!-- Móvil: alineado arriba (texto claro sobre blanco, imagen abajo)  -->
      <!-- Desktop: centrado verticalmente dentro del panel izquierdo        -->
      <div class="relative z-10 flex flex-col justify-start px-8 pb-8 md:justify-center md:py-28 md:px-12 lg:px-16 w-full md:max-w-[52%]"
           style="height:100vh; height:100dvh; padding-top: calc(var(--header-h, 80px) + 2rem);">
        <span class="relative mb-6 text-xs font-medium uppercase tracking-[0.2em] text-neutral-400" data-reveal>
          ONG Juvenil · Lima, Perú
        </span>
        <h1
          class="hero-title relative font-display text-[2.25rem] font-extrabold leading-[1.05] text-neutral-900 sm:text-5xl lg:text-[4rem]"
          data-reveal
          style="--delay:100ms"
        >
          Empoderamos<br />
          juventudes<br />
          para que nadie<br />
          quede atrás
        </h1>
        <div class="relative mt-8 flex flex-wrap gap-3" data-reveal style="--delay:250ms">
          <a
            href="/proyectos/empoderarlas"
            class="inline-flex items-center justify-center rounded-full bg-neutral-900 px-7 py-3.5 text-sm font-bold text-white transition-colors hover:bg-[#FFB800] hover:text-neutral-900"
          >
            Conoce EmpoderArLAS
          </a>
          <a
            href="/voluntariado"
            class="inline-flex items-center justify-center rounded-full border-2 border-neutral-300 px-7 py-3.5 text-sm font-bold text-neutral-700 transition-colors hover:border-neutral-900 hover:text-neutral-900"
          >
            Sé voluntario
          </a>
        </div>
      </div>

    </section>

    <!-- ==============================
         2. PROGRAMA
         ============================== -->
    <section id="programa" class="fullpage-section relative overflow-hidden bg-[#FFB800]">

      <!-- Desktop: gráfico SVG original -->
      <img
        src="/images/programa-bg.svg"
        alt="EmpoderArLAS"
        class="absolute inset-0 h-full w-full object-cover object-center hidden md:block"
      />

      <!-- Móvil: imagen de participación juvenil -->
      <img
        src="/images/yiaction4.png"
        alt="Participación juvenil EmpoderArLAS"
        class="absolute inset-0 h-full w-full object-cover object-center block md:hidden"
        loading="eager"
      />
      <!-- Gradiente + texto inferior: solo en móvil -->
      <div class="absolute inset-x-0 bottom-0 z-10 flex flex-col justify-end pb-10 px-6 md:hidden"
           style="height: 55%;">
        <!-- Gradiente oscuro de abajo hacia arriba -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent pointer-events-none" aria-hidden="true"></div>
        <!-- Textos -->
        <div class="relative z-10">
          <span class="inline-block rounded-full bg-[#FFB800] px-3 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-neutral-900">
            Nuestro programa
          </span>
          <h2 class="mt-2 font-display text-3xl font-extrabold leading-tight text-white">
            EmpoderArLAS
          </h2>
          <p class="mt-2 text-sm font-medium leading-snug text-white/80">
            Empoderamos juventudes para que nadie quede atrás
          </p>
        </div>
      </div>

      <!-- Botón CTA flecha central -->
      <a
        href="/proyectos/empoderarlas"
        aria-label="Ver EmpoderArLAS"
        id="btn-empoderarlas"
        class="absolute top-1/2 z-10 -translate-x-1/2 -translate-y-1/2"
        style="left: 49%"
      >
        <div class="arrow-btn">
          <div class="arrow-glow"></div>
          <div class="arrow-ring"></div>
          <svg class="arrow-icon" viewBox="0 0 40 40" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 30 L30 10 M30 10 H16 M30 10 V24" />
          </svg>
        </div>
      </a>

      <style>
        .arrow-btn {
          position: relative;
          width: clamp(5rem, 7vw, 8rem);
          height: clamp(5rem, 7vw, 8rem);
          display: flex;
          align-items: center;
          justify-content: center;
          cursor: pointer;
        }

        /* Círculo principal */
        .arrow-btn::before {
          content: '';
          position: absolute;
          inset: 0;
          border-radius: 50%;
          background: #171717;
          transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
                      box-shadow 0.4s ease;
        }

        /* Móvil: botón más transparente */
        @media (max-width: 767px) {
          .arrow-btn::before {
            background: rgba(23, 23, 23, 0.45);
          }
        }

        /* Anillo exterior pulsante */
        .arrow-ring {
          position: absolute;
          inset: -4px;
          border-radius: 50%;
          border: 2px solid rgba(255, 184, 0, 0);
          transition: border-color 0.3s ease, inset 0.4s ease, opacity 0.3s ease;
        }

        /* Halo de luz */
        .arrow-glow {
          position: absolute;
          inset: 0;
          border-radius: 50%;
          background: radial-gradient(circle, rgba(255,184,0,0.4) 0%, transparent 70%);
          opacity: 0;
          scale: 0.5;
          transition: opacity 0.4s ease, scale 0.4s ease;
        }

        /* Flecha SVG */
        .arrow-icon {
          position: relative;
          z-index: 1;
          width: 45%;
          height: 45%;
          transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
                      filter 0.3s ease;
        }

        /* HOVER */
        .arrow-btn:hover::before {
          transform: scale(1.15);
          box-shadow: 0 0 30px rgba(255,184,0,0.5),
                      0 0 60px rgba(255,184,0,0.25),
                      0 0 100px rgba(255,184,0,0.1);
        }

        .arrow-btn:hover .arrow-ring {
          inset: -10px;
          border-color: rgba(255, 184, 0, 0.6);
        }

        .arrow-btn:hover .arrow-glow {
          opacity: 1;
          scale: 2;
        }

        .arrow-btn:hover .arrow-icon {
          transform: translate(3px, -3px) scale(1.2);
          filter: drop-shadow(0 0 6px rgba(255,184,0,0.8));
        }

        /* Click */
        .arrow-btn:active::before {
          transform: scale(0.95);
        }
      </style>

    </section>

    <!-- ==============================
         4. ODS
         ============================== -->
    <section id="sumate" class="fullpage-section relative overflow-hidden bg-neutral-900">

      <!-- ── MÓVIL: foto + grid 2×2 con fichas completas ── -->
      <div class="absolute inset-0 flex flex-col md:hidden">

        <!-- Foto + título -->
        <div class="relative" style="height: 38%">
          <img
            src="/images/ods-personas.png"
            alt="Jóvenes de Youngers in Action presentando en evento"
            class="h-full w-full object-cover"
            style="object-position: 30% center"
            loading="lazy"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-neutral-900 px-5 py-3">
            <h2 class="ods-heading font-display font-bold leading-[1.05] text-white"
                style="font-size: clamp(1.35rem, 5vw, 2rem)">
              Nuestro compromi<span style="color:#D63384">so</span>
              con los OD<span style="color:#D63384">S</span>
            </h2>
          </div>
        </div>

        <!-- Grid 2×2: fichas con nombre + descripción siempre visibles -->
        <div class="grid grid-cols-2" style="height: 62%">

          <!-- ODS 4 -->
          <div class="ods-m relative flex flex-col justify-end overflow-hidden bg-[#C5192D] p-4">
            <span class="ods-m-num text-[#9B1520]">4</span>
            <div class="relative z-10">
              <span class="ods-m-label">ODS 4</span>
              <h3 class="ods-m-title">Educación<br/>de calidad</h3>
              <p class="ods-m-desc">Educación inclusiva y de calidad para todos.</p>
            </div>
          </div>

          <!-- ODS 5 -->
          <div class="ods-m relative flex flex-col justify-end overflow-hidden bg-[#FF3A21] p-4">
            <span class="ods-m-num text-[#CC2E1A]">5</span>
            <div class="relative z-10">
              <span class="ods-m-label">ODS 5</span>
              <h3 class="ods-m-title">Igualdad<br/>de género</h3>
              <p class="ods-m-desc">Empoderamiento de mujeres y niñas.</p>
            </div>
          </div>

          <!-- ODS 3 -->
          <div class="ods-m relative flex flex-col justify-end overflow-hidden bg-[#4C9F38] p-4">
            <span class="ods-m-num text-[#3A7D2B]">3</span>
            <div class="relative z-10">
              <span class="ods-m-label">ODS 3</span>
              <h3 class="ods-m-title">Salud y<br/>bienestar</h3>
              <p class="ods-m-desc">Vida sana y bienestar para todas las edades.</p>
            </div>
          </div>

          <!-- ODS 8 -->
          <div class="ods-m relative flex flex-col justify-end overflow-hidden bg-[#A21942] p-4">
            <span class="ods-m-num text-[#7A1232]">8</span>
            <div class="relative z-10">
              <span class="ods-m-label">ODS 8</span>
              <h3 class="ods-m-title">Trabajo<br/>digno</h3>
              <p class="ods-m-desc">Empleo pleno y crecimiento económico.</p>
            </div>
          </div>

        </div>
      </div>

      <!-- ── DESKTOP: foto + bandas diagonales interactivas ── -->

      <!-- LEFT: Foto con clip diagonal -->
      <div class="absolute inset-0 hidden md:block" style="clip-path: polygon(0 0, 44% 0, 37% 100%, 0 100%)">
        <img
          src="/images/ods-personas.png"
          alt="Jóvenes de Youngers in Action presentando en evento"
          class="h-full w-full object-cover"
          style="object-position: 30% center"
          loading="lazy"
        />
        <div class="absolute bottom-0 left-0 right-0 bg-neutral-900 px-6 py-5">
          <h2 class="ods-heading font-display font-bold leading-[1.05] text-white"
              style="font-size: clamp(2rem, 4vw, 3.8rem)">
            Nuestro<br/>
            compromi<span style="color:#D63384">so</span><br/>
            con los OD<span style="color:#D63384">S</span>
          </h2>
        </div>
      </div>

      <!-- BANDA 1: ODS 4 -->
      <div class="ods-band hidden md:block absolute inset-0 bg-[#C5192D]"
           style="clip-path: polygon(44% 0%, 58.25% 0%, 51.25% 100%, 37% 100%)">
        <span class="ods-band-num text-[#9B1520]"
              style="top: 2%; left: 50%; transform: translateX(-50%)">4</span>
        <div class="ods-band-body" style="top: 50%; left: 48%;">
          <h3 class="ods-band-title">Educación<br/>de calidad</h3>
          <p class="ods-band-desc">Educación inclusiva y equitativa para todos</p>
        </div>
      </div>

      <!-- BANDA 2: ODS 5 -->
      <div class="ods-band hidden md:block absolute inset-0 bg-[#FF3A21]"
           style="clip-path: polygon(58.25% 0%, 72.5% 0%, 65.5% 100%, 51.25% 100%)">
        <span class="ods-band-num text-[#CC2E1A]"
              style="bottom: 2%; left: 60%; transform: translateX(-50%)">5</span>
        <div class="ods-band-body" style="top: 50%; left: 62%;">
          <h3 class="ods-band-title">Igualdad<br/>de género</h3>
          <p class="ods-band-desc">Igualdad entre géneros y empoderamiento femenino</p>
        </div>
      </div>

      <!-- BANDA 3: ODS 3 -->
      <div class="ods-band hidden md:block absolute inset-0 bg-[#4C9F38]"
           style="clip-path: polygon(72.5% 0%, 86.75% 0%, 79.75% 100%, 65.5% 100%)">
        <span class="ods-band-num text-[#3A7D2B]"
              style="top: 2%; left: 78%; transform: translateX(-50%)">3</span>
        <div class="ods-band-body" style="top: 50%; left: 76%;">
          <h3 class="ods-band-title">Salud y<br/>bienestar</h3>
          <p class="ods-band-desc">Vida sana y bienestar para todas las edades</p>
        </div>
      </div>

      <!-- BANDA 4: ODS 8 -->
      <div class="ods-band hidden md:block absolute inset-0 bg-[#A21942]"
           style="clip-path: polygon(86.75% 0%, 100% 0%, 100% 100%, 79.75% 100%)">
        <span class="ods-band-num text-[#7A1232]"
              style="bottom: 2%; left: 90%; transform: translateX(-50%)">8</span>
        <div class="ods-band-body" style="top: 50%; left: 92%;">
          <h3 class="ods-band-title">Trabajo<br/>digno</h3>
          <p class="ods-band-desc">Empleo pleno y crecimiento económico sostenible</p>
        </div>
      </div>

      <style>
        /* ──── MÓVIL ──── */
        .ods-m-num {
          position: absolute;
          top: -5%;
          left: 50%;
          transform: translateX(-50%);
          font-family: 'Poppins', sans-serif;
          font-weight: 900;
          font-size: clamp(6rem, 22vw, 9rem);
          line-height: 1;
          pointer-events: none;
          user-select: none;
        }
        .ods-m-label {
          display: block;
          font-size: 10px;
          font-weight: 700;
          letter-spacing: 0.18em;
          text-transform: uppercase;
          color: rgba(255,255,255,0.55);
        }
        .ods-m-title {
          font-family: 'Poppins', sans-serif;
          font-weight: 800;
          font-size: clamp(0.9rem, 3.5vw, 1.05rem);
          line-height: 1.2;
          color: #fff;
          margin-top: 2px;
        }
        .ods-m-desc {
          font-size: 11px;
          line-height: 1.45;
          color: rgba(255,255,255,0.7);
          margin-top: 4px;
        }

        /* ──── DESKTOP: BANDAS DIAGONALES ──── */

        /* Número decorativo de fondo */
        .ods-band-num {
          position: absolute;
          font-family: 'Poppins', sans-serif;
          font-weight: 900;
          font-size: clamp(10rem, 18vw, 26rem);
          line-height: 1;
          pointer-events: none;
          user-select: none;
          transition: opacity 0.4s ease;
        }
        .ods-band:hover .ods-band-num { opacity: 0.35; }

        /* Contenedor de texto rotado: sube en hover */
        .ods-band-body {
          position: absolute;
          transform: translate(-50%, -50%) rotate(-55deg);
          text-align: center;
          white-space: nowrap;
          transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .ods-band:hover .ods-band-body {
          transform: translate(-50%, calc(-50% - 14px)) rotate(-55deg);
        }

        /* Nombre: MÁS GRANDE */
        .ods-band-title {
          font-family: 'Poppins', sans-serif;
          font-weight: 800;
          font-size: clamp(1.25rem, 2vw, 2rem);
          line-height: 1.15;
          color: #1a1a1a;
          text-align: center;
          white-space: nowrap;
        }

        /* Descripción: aparece en hover */
        .ods-band-desc {
          font-size: clamp(0.8rem, 1.1vw, 1rem);
          line-height: 1.4;
          color: rgba(0,0,0,0.65);
          text-align: center;
          margin-top: 10px;
          white-space: normal;
          max-width: 130px;
          opacity: 0;
          transform: translateY(6px);
          transition: opacity 0.35s ease 0.1s, transform 0.35s ease 0.1s;
        }
        .ods-band:hover .ods-band-desc {
          opacity: 1;
          transform: translateY(0);
        }

        /* Brillo suave al pasar el cursor */
        .ods-band {
          transition: filter 0.3s ease;
          cursor: default;
        }
        .ods-band:hover {
          filter: brightness(1.1);
          z-index: 2;
        }

        /* ──── backInRight para el título ODS ──── */
        @keyframes backInRight {
          0% {
            transform: translateX(2000px) scale(0.7);
            opacity: 0.7;
          }
          80% {
            transform: translateX(0px) scale(0.7);
            opacity: 0.7;
          }
          100% {
            transform: scale(1);
            opacity: 1;
          }
        }

        .ods-heading {
          animation: backInRight 1s cubic-bezier(0.22, 1, 0.36, 1) both;
          animation-play-state: paused;
        }
        .ods-heading.ods-animate {
          animation-play-state: running;
        }

        @media (prefers-reduced-motion: reduce) {
          .ods-heading { animation: none; }
        }
      </style>

    </section>

    <!-- ==============================
         5. ÚNETE / SÉ PARTE DEL CAMBIO
         ============================== -->
    <section id="cambio" class="fullpage-section relative overflow-hidden">

      <!-- Imagen de fondo -->
      <img
        src="/images/sumate-bg.png"
        alt="Sé parte del cambio"
        class="absolute inset-0 h-full w-full object-cover object-center"
        loading="lazy"
      />

      <!-- Card CTA: centrado abajo en móvil, esquina superior derecha en desktop -->
      <div class="absolute
                  bottom-10 left-1/2 -translate-x-1/2 w-[88%] max-w-sm
                  md:top-8 md:right-8 md:bottom-auto md:left-auto md:translate-x-0 md:w-auto md:max-w-[340px]
                  rounded-2xl bg-white px-6 py-5 md:px-8 md:py-6 shadow-lg">
        <span class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-400">Únete</span>
        <h2 class="mt-2 font-display font-extrabold leading-[1.0] text-neutral-900"
            style="font-size: clamp(2rem, 4.5vw, 4rem)">
          Sé parte<br/>del cambio
        </h2>
        <div class="mt-5 flex flex-col gap-2 md:hidden">
          <a href="/voluntariado"
             class="flex items-center justify-center rounded-full bg-neutral-900 px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-[#FFB800] hover:text-neutral-900">
            Sé voluntario/a
          </a>
          <a href="/contacto"
             class="flex items-center justify-center rounded-full border-2 border-neutral-200 px-6 py-3 text-sm font-bold text-neutral-700 transition-colors hover:border-neutral-900">
            Contáctanos
          </a>
        </div>
      </div>

    </section>

    <!-- ==============================
         6. ALIADOS
         ============================== -->
    <section id="aliados" class="fullpage-section bg-neutral-950 text-white overflow-hidden">
      <div class="relative flex h-full min-h-screen flex-col">

        <!-- Logo W de fondo -->
        <img
          src="/images/logo-w-dark.png"
          alt=""
          aria-hidden="true"
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full opacity-5 pointer-events-none select-none"
        />

        <!-- CONTENIDO CENTRAL -->
        <div class="relative z-10 flex flex-1 flex-col items-center justify-center px-8 py-10 md:py-20">

          <!-- Etiqueta superior -->
          <span class="mb-4 inline-block rounded-full border border-neutral-800 px-4 py-1 text-[11px] font-semibold uppercase tracking-[0.25em] text-neutral-500">
            Instituciones que confían en nosotros
          </span>

          <!-- Título grande -->
          <h2 class="mb-8 md:mb-20 font-display text-4xl font-extrabold text-white sm:text-5xl lg:text-6xl">
            Nos respaldan
          </h2>

          <!-- Logos de aliados -->
          <div class="flex flex-col items-center justify-center gap-10 sm:flex-row sm:gap-16 md:gap-24">

            <!-- SENAJU -->
            <div class="aliado-logo group flex items-center justify-center">
              <img
                src="/images/Logo-Web-SENAJU.png"
                alt="SENAJU — Secretaría Nacional de la Juventud"
                class="h-16 w-auto object-contain opacity-70 transition-all duration-500 group-hover:opacity-100 md:h-20"
              />
            </div>

            <!-- Separador vertical (solo desktop) -->
            <div class="hidden h-16 w-px bg-neutral-700 sm:block" aria-hidden="true"></div>

            <!-- Conecta y Acciona -->
            <div class="aliado-logo group flex items-center justify-center">
              <img
                src="/images/alianza-removebg-preview.png"
                alt="Conecta y Acciona"
                class="h-20 w-auto object-contain opacity-70 transition-all duration-500 group-hover:opacity-100 md:h-24"
              />
            </div>

          </div>
        </div>

        <!-- FOOTER MÍNIMO -->
        <div class="border-t border-neutral-900 px-8 py-8">
          <div class="mx-auto flex max-w-3xl flex-col items-center gap-5 sm:flex-row sm:justify-between">
            <!-- Logo -->
            <a href="/" aria-label="Inicio">
              <img src="/images/logoyia.png" alt="Youngers in Action" class="h-7 rounded-lg opacity-70 transition-opacity hover:opacity-100" />
            </a>
            <!-- Redes -->
            <div class="flex gap-4">
              {socialLinks.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-neutral-600 transition-colors hover:text-[#FFB800]"
                  aria-label={social.label}
                >
                  {social.icon === 'instagram' && (
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                  )}
                  {social.icon === 'linkedin' && (
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                  )}
                  {social.icon === 'facebook' && (
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
