---
import MinimalLayout from '../layouts/MinimalLayout.astro';

const numeroContacto = '+51 999 888 777';
const numeroYape = '999 888 777';

const tiposDonaciones = [
  { icono: '💻', titulo: 'Equipos tecnológicos', descripcion: 'Computadoras, laptops, tablets de institutos, universidades o empresas.' },
  { icono: '📚', titulo: 'Material educativo', descripcion: 'Libros, útiles escolares, material didáctico para talleres.' },
  { icono: '💰', titulo: 'Donaciones monetarias', descripcion: 'Aportes vía Yape para materiales, logística y capacitaciones.' },
  { icono: '🎨', titulo: 'Materiales creativos', descripcion: 'Insumos para talleres de arte, manualidades y expresión.' },
];

const pasosDonar = [
  { numero: '01', titulo: 'Contáctanos', descripcion: 'Escríbenos por WhatsApp o llámanos para coordinar tu donación.' },
  { numero: '02', titulo: 'Coordinamos', descripcion: 'Acordamos el tipo de donación, lugar y fecha de entrega o recojo.' },
  { numero: '03', titulo: 'Recibimos', descripcion: 'Recogemos tu donación o la recibes en nuestro punto de acopio.' },
  { numero: '04', titulo: 'Impactamos', descripcion: 'Tu donación llega directamente a los jóvenes que la necesitan.' },
];
---

<MinimalLayout
  title="Dona"
  description="Apoya a Youngers in Action con donaciones de equipos, materiales educativos o aportes económicos vía Yape."
  headerVariant="dark"
>
  <!-- Hero -->
  <section class="relative flex min-h-screen items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-neutral-900 via-[#6B2D83]/80 to-neutral-900"></div>
    <div class="absolute inset-0 opacity-30" aria-hidden="true">
      <div class="absolute top-20 left-10 h-96 w-96 rounded-full bg-[#FFB800] blur-3xl animate-pulse"></div>
      <div class="absolute bottom-20 right-10 h-80 w-80 rounded-full bg-[#6B2D83] blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
      <span class="mb-4 inline-block text-sm font-medium uppercase tracking-widest text-[#FFB800]" data-reveal>Haz posible el cambio</span>
      <h1 class="font-display text-4xl font-bold text-white sm:text-5xl md:text-6xl lg:text-7xl" data-reveal>
        Tu apoyo transforma vidas
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-neutral-200 sm:text-xl" data-reveal style="--delay: 200ms">
        Cada donación, grande o pequeña, ayuda a empoderar a jóvenes que sueñan con un futuro mejor.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row" data-reveal style="--delay: 400ms">
        <a href="#yape" class="inline-flex items-center justify-center rounded-full bg-[#FFB800] px-8 py-3.5 font-semibold text-neutral-900 transition-all hover:bg-[#E5A600] hover:shadow-lg">
          Donar con Yape
        </a>
        <a href="#tipos-donacion" class="inline-flex items-center justify-center rounded-full border-2 border-white/30 px-8 py-3.5 font-semibold text-white transition-all hover:border-white hover:bg-white/10">
          Ver formas de donar
        </a>
      </div>
    </div>
  </section>

  <!-- Yape Section -->
  <section id="yape" class="bg-gradient-to-br from-[#6B2D83] via-[#8B3FA3] to-[#6B2D83] py-24">
    <div class="mx-auto max-w-4xl px-6 lg:px-8">
      <div class="split-section items-center gap-12">
        <div class="text-center lg:text-left">
          <h2 class="font-display text-3xl font-bold text-white sm:text-4xl" data-reveal>Dona con Yape</h2>
          <p class="mt-4 text-lg text-white/80" data-reveal style="--delay: 100ms">
            El 100% de tu aporte va directo a materiales, capacitaciones y logística para los jóvenes de EmpoderArLAS.
          </p>

          <div class="mt-8 rounded-2xl bg-white p-8 shadow-2xl" data-reveal style="--delay: 200ms">
            <p class="text-sm font-medium uppercase tracking-wide text-neutral-500">Número Yape</p>
            <p class="mt-2 font-display text-4xl font-bold tracking-wider text-[#6B2D83] sm:text-5xl">{numeroYape}</p>
            <p class="mt-4 text-neutral-600">A nombre de: <strong>Youngers in Action</strong></p>
            <button id="copy-yape" class="mt-4 inline-flex items-center gap-2 rounded-full bg-[#6B2D83]/10 px-6 py-3 font-medium text-[#6B2D83] transition-all hover:bg-[#6B2D83]/20" data-numero={numeroYape.replace(/\s/g, '')}>
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
              <span id="copy-text">Copiar número</span>
            </button>
          </div>
        </div>

        <div class="flex items-center justify-center" data-reveal="right">
          <div class="rounded-2xl bg-white/10 p-8 text-center backdrop-blur ring-1 ring-white/20">
            <span class="text-6xl">💜</span>
            <p class="mt-4 font-display text-xl font-semibold text-white">Tu aporte impacta a</p>
            <p class="font-display text-5xl font-bold text-[#FFB800]">35+</p>
            <p class="text-white/80">jóvenes</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Donation Types -->
  <section id="tipos-donacion" class="bg-white py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="text-center" data-reveal>
        <span class="text-sm font-medium uppercase tracking-widest text-[#FFB800]">Formas de apoyar</span>
        <h2 class="mt-4 font-display text-3xl font-bold text-neutral-900 sm:text-4xl">¿Qué puedes donar?</h2>
      </div>

      <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
        {tiposDonaciones.map((tipo) => (
          <article class="group rounded-2xl bg-neutral-50 p-8 ring-1 ring-neutral-200 transition-all hover:shadow-lg hover:ring-[#FFB800]/20 hover:-translate-y-1">
            <span class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[#FFB800]/10 text-4xl transition-transform group-hover:scale-110">{tipo.icono}</span>
            <h3 class="mt-6 font-display text-xl font-bold text-neutral-900">{tipo.titulo}</h3>
            <p class="mt-3 text-neutral-600">{tipo.descripcion}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="bg-neutral-900 py-24">
    <div class="mx-auto max-w-6xl px-6 lg:px-8">
      <div class="text-center" data-reveal>
        <span class="text-sm font-medium uppercase tracking-widest text-[#FFB800]">Proceso simple</span>
        <h2 class="mt-4 font-display text-3xl font-bold text-white sm:text-4xl">¿Cómo funciona?</h2>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
        {pasosDonar.map((paso) => (
          <div class="text-center">
            <div class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-[#FFB800] font-display text-2xl font-bold text-neutral-900">{paso.numero}</div>
            <h3 class="mt-6 font-display text-xl font-semibold text-white">{paso.titulo}</h3>
            <p class="mt-3 text-neutral-400">{paso.descripcion}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WhatsApp Contact -->
  <section class="bg-[#FFB800] py-20">
    <div class="mx-auto max-w-4xl px-6 text-center lg:px-8">
      <h2 class="font-display text-3xl font-bold text-neutral-900 sm:text-4xl" data-reveal>¿Listo para donar?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-neutral-800/80" data-reveal style="--delay: 150ms">
        Contáctanos por WhatsApp para coordinar tu donación.
      </p>
      <a
        href={`https://wa.me/51${numeroYape.replace(/\s/g, '')}?text=Hola,%20quiero%20hacer%20una%20donación%20a%20Youngers%20in%20Action`}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center gap-3 rounded-full bg-neutral-900 px-8 py-4 font-bold text-white transition-all hover:bg-neutral-800 hover:scale-105"
        data-reveal
        style="--delay: 300ms"
      >
        <svg class="h-6 w-6 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Escribir por WhatsApp
      </a>
    </div>
  </section>
</MinimalLayout>

<script>
  const copyButton = document.getElementById('copy-yape');
  const copyText = document.getElementById('copy-text');
  copyButton?.addEventListener('click', async () => {
    const numero = copyButton.getAttribute('data-numero');
    if (numero) {
      try {
        await navigator.clipboard.writeText(numero);
        if (copyText) {
          copyText.textContent = '¡Copiado!';
          setTimeout(() => { copyText.textContent = 'Copiar número'; }, 2000);
        }
      } catch (err) { console.error('Error al copiar:', err); }
    }
  });
</script>
