---
import MinimalLayout from '../layouts/MinimalLayout.astro';
import OdsCard from '../components/ui/OdsCard.astro';

const beneficios = [
  { titulo: 'Impacto real', descripcion: 'Tu tiempo transforma vidas. Acompaña a escolares en su proceso de empoderamiento.', icono: '💡' },
  { titulo: 'Desarrollo personal', descripcion: 'Fortalece habilidades de liderazgo, comunicación y trabajo en equipo.', icono: '🚀' },
  { titulo: 'Red de contactos', descripcion: 'Conecta con SENAJU, PNUD, FAO y más de 10 aliados estratégicos.', icono: '🤝' },
  { titulo: 'Certificación', descripcion: 'Recibe constancia de voluntariado avalada por nuestras alianzas institucionales.', icono: '📜' },
  { titulo: 'Eventos exclusivos', descripcion: 'Accede a foros, capacitaciones y espacios de incidencia juvenil.', icono: '🎪' },
  { titulo: 'Comunidad', descripcion: 'Sé parte de una red de jóvenes comprometidos con el cambio social.', icono: '💛' },
];

const tiposVoluntariado = [
  {
    titulo: 'Mentor/a Juvenil', descripcion: 'Acompaña a escolares de 10-12 años en su proceso de empoderamiento.', compromiso: '4-6 horas semanales', icono: '🎯',
    requisitos: ['Mayor de 18 años', 'Compromiso mínimo de 3 meses', 'Pasión por la educación'],
  },
  {
    titulo: 'Facilitador/a de Talleres', descripcion: 'Diseña y ejecuta sesiones formativas en habilidades blandas y liderazgo.', compromiso: '2-4 horas por sesión', icono: '📚',
    requisitos: ['Experiencia en facilitación', 'Habilidades de comunicación', 'Creatividad'],
  },
  {
    titulo: 'Voluntario/a de Eventos', descripcion: 'Apoya en la logística y ejecución de eventos, foros juveniles y actividades de networking.', compromiso: 'Por evento', icono: '🎪',
    requisitos: ['Disponibilidad flexible', 'Trabajo en equipo', 'Proactividad'],
  },
  {
    titulo: 'Embajador/a Digital', descripcion: 'Amplifica nuestro mensaje en redes sociales y ayuda a construir nuestra comunidad digital.', compromiso: '2-3 horas semanales', icono: '📱',
    requisitos: ['Manejo de redes sociales', 'Creatividad', 'Alineación con nuestra misión'],
  },
];
---

<MinimalLayout
  title="Voluntariado"
  description="Únete como voluntario/a a Youngers in Action. Mentorías, eventos y oportunidades de impacto social para jóvenes en Lima, Perú."
  headerVariant="dark"
>
  <!-- Hero -->
  <section class="relative flex min-h-screen items-center justify-center overflow-hidden bg-[#FFB800]">
    <div class="absolute inset-0 opacity-20" aria-hidden="true">
      <div class="absolute inset-0 bg-[url('/images/pattern-dots.svg')] bg-center"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
      <span class="mb-4 inline-block text-sm font-medium uppercase tracking-widest text-neutral-800" data-reveal>¡Por y para las juventudes!</span>
      <h1 class="font-display text-4xl font-bold text-neutral-900 sm:text-5xl md:text-6xl lg:text-7xl" data-reveal>
        Sé parte del cambio
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-neutral-800 sm:text-xl" data-reveal style="--delay: 200ms">
        Únete a nuestra comunidad de voluntarios y acompaña a escolares en su proceso de empoderamiento. Tu tiempo transforma vidas.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row" data-reveal style="--delay: 400ms">
        <a href="#aplicar" class="inline-flex items-center justify-center rounded-full bg-neutral-900 px-8 py-3.5 font-semibold text-white transition-all hover:bg-neutral-800">
          Quiero ser voluntario/a
        </a>
        <a href="#tipos" class="inline-flex items-center justify-center rounded-full border-2 border-neutral-900/30 px-8 py-3.5 font-semibold text-neutral-900 transition-all hover:border-neutral-900">
          Ver oportunidades
        </a>
      </div>
    </div>
  </section>

  <!-- Quote -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-4xl px-6 text-center lg:px-8" data-reveal>
      <blockquote class="font-display text-2xl font-medium text-neutral-900 sm:text-3xl">
        "Seguir involucrándonos y apostar por el talento de las juventudes es parte de nuestro compromiso; más si sabemos que nuestras acciones están sumando al logro de cambios para el futuro de ell@s y de TOD@S."
      </blockquote>
      <p class="mt-6 text-lg text-neutral-500">— Youngers in Action</p>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="bg-neutral-50 py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="text-center" data-reveal>
        <span class="text-sm font-medium uppercase tracking-widest text-[#FFB800]">Beneficios</span>
        <h2 class="mt-4 font-display text-3xl font-bold text-neutral-900 sm:text-4xl">¿Por qué ser voluntario/a?</h2>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
        {beneficios.map((b) => (
          <article class="group rounded-2xl bg-white p-6 shadow-sm ring-1 ring-neutral-200 transition-all hover:shadow-md hover:ring-[#FFB800]/20">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#FFB800]/10 text-2xl transition-transform group-hover:scale-110">
              {b.icono}
            </span>
            <h3 class="mt-4 font-display text-lg font-semibold text-neutral-900">{b.titulo}</h3>
            <p class="mt-2 text-neutral-600">{b.descripcion}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Tipos de voluntariado -->
  <section id="tipos" class="bg-white py-24">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <div class="text-center" data-reveal>
        <span class="text-sm font-medium uppercase tracking-widest text-[#FFB800]">Oportunidades</span>
        <h2 class="mt-4 font-display text-3xl font-bold text-neutral-900 sm:text-4xl">Encuentra tu forma de aportar</h2>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-2" data-reveal-stagger>
        {tiposVoluntariado.map((tipo) => (
          <article class="group rounded-2xl bg-neutral-50 p-8 ring-1 ring-neutral-200 transition-all hover:shadow-lg hover:ring-[#FFB800]/30">
            <div class="flex items-start justify-between">
              <span class="flex h-14 w-14 items-center justify-center rounded-xl bg-[#FFB800]/10 text-3xl">{tipo.icono}</span>
              <span class="rounded-full bg-neutral-200 px-3 py-1 text-xs font-medium text-neutral-600">{tipo.compromiso}</span>
            </div>
            <h3 class="mt-6 font-display text-xl font-semibold text-neutral-900">{tipo.titulo}</h3>
            <p class="mt-3 text-neutral-600">{tipo.descripcion}</p>
            <div class="mt-6">
              <p class="text-sm font-medium text-neutral-500">Requisitos:</p>
              <ul class="mt-2 space-y-1">
                {tipo.requisitos.map((req) => (
                  <li class="flex items-center gap-2 text-sm text-neutral-600">
                    <svg class="h-4 w-4 text-[#FFB800]" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    {req}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Application Form -->
  <section id="aplicar" class="bg-neutral-50 py-24">
    <div class="mx-auto max-w-2xl px-6 lg:px-8" data-reveal>
      <div class="text-center">
        <span class="text-sm font-medium uppercase tracking-widest text-[#FFB800]">¡Únete!</span>
        <h2 class="mt-4 font-display text-3xl font-bold text-neutral-900 sm:text-4xl">Aplica como voluntario/a</h2>
        <p class="mt-4 text-lg text-neutral-600">Completa el formulario y nos pondremos en contacto contigo.</p>
      </div>

      <form id="volunteer-form" class="mt-10 space-y-6 rounded-2xl bg-white p-8 shadow-sm ring-1 ring-neutral-200" action="https://formspree.io/f/placeholder" method="POST">
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="vol-nombre" class="mb-2 block text-sm font-medium text-neutral-700">Nombre completo *</label>
            <input type="text" id="vol-nombre" name="nombre" required autocomplete="name" placeholder="Tu nombre" class="w-full rounded-lg border border-neutral-300 px-4 py-3 text-sm transition-all focus:border-[#FFB800] focus:outline-none focus:ring-2 focus:ring-[#FFB800]/20" />
          </div>
          <div>
            <label for="vol-email" class="mb-2 block text-sm font-medium text-neutral-700">Correo electrónico *</label>
            <input type="email" id="vol-email" name="email" required autocomplete="email" placeholder="tu@email.com" class="w-full rounded-lg border border-neutral-300 px-4 py-3 text-sm transition-all focus:border-[#FFB800] focus:outline-none focus:ring-2 focus:ring-[#FFB800]/20" />
          </div>
        </div>
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="vol-edad" class="mb-2 block text-sm font-medium text-neutral-700">Edad *</label>
            <input type="number" id="vol-edad" name="edad" required min="18" max="99" placeholder="Ej: 22" class="w-full rounded-lg border border-neutral-300 px-4 py-3 text-sm transition-all focus:border-[#FFB800] focus:outline-none focus:ring-2 focus:ring-[#FFB800]/20" />
          </div>
          <div>
            <label for="vol-tipo" class="mb-2 block text-sm font-medium text-neutral-700">Tipo de voluntariado *</label>
            <select id="vol-tipo" name="tipo_voluntariado" required class="w-full rounded-lg border border-neutral-300 px-4 py-3 text-sm transition-all focus:border-[#FFB800] focus:outline-none focus:ring-2 focus:ring-[#FFB800]/20">
              <option value="">Selecciona una opción</option>
              <option value="mentor">Mentor/a Juvenil</option>
              <option value="facilitador">Facilitador/a de Talleres</option>
              <option value="eventos">Voluntario/a de Eventos</option>
              <option value="embajador">Embajador/a Digital</option>
              <option value="otro">Otro</option>
            </select>
          </div>
        </div>
        <div>
          <label for="vol-motivacion" class="mb-2 block text-sm font-medium text-neutral-700">¿Por qué quieres ser voluntario/a? *</label>
          <textarea id="vol-motivacion" name="motivacion" required rows="4" placeholder="Cuéntanos qué te motiva y qué esperas aportar..." class="w-full resize-none rounded-lg border border-neutral-300 px-4 py-3 text-sm transition-all focus:border-[#FFB800] focus:outline-none focus:ring-2 focus:ring-[#FFB800]/20"></textarea>
        </div>
        <div>
          <label for="vol-disponibilidad" class="mb-2 block text-sm font-medium text-neutral-700">Disponibilidad horaria</label>
          <input type="text" id="vol-disponibilidad" name="disponibilidad" placeholder="Ej: Fines de semana, tardes entre semana" class="w-full rounded-lg border border-neutral-300 px-4 py-3 text-sm transition-all focus:border-[#FFB800] focus:outline-none focus:ring-2 focus:ring-[#FFB800]/20" />
        </div>
        <div class="flex items-start gap-3">
          <input type="checkbox" id="vol-terminos" name="terminos" required class="mt-1 h-4 w-4 rounded border-neutral-300 text-[#FFB800] focus:ring-[#FFB800]" />
          <label for="vol-terminos" class="text-sm text-neutral-600">
            Confirmo que tengo 18 años o más y acepto la <a href="/privacidad" class="text-[#FFB800] underline hover:text-neutral-900">política de privacidad</a>.
          </label>
        </div>
        <button type="submit" class="w-full rounded-full bg-[#FFB800] px-8 py-3.5 font-semibold text-neutral-900 transition-all hover:bg-[#E5A600] hover:shadow-lg">
          Enviar solicitud
        </button>
      </form>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-neutral-900 py-20">
    <div class="mx-auto max-w-4xl px-6 text-center lg:px-8">
      <h2 class="font-display text-3xl font-bold text-white sm:text-4xl" data-reveal>
        Las juventudes no son el futuro, son el presente
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-neutral-400" data-reveal style="--delay: 150ms">
        Cada acción suma. Cada mentor transforma. Cada voluntario hace la diferencia.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row" data-reveal style="--delay: 300ms">
        <a href="/contacto" class="inline-flex items-center justify-center rounded-full bg-[#FFB800] px-8 py-3.5 font-semibold text-neutral-900 transition-all hover:bg-[#E5A600]">
          Contáctanos
        </a>
        <a href="/proyectos/empoderarlas" class="inline-flex items-center justify-center rounded-full border-2 border-white/30 px-8 py-3.5 font-semibold text-white transition-all hover:border-white hover:bg-white/10">
          Conoce EmpoderArLAS
        </a>
      </div>
    </div>
  </section>
</MinimalLayout>

<script>
  const form = document.getElementById('volunteer-form') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = button.textContent;
    button.textContent = 'Enviando...';
    button.disabled = true;
    await new Promise((resolve) => setTimeout(resolve, 1500));
    button.textContent = '¡Solicitud enviada!';
    button.classList.remove('bg-[#FFB800]');
    button.classList.add('bg-green-500', 'text-white');
    setTimeout(() => {
      form.reset();
      button.textContent = originalText;
      button.disabled = false;
      button.classList.remove('bg-green-500', 'text-white');
      button.classList.add('bg-[#FFB800]');
    }, 3000);
  });
</script>
