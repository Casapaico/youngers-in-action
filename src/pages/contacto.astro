---
import MinimalLayout from '../layouts/MinimalLayout.astro';

const contactInfo = [
  { icon: 'mail', label: 'Correo electrónico', value: 'youngers.global@gmail.com', href: 'mailto:youngers.global@gmail.com' },
  { icon: 'location', label: 'Ubicación', value: 'Lima, Perú', href: null },
  { icon: 'instagram', label: 'Instagram', value: '@youngersinaction', href: 'https://instagram.com/youngersinaction' },
  { icon: 'linkedin', label: 'LinkedIn', value: 'Youngers in Action', href: 'https://linkedin.com/company/youngers-in-action' },
];

const faqs = [
  { question: '¿Cómo puedo ser voluntario?', answer: 'Puedes unirte como mentor juvenil en nuestros programas. Completa el formulario de contacto indicando tu interés y te enviaremos información sobre las próximas convocatorias.' },
  { question: '¿En qué zonas trabajan?', answer: 'Actualmente operamos en Lima, Perú, trabajando con instituciones educativas y comunidades locales. Tenemos planes de expansión a otras regiones.' },
  { question: '¿Puedo proponer una alianza institucional?', answer: 'Sí, estamos abiertos a alianzas con instituciones educativas, empresas y organizaciones alineadas con los ODS. Contáctanos con tu propuesta.' },
  { question: '¿Cómo puedo apoyar económicamente?', answer: 'Puedes realizar donaciones que van directamente a nuestros programas. El 90% se destina a materiales, capacitaciones y logística de EmpoderArLAS.' },
];
---

<MinimalLayout
  title="Contacto"
  description="Contáctanos para ser voluntario, proponer alianzas o conocer más sobre nuestros programas de empoderamiento juvenil en Lima, Perú."
  headerVariant="yellow"
>
  <!-- Split-screen: Form + Info -->
  <section class="min-h-screen">
    <div class="split-section min-h-screen">
      <!-- Form side (60% on lg) -->
      <div class="flex flex-col justify-center bg-white px-8 py-24 md:px-16 lg:px-20">
        <span class="mb-2 text-sm font-medium uppercase tracking-widest text-[#FFB800]" data-reveal>Conecta con nosotros</span>
        <h1 class="font-display text-3xl font-bold text-neutral-900 sm:text-4xl md:text-5xl" data-reveal>
          Envíanos un mensaje
        </h1>
        <p class="mt-4 text-neutral-600" data-reveal style="--delay: 150ms">
          Completa el formulario y te responderemos en menos de 48 horas.
        </p>

        <form id="contact-form" class="mt-10 space-y-6" action="https://formspree.io/f/placeholder" method="POST">
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="nombre" class="mb-2 block text-sm font-medium text-neutral-700">Nombre completo *</label>
              <input type="text" id="nombre" name="nombre" required autocomplete="name" placeholder="Tu nombre" class="w-full rounded-lg border border-neutral-300 px-4 py-3 text-sm transition-all focus:border-[#FFB800] focus:outline-none focus:ring-2 focus:ring-[#FFB800]/20" />
            </div>
            <div>
              <label for="email" class="mb-2 block text-sm font-medium text-neutral-700">Correo electrónico *</label>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="tu@email.com" class="w-full rounded-lg border border-neutral-300 px-4 py-3 text-sm transition-all focus:border-[#FFB800] focus:outline-none focus:ring-2 focus:ring-[#FFB800]/20" />
            </div>
          </div>

          <div>
            <label for="asunto" class="mb-2 block text-sm font-medium text-neutral-700">Asunto *</label>
            <select id="asunto" name="asunto" required class="w-full rounded-lg border border-neutral-300 px-4 py-3 text-sm transition-all focus:border-[#FFB800] focus:outline-none focus:ring-2 focus:ring-[#FFB800]/20">
              <option value="">Selecciona una opción</option>
              <option value="voluntariado">Quiero ser voluntario/mentor</option>
              <option value="alianza">Propuesta de alianza institucional</option>
              <option value="donacion">Información sobre donaciones</option>
              <option value="programa">Información sobre EmpoderArLAS</option>
              <option value="prensa">Prensa y medios</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <div>
            <label for="mensaje" class="mb-2 block text-sm font-medium text-neutral-700">Mensaje *</label>
            <textarea id="mensaje" name="mensaje" required rows="5" placeholder="Cuéntanos cómo podemos ayudarte o cómo te gustaría colaborar..." class="w-full resize-none rounded-lg border border-neutral-300 px-4 py-3 text-sm transition-all focus:border-[#FFB800] focus:outline-none focus:ring-2 focus:ring-[#FFB800]/20"></textarea>
          </div>

          <div class="flex items-start gap-3">
            <input type="checkbox" id="privacidad" name="privacidad" required class="mt-1 h-4 w-4 rounded border-neutral-300 text-[#FFB800] focus:ring-[#FFB800]" />
            <label for="privacidad" class="text-sm text-neutral-600">
              Acepto la <a href="/privacidad" class="text-[#FFB800] underline hover:text-neutral-900">política de privacidad</a> y el tratamiento de mis datos.
            </label>
          </div>

          <button type="submit" class="w-full sm:w-auto rounded-full bg-[#FFB800] px-8 py-3.5 font-semibold text-neutral-900 transition-all hover:bg-[#E5A600] hover:shadow-lg">
            Enviar mensaje
          </button>
        </form>
      </div>

      <!-- Info side -->
      <div class="relative overflow-hidden min-h-[280px] md:min-h-0">
        <img
          src="/images/daisy_y_compania.png"
          alt="Equipo Youngers in Action"
          class="absolute inset-0 w-full h-full object-cover object-center"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="bg-neutral-50 py-24">
    <div class="mx-auto max-w-3xl px-6 lg:px-8">
      <div class="text-center" data-reveal>
        <span class="text-sm font-medium uppercase tracking-widest text-[#FFB800]">FAQ</span>
        <h2 class="mt-4 font-display text-3xl font-bold text-neutral-900 sm:text-4xl">Preguntas frecuentes</h2>
      </div>

      <dl class="mt-12 space-y-4" data-reveal-stagger>
        {faqs.map((faq) => (
          <div class="faq-item rounded-xl bg-white p-6 shadow-sm ring-1 ring-neutral-200 transition-all hover:shadow-md">
            <dt>
              <button type="button" class="faq-trigger flex w-full items-center justify-between text-left" aria-expanded="false">
                <span class="font-display text-lg font-semibold text-neutral-900">{faq.question}</span>
                <svg class="h-5 w-5 shrink-0 text-neutral-400 faq-icon transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
            </dt>
            <dd class="faq-content mt-0 max-h-0 overflow-hidden transition-all duration-300">
              <p class="pt-4 text-neutral-600">{faq.answer}</p>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</MinimalLayout>

<script>
  // FAQ Accordion
  document.querySelectorAll('.faq-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item');
      const content = item?.querySelector('.faq-content') as HTMLElement;
      const icon = item?.querySelector('.faq-icon');
      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

      document.querySelectorAll('.faq-item').forEach((otherItem) => {
        if (otherItem !== item) {
          const otherTrigger = otherItem.querySelector('.faq-trigger');
          const otherContent = otherItem.querySelector('.faq-content') as HTMLElement;
          const otherIcon = otherItem.querySelector('.faq-icon');
          otherTrigger?.setAttribute('aria-expanded', 'false');
          if (otherContent) otherContent.style.maxHeight = '0';
          otherIcon?.classList.remove('rotate-180');
        }
      });

      trigger.setAttribute('aria-expanded', (!isExpanded).toString());
      if (content) content.style.maxHeight = isExpanded ? '0' : `${content.scrollHeight + 16}px`;
      icon?.classList.toggle('rotate-180', !isExpanded);
    });
  });

  // Form submission → WhatsApp
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const nombre      = (form.querySelector('#nombre')  as HTMLInputElement).value.trim();
    const email       = (form.querySelector('#email')   as HTMLInputElement).value.trim();
    const asuntoEl    = form.querySelector('#asunto')   as HTMLSelectElement;
    const asunto      = asuntoEl.options[asuntoEl.selectedIndex].text;
    const mensaje     = (form.querySelector('#mensaje') as HTMLTextAreaElement).value.trim();

    const texto =
      `*Nuevo mensaje de contacto — Youngers in Action*\n\n` +
      `👤 *Nombre:* ${nombre}\n` +
      `📧 *Email:* ${email}\n` +
      `📌 *Asunto:* ${asunto}\n` +
      `💬 *Mensaje:*\n${mensaje}`;

    window.open(`https://wa.me/51989942045?text=${encodeURIComponent(texto)}`, '_blank');

    // Feedback visual
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const original = button.textContent;
    button.textContent = '¡Redirigiendo a WhatsApp!';
    button.disabled = true;
    setTimeout(() => {
      form.reset();
      button.textContent = original;
      button.disabled = false;
    }, 3000);
  });
</script>
