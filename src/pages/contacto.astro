---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/ui/Section.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Input from '../components/ui/Input.astro';
import Card from '../components/ui/Card.astro';

const contactInfo = [
  {
    icon: 'mail',
    label: 'Correo electrónico',
    value: 'youngers.global@gmail.com',
    href: 'mailto:youngers.global@gmail.com',
  },
  {
    icon: 'location',
    label: 'Ubicación',
    value: 'Lima, Perú',
    href: null,
  },
  {
    icon: 'instagram',
    label: 'Instagram',
    value: '@youngersinaction',
    href: 'https://instagram.com/youngersinaction',
  },
  {
    icon: 'linkedin',
    label: 'LinkedIn',
    value: 'Youngers in Action',
    href: 'https://linkedin.com/company/youngers-in-action',
  },
];

const faqs = [
  {
    question: '¿Cómo puedo ser voluntario?',
    answer: 'Puedes unirte como mentor juvenil en nuestros programas. Completa el formulario de contacto indicando tu interés y te enviaremos información sobre las próximas convocatorias.',
  },
  {
    question: '¿En qué zonas trabajan?',
    answer: 'Actualmente operamos en Lima, Perú, trabajando con instituciones educativas y comunidades locales. Tenemos planes de expansión a otras regiones.',
  },
  {
    question: '¿Puedo proponer una alianza institucional?',
    answer: 'Sí, estamos abiertos a alianzas con instituciones educativas, empresas y organizaciones alineadas con los ODS. Contáctanos con tu propuesta.',
  },
  {
    question: '¿Cómo puedo apoyar económicamente?',
    answer: 'Puedes realizar donaciones que van directamente a nuestros programas. El 90% se destina a materiales, capacitaciones y logística de EmpoderArLAS.',
  },
];
---

<PageLayout
  title="Contacto - Youngers in Action"
  description="Contáctanos para ser voluntario, proponer alianzas o conocer más sobre nuestros programas de empoderamiento juvenil en Lima, Perú."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-secondary-900 via-secondary-800 to-neutral-900 py-20 md:py-28">
    <div class="absolute inset-0 opacity-10" aria-hidden="true">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-primary-400/20 to-transparent"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center" data-reveal>
        <Badge variant="primary" size="lg" rounded>
          Conecta con nosotros
        </Badge>

        <h1 class="mt-6 font-display text-4xl font-bold tracking-tight text-white sm:text-5xl">
          ¿Listo para ser parte del cambio?
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-lg text-secondary-100 sm:text-xl">
          Ya seas voluntario, aliado potencial o simplemente quieras conocernos, estamos aquí para escucharte.
        </p>
      </div>
    </div>
  </section>

  <!-- Formulario + Info de contacto -->
  <Section background="white" spacing="xl">
    <div class="grid gap-12 lg:grid-cols-5 lg:gap-16">
      <!-- Formulario -->
      <div class="lg:col-span-3" data-reveal>
        <h2 class="font-display text-2xl font-bold text-neutral-900 sm:text-3xl">
          Envíanos un mensaje
        </h2>
        <p class="mt-2 text-neutral-600">
          Completa el formulario y te responderemos en menos de 48 horas.
        </p>

        <form
          id="contact-form"
          class="mt-8 space-y-6"
          action="https://formspree.io/f/placeholder"
          method="POST"
        >
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="nombre" class="mb-2 block text-sm font-medium text-neutral-700">
                Nombre completo *
              </label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                required
                autocomplete="name"
                placeholder="Tu nombre"
                class="w-full rounded-lg border border-neutral-300 px-4 py-3 text-sm transition-all focus:border-primary-400 focus:outline-none focus:ring-2 focus:ring-primary-400/20"
              />
            </div>

            <div>
              <label for="email" class="mb-2 block text-sm font-medium text-neutral-700">
                Correo electrónico *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder="tu@email.com"
                class="w-full rounded-lg border border-neutral-300 px-4 py-3 text-sm transition-all focus:border-primary-400 focus:outline-none focus:ring-2 focus:ring-primary-400/20"
              />
            </div>
          </div>

          <div>
            <label for="asunto" class="mb-2 block text-sm font-medium text-neutral-700">
              Asunto *
            </label>
            <select
              id="asunto"
              name="asunto"
              required
              class="w-full rounded-lg border border-neutral-300 px-4 py-3 text-sm transition-all focus:border-primary-400 focus:outline-none focus:ring-2 focus:ring-primary-400/20"
            >
              <option value="">Selecciona una opción</option>
              <option value="voluntariado">Quiero ser voluntario/mentor</option>
              <option value="alianza">Propuesta de alianza institucional</option>
              <option value="donacion">Información sobre donaciones</option>
              <option value="programa">Información sobre EmpoderArLAS</option>
              <option value="prensa">Prensa y medios</option>
              <option value="otro">Otro</option>
            </select>
          </div>

          <div>
            <label for="mensaje" class="mb-2 block text-sm font-medium text-neutral-700">
              Mensaje *
            </label>
            <textarea
              id="mensaje"
              name="mensaje"
              required
              rows="5"
              placeholder="Cuéntanos cómo podemos ayudarte o cómo te gustaría colaborar..."
              class="w-full resize-none rounded-lg border border-neutral-300 px-4 py-3 text-sm transition-all focus:border-primary-400 focus:outline-none focus:ring-2 focus:ring-primary-400/20"
            ></textarea>
          </div>

          <div class="flex items-start gap-3">
            <input
              type="checkbox"
              id="privacidad"
              name="privacidad"
              required
              class="mt-1 h-4 w-4 rounded border-neutral-300 text-primary-500 focus:ring-primary-400"
            />
            <label for="privacidad" class="text-sm text-neutral-600">
              Acepto la <a href="/privacidad" class="text-primary-600 underline hover:text-primary-700">política de privacidad</a> y el tratamiento de mis datos para recibir respuesta.
            </label>
          </div>

          <Button type="submit" variant="primary" size="lg" class="w-full sm:w-auto">
            Enviar mensaje
          </Button>
        </form>
      </div>

      <!-- Info de contacto -->
      <aside class="lg:col-span-2" data-reveal>
        <h2 class="font-display text-2xl font-bold text-neutral-900 sm:text-3xl">
          Información de contacto
        </h2>
        <p class="mt-2 text-neutral-600">
          También puedes contactarnos directamente por estos medios.
        </p>

        <ul class="mt-8 space-y-6" role="list">
          {contactInfo.map((item) => (
            <li class="flex items-start gap-4">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-primary-100 text-primary-600">
                {item.icon === 'mail' && (
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                )}
                {item.icon === 'location' && (
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                )}
                {item.icon === 'instagram' && (
                  <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                )}
                {item.icon === 'linkedin' && (
                  <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                )}
              </span>

              <div>
                <p class="text-sm font-medium text-neutral-500">{item.label}</p>
                {item.href ? (
                  <a
                    href={item.href}
                    target={item.href.startsWith('http') ? '_blank' : undefined}
                    rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    class="text-lg font-semibold text-neutral-900 transition-colors hover:text-primary-600"
                  >
                    {item.value}
                  </a>
                ) : (
                  <p class="text-lg font-semibold text-neutral-900">{item.value}</p>
                )}
              </div>
            </li>
          ))}
        </ul>

        <!-- CTA Redes -->
        <div class="mt-10 rounded-2xl bg-gradient-to-br from-primary-400 to-primary-500 p-6">
          <h3 class="font-display text-lg font-semibold text-neutral-900">
            Síguenos en redes
          </h3>
          <p class="mt-2 text-sm text-neutral-800">
            Únete a nuestra comunidad de +249 seguidores y entérate de nuestras actividades.
          </p>
          <div class="mt-4 flex gap-3">
            <a
              href="https://instagram.com/youngersinaction"
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-neutral-900 transition-transform hover:scale-110"
              aria-label="Síguenos en Instagram"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
            <a
              href="https://linkedin.com/company/youngers-in-action"
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-neutral-900 transition-transform hover:scale-110"
              aria-label="Síguenos en LinkedIn"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          </div>
        </div>
      </aside>
    </div>
  </Section>

  <!-- FAQs -->
  <Section background="gray" spacing="xl">
    <div class="text-center" data-reveal>
      <Badge variant="secondary" size="sm">FAQ</Badge>
      <h2 class="mt-4 font-display text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
        Preguntas frecuentes
      </h2>
    </div>

    <dl class="mx-auto mt-12 max-w-3xl space-y-4" data-reveal-stagger>
      {faqs.map((faq) => (
        <div class="faq-item rounded-xl bg-white p-6 shadow-sm ring-1 ring-neutral-200 transition-all hover:shadow-md">
          <dt>
            <button
              type="button"
              class="faq-trigger flex w-full items-center justify-between text-left"
              aria-expanded="false"
            >
              <span class="font-display text-lg font-semibold text-neutral-900">
                {faq.question}
              </span>
              <span class="ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-100 text-primary-600 transition-transform">
                <svg class="h-5 w-5 faq-icon transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </button>
          </dt>
          <dd class="faq-content mt-0 max-h-0 overflow-hidden transition-all duration-300">
            <p class="pt-4 text-neutral-600">
              {faq.answer}
            </p>
          </dd>
        </div>
      ))}
    </dl>
  </Section>

  <!-- CTA Final -->
  <Section background="white" spacing="lg">
    <div class="rounded-2xl bg-gradient-to-r from-secondary-600 via-secondary-700 to-secondary-800 px-8 py-12 text-center md:px-16 md:py-16" data-reveal>
      <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">
        Las juventudes no son el futuro, son el presente
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-secondary-100">
        Únete a Youngers in Action y sé parte de una comunidad que está transformando realidades hoy.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
        <Button href="/voluntariado" variant="primary" size="lg">
          Quiero ser voluntario
        </Button>
        <Button href="/proyectos/empoderarlas" variant="outline" size="lg" class="border-white text-white hover:bg-white/10">
          Conoce EmpoderArLAS
        </Button>
      </div>
    </div>
  </Section>
</PageLayout>

<script>
  // FAQ Accordion
  document.querySelectorAll('.faq-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item');
      const content = item?.querySelector('.faq-content') as HTMLElement;
      const icon = item?.querySelector('.faq-icon');
      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

      // Close all others
      document.querySelectorAll('.faq-item').forEach((otherItem) => {
        if (otherItem !== item) {
          const otherTrigger = otherItem.querySelector('.faq-trigger');
          const otherContent = otherItem.querySelector('.faq-content') as HTMLElement;
          const otherIcon = otherItem.querySelector('.faq-icon');
          otherTrigger?.setAttribute('aria-expanded', 'false');
          if (otherContent) otherContent.style.maxHeight = '0';
          otherIcon?.classList.remove('rotate-180');
        }
      });

      // Toggle current
      trigger.setAttribute('aria-expanded', (!isExpanded).toString());
      if (content) {
        content.style.maxHeight = isExpanded ? '0' : `${content.scrollHeight + 16}px`;
      }
      icon?.classList.toggle('rotate-180', !isExpanded);
    });
  });

  // Form submission feedback
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = button.textContent;

    button.textContent = 'Enviando...';
    button.disabled = true;

    // Simular envío (reemplazar con Formspree real)
    await new Promise((resolve) => setTimeout(resolve, 1500));

    button.textContent = '¡Mensaje enviado!';
    button.classList.remove('bg-primary-400');
    button.classList.add('bg-accent-500');

    setTimeout(() => {
      form.reset();
      button.textContent = originalText;
      button.disabled = false;
      button.classList.remove('bg-accent-500');
      button.classList.add('bg-primary-400');
    }, 3000);
  });
</script>
