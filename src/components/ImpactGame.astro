  // ════════════════════════════════════════════════════════════
  // AUDIO ENGINE — Web Audio API, muy sutil
  // ════════════════════════════════════════════════════════════
  let _audioCtx: AudioContext | null = null;
  let _muted = false; // default: sonido ON

  function _getCtx(): AudioContext | null {
    if (_muted) return null;
    if (typeof AudioContext === 'undefined') return null;
    if (!_audioCtx) {
      try { _audioCtx = new AudioContext(); } catch { return null; }
    }
    if (_audioCtx.state === 'suspended') _audioCtx.resume().catch(() => {});
    return _audioCtx;
  }

  function _tone(freq: number, type: OscillatorType, dur: number, gain: number, delay = 0): void {
    const ctx = _getCtx();
    if (!ctx) return;
    try {
      const osc = ctx.createOscillator();
      const g   = ctx.createGain();
      osc.connect(g);
      g.connect(ctx.destination);
      osc.type = type;
      osc.frequency.setValueAtTime(freq, ctx.currentTime + delay);
      g.gain.setValueAtTime(0, ctx.currentTime + delay);
      g.gain.linearRampToValueAtTime(gain, ctx.currentTime + delay + 0.012);
      g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + delay + dur);
      osc.start(ctx.currentTime + delay);
      osc.stop(ctx.currentTime + delay + dur + 0.05);
    } catch { /* silent fail */ }
  }

  // Sonido: aparece una línea de texto
  function sndTick(): void {
    _tone(1100, 'sine', 0.07, 0.032);
  }
  // Sonido: botón de navegación
  function sndClick(): void {
    _tone(480, 'sine', 0.09, 0.065);
    _tone(600, 'sine', 0.09, 0.038, 0.045);
  }
  // Sonido: opción elegida — trío ascendente C-E-G
  function sndChoose(): void {
    _tone(523, 'sine', 0.14, 0.075);
    _tone(659, 'sine', 0.16, 0.055, 0.07);
    _tone(784, 'sine', 0.20, 0.042, 0.14);
  }
  // Sonido: número flotante
  function sndFloat(): void {
    _tone(1047, 'sine', 0.14, 0.05);
  }
  // Sonido: mundo evoluciona — sweep cálido
  function sndWorldUp(): void {
    _tone(220, 'sine', 0.5, 0.04);
    _tone(330, 'sine', 0.5, 0.035, 0.13);
    _tone(440, 'sine', 0.5, 0.03,  0.26);
  }
  // Sonido: duda existencial — nota oscura
  function sndDark(): void {
    _tone(130, 'sine', 0.45, 0.038);
    _tone(195, 'sine', 0.4,  0.022, 0.18);
  }
  // Sonido: revelación de identidad — arpegio mayor
  function sndReveal(): void {
    [523, 659, 784, 1047].forEach((f, i) => _tone(f, 'sine', 0.3, 0.07, i * 0.16));
  }
  // Sonido: celebración CTA
  function sndCelebrate(): void {
    [523, 784, 1047, 1319].forEach((f, i) => _tone(f, 'sine', 0.26, 0.085, i * 0.1));
  }

  // ════════════════════════════════════════════════════════════
  // MICRO UTILS
  // ════════════════════════════════════════════════════════════
  function rAF2(fn: () => void): void {
    requestAnimationFrame(() => requestAnimationFrame(fn));
  }

  function animateCounter(el: HTMLElement, from: number, to: number, ms: number): void {
    const start = performance.now();
    const run = (now: number) => {
      const p = Math.min((now - start) / ms, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = String(Math.round(from + (to - from) * eased));
      if (p < 1) requestAnimationFrame(run);
      else el.textContent = String(to);
    };
    requestAnimationFrame(run);
  }

  function getTopCategory(): string {
    return Object.entries(state.scores).reduce((a, b) => (b[1] > a[1] ? b : a))[0];
  }

  function setWorldState(n: number): void {
    const svg = document.getElementById('world-svg');
    if (!svg) return;
    svg.classList.remove('ws-0', 'ws-1', 'ws-2', 'ws-3');
    svg.classList.add(`ws-${n}`);
    state.worldState = n;

    // Glow destello al cambiar a estado activo
    if (n > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const wf = document.querySelector<HTMLElement>('.world-float');
      if (wf) {
        wf.classList.remove('world-float--glow');
        void wf.offsetWidth; // forzar reflow para reiniciar animación
        wf.classList.add('world-float--glow');
        setTimeout(() => wf.classList.remove('world-float--glow'), 700);
      }
    }
  }

  function setAvatarState(n: number): void {
    const av = document.getElementById('avatar-svg') as SVGSVGElement | null;
    if (!av) return;
    av.classList.remove('av-0', 'av-1', 'av-2', 'av-3');
    av.classList.add(`av-${n}`);
    // Etiqueta dinámica
    const lbl = document.getElementById('avatar-label');
    if (lbl) {
      const labels = ['Tú', 'Tú', 'Tú ✨', '¡Líder! 🌟'];
