  // ════════════════════════════════════════════════════════════
  // S6 — REVELACIÓN DE IDENTIDAD
  // ════════════════════════════════════════════════════════════
  function runRevealSequence(): void {
    const stage      = document.getElementById('reveal-stage');
    const badgeGroup = document.getElementById('result-badge-group');
    const bgEl       = document.getElementById('result-bg');
    if (!stage) return;

    const cat = getTopCategory();
    const p   = PROFILES[cat];

    const lines: Array<{ text: string; cls: string; at: number }> = [
      { text: 'No eres un visitante.',  cls: 'reveal-line--pre',      at: 0    },
      { text: 'Eres',                   cls: 'reveal-line--bridge',    at: 1100 },
      { text: p.title,                  cls: 'reveal-line--identity',  at: 1800 },
    ];

    lines.forEach(({ text, cls, at }) => {
      setTimeout(() => {
        const el = document.createElement('p');
        el.className = `reveal-line ${cls}`;
        el.textContent = text;
        stage.appendChild(el);
        rAF2(() => el.classList.add('show'));
      }, at);
    });

    // ── FLOOD DINÁMICO ───────────────────────────────────────
    // Paso 1: "Eres" → flood sutil (1100ms)
    setTimeout(() => {
      if (bgEl) bgEl.style.background =
        `radial-gradient(ellipse at 50% 20%, ${p.color}28 0%, #0f0f16 64%)`;
    }, 1100);

    // Paso 2: nombre del perfil → flood máximo (1800ms) + haptic crescendo
    setTimeout(() => {
      haptic([12, 40, 22, 40, 55]);
      if (bgEl) {
        bgEl.style.background =
          `radial-gradient(ellipse at 50% 38%, ${p.color}62 0%, ${p.color}20 48%, #0f0f16 78%)`;
        bgEl.classList.add('bg--aura');
      }
    }, 1800);

    // Paso 3: badge visible → flood se asienta (3100ms)
    setTimeout(() => {
      if (bgEl) bgEl.style.background =
        `radial-gradient(ellipse at 50% -8%, ${p.color}40 0%, #0f0f16 56%)`;
    }, 3100);
    // ─────────────────────────────────────────────────────────

    // Sonido + badge al revelar identidad
    setTimeout(sndReveal, 1800);
    setTimeout(() => {
      if (badgeGroup) badgeGroup.classList.add('show');
      animateImpactBar();
    }, 2900);

    // Desglose por área aparece tras el badge
    setTimeout(() => {
      const breakdownEl = document.getElementById('area-breakdown');
      if (!breakdownEl) return;
      breakdownEl.classList.add('show');
      requestAnimationFrame(() => {
        // Animar barras
        breakdownEl.querySelectorAll<HTMLElement>('.area-row-fill').forEach(el => {
          el.style.width = `${el.dataset.pct ?? 0}%`;
        });
        // Animar valores numéricos (de 0 al target)
        breakdownEl.querySelectorAll<HTMLElement>('.area-row-val').forEach(el => {
          const target = parseInt(el.dataset.target ?? '0', 10);
          animateNum(el, 0, target, 1000);
        });
      });
    }, 3500);
  }

  // ════════════════════════════════════════════════════════════
  // FLOATING NUMBERS — nacen en el botón y suben
  // ════════════════════════════════════════════════════════════
  interface FloatChip { label: string; color: string; }

  function spawnFloats(chips: FloatChip[], anchorEl: HTMLElement): void {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const rect = anchorEl.getBoundingClientRect();
    const centerX = rect.left + rect.width / 2;
    const topY    = rect.top + 8;

    chips.forEach((chip, i) => {
      setTimeout(() => {
        const el = document.createElement('div');
        el.className = 'float-num';
        el.textContent = chip.label;
        el.style.color = chip.color;
        const spread = (i - (chips.length - 1) / 2) * 82;
        el.style.left = `${centerX + spread}px`;
        el.style.top  = `${topY}px`;
        document.body.appendChild(el);
        el.addEventListener('animationend', () => el.remove());
        sndFloat();
      }, i * 110);
    });
  }

  // ════════════════════════════════════════════════════════════
  // WORLD FLASH — muestra el mundo evolucionando entre pantallas
  // ════════════════════════════════════════════════════════════
  const WF_MSGS: Record<number, string> = {
    2: 'Lima está cambiando.',
    3: 'Tu decisión ya tiene efecto.',
  };

  function showWorldFlash(worldState: number, chips: FloatChip[], onDone: () => void): void {
    const flash   = document.getElementById('world-flash');
    const wfSvg   = document.getElementById('wf-svg');
    const wfChips = document.getElementById('wf-chips');
    const wfMsg   = document.getElementById('wf-msg');
    const wfGlow  = document.getElementById('wf-glow');

    if (!flash || !wfSvg) { onDone(); return; }

    // Actualizar clase de estado del SVG del flash
    wfSvg.classList.remove('wfs-0', 'wfs-1', 'wfs-2', 'wfs-3'); // reset
    void wfSvg.offsetWidth;     // forzar reflow para que la transición se active
    wfSvg.classList.add(`wfs-${worldState}`);

    // Chips
    if (wfChips) {
      wfChips.innerHTML = chips.map((c, i) =>
        `<span class="wf-chip"
          style="animation-delay:${220 + i * 110}ms;color:rgba(255,255,255,0.95);border:1.5px solid ${c.color}88;background:${c.color}30">
          ${c.label}
        </span>`
      ).join('') || `<span class="wf-chip" style="color:rgba(255,255,255,0.72);border:1.5px solid rgba(255,255,255,0.18);background:rgba(255,255,255,0.07)">Sin puntos extra</span>`;
    }

    // Mensaje
    if (wfMsg) {
      wfMsg.textContent = WF_MSGS[worldState] ?? '';
      wfMsg.classList.remove('show');
    }

    // Glow usa el color del chip más importante
    if (wfGlow) {
      wfGlow.style.background = chips[0]?.color ?? '#ffb800';
    }

    // Mostrar overlay + sonido de mundo
    sndWorldUp();
    flash.removeAttribute('aria-hidden');
    flash.classList.add('show');

    // Activar mensaje con delay
    setTimeout(() => wfMsg?.classList.add('show'), 380);

    // Ocultar tras 1.6s → ejecutar onDone
    setTimeout(() => {
      flash.classList.remove('show');
      flash.setAttribute('aria-hidden', 'true');
      setTimeout(onDone, 330);
    }, 1650);
  }

  // ════════════════════════════════════════════════════════════
  // FEEDBACK TOAST (chips dopamínicos)
  // ════════════════════════════════════════════════════════════
  function showFeedback(toastId: string, chips: Array<{ label: string; positive: boolean }>): void {
    const el = document.getElementById(toastId);
    if (!el) return;

    if (chips.length === 0) {
      el.innerHTML = '<span class="fb-chip fb-chip--neu">Sin puntos extra</span>';
    } else {
      el.innerHTML = chips
        .map((c, i) =>
          `<span class="fb-chip fb-chip--pos" style="animation-delay:${i * 80}ms">${c.label}</span>`
        )
        .join('');
    }

    el.classList.add('show');
  }

