  // ════════════════════════════════════════════════════════════
  // SCREEN NAVIGATION
  // ════════════════════════════════════════════════════════════
  function goToScreen(n: number): void {
    if (state.isTransitioning || n === state.currentScreen) return;
    state.isTransitioning = true;

    const curr = document.getElementById(`gs${state.currentScreen}`);
    const next = document.getElementById(`gs${n}`);
    if (!curr || !next) { state.isTransitioning = false; return; }

    curr.classList.add('gs--exit');
    curr.setAttribute('aria-hidden', 'true');

    setTimeout(() => {
      curr.classList.remove('gs--active', 'gs--exit');
      next.classList.add('gs--active');
      next.setAttribute('aria-hidden', 'false');
      state.currentScreen = n;
      state.isTransitioning = false;

      // Mute button adapts to screen background
      const muteBtn = document.getElementById('btn-mute');
      if (muteBtn) muteBtn.classList.toggle('mute-btn--light', n === 7);

      // Barra de progreso global
      const PROGRESS: Record<number, number> = { 1: 5, 2: 20, 3: 40, 4: 60, 5: 78, 6: 92, 7: 100 };
      const fill = document.getElementById('game-progress-fill');
      if (fill) {
        fill.style.width = `${PROGRESS[n] ?? 0}%`;
        fill.style.background = n === 7 ? 'rgba(26,26,26,0.28)' : '#ffb800';
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          fill.classList.remove('progress-fill--flash');
          void fill.offsetWidth;
          fill.classList.add('progress-fill--flash');
          setTimeout(() => fill.classList.remove('progress-fill--flash'), 550);
        }
      }

      // On-enter hooks
      if (n === 2) runPowerSequence();
      if (n === 5) runDoubtSequence();
      if (n === 6) setTimeout(runRevealSequence, 350);
    }, 380);
  }

