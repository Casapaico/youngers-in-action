  function openShareModal(): void {
    const cat  = getTopCategory();
    const p    = PROFILES[cat];
    const pct  = state.impactPct;

    const iconEl  = document.getElementById('sc-icon');
    const titleEl = document.getElementById('sc-title');
    const pctEl   = document.getElementById('sc-pct');
    const barFill = document.getElementById('sc-bar-fill');
    const odsEl   = document.getElementById('sc-ods');
    const cardEl  = document.getElementById('share-card');

    if (iconEl)  iconEl.textContent  = p.icon;
    if (titleEl) titleEl.textContent = p.title;
    if (pctEl)   pctEl.textContent   = `${pct}%`;
    if (barFill) {
      barFill.style.width = '0';
      rAF2(() => { barFill.style.width = `${pct}%`; });
    }
    if (odsEl) odsEl.innerHTML = p.ods
      .map(o => {
        const c = ODS_COLORS[o] ?? '#ffffff';
        return `<span class="sc-ods-tag" style="border-color:${c}55;background:${c}18;color:${c}">${o}</span>`;
      })
      .join('');
    if (cardEl)  cardEl.style.setProperty('--sc-bg', p.colorAlpha);

    const modal = document.getElementById('share-modal');
    if (modal) {
      modal.classList.add('show');
      modal.setAttribute('aria-hidden', 'false');
      // Foco al botón cerrar para accesibilidad
      setTimeout(() => (document.getElementById('share-modal-close') as HTMLButtonElement | null)?.focus(), 50);
    }
  }

  function closeShareModal(): void {
    const modal = document.getElementById('share-modal');
    if (modal) {
      modal.classList.remove('show');
      modal.setAttribute('aria-hidden', 'true');
    }
    // Reset bar so la próxima apertura anima desde 0
    const scBar = document.getElementById('sc-bar-fill');
    if (scBar) scBar.style.width = '0';
  }

  async function shareResult(): Promise<void> {
    openShareModal();
  }

  async function doNativeShare(): Promise<void> {
    const cat = getTopCategory();
    const p = PROFILES[cat];
    const shareText = `Descubrí que soy ${p.icon} ${p.title}.\n¿Cuál es tu perfil de impacto?`;
    const shareUrl  = 'https://youngersInAction.org';

    if (navigator.share) {
      try {
        await navigator.share({
          title: `Soy ${p.title} | Youngers in Action`,
          text:  shareText,
          url:   shareUrl,
        });
      } catch { /* usuario canceló */ }
    } else {
      try {
        await navigator.clipboard.writeText(`${shareText}\n${shareUrl}`);
        closeShareModal();
        showShareToast();
      } catch { /* sin clipboard API */ }
    }
  }

  async function doCopyLink(): Promise<void> {
    const shareUrl = 'https://youngersInAction.org';
    try {
      await navigator.clipboard.writeText(shareUrl);
      closeShareModal();
      showShareToast();
    } catch { /* sin clipboard API */ }
  }

  // ════════════════════════════════════════════════════════════
  // INIT
  // ════════════════════════════════════════════════════════════
  function initGame(): void {
    // Barra de progreso: estado inicial S1
    const initialFill = document.getElementById('game-progress-fill');
    if (initialFill) initialFill.style.width = '5%';

    // S1: Arrancar script conversacional
    runHookScript();

    // S1: Comenzar → S2
    document.getElementById('btn-start')?.addEventListener('click', () => { sndClick(); goToScreen(2); });

    // S1: Saltar → Hero
    document.getElementById('btn-skip')?.addEventListener('click', scrollToHero);

    // S2: Continuar → S3
    document.getElementById('btn-power')?.addEventListener('click', () => {
      sndClick();
      setWorldState(1);
      setAvatarState(1);
      goToScreen(3);
    });

    // Page Visibility: suspender audio cuando la pestaña queda oculta
    document.addEventListener('visibilitychange', () => {
      if (!_audioCtx) return;
      if (document.hidden) {
        _audioCtx.suspend().catch(() => {});
      } else if (!_muted) {
        _audioCtx.resume().catch(() => {});
      }
    });

    // Mute toggle
    document.getElementById('btn-mute')?.addEventListener('click', () => {
      _muted = !_muted;
      const btn = document.getElementById('btn-mute');
      if (btn) {
        btn.setAttribute('aria-pressed', _muted ? 'true' : 'false');
        btn.setAttribute('aria-label', _muted ? 'Activar sonidos' : 'Silenciar sonidos');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          btn.classList.remove('mute-btn--toggled');
          void btn.offsetWidth;
          btn.classList.add('mute-btn--toggled');
        }
      }
      // Feedback sonoro al activar
      if (!_muted) setTimeout(sndClick, 80);
    });

    // S3: Decisión 1
    document.querySelectorAll<HTMLButtonElement>('#grid-1 .opt').forEach(btn => {
      btn.addEventListener('click', (e: MouseEvent) => {
        if (state.isTransitioning) return;

        const val = btn.dataset.val ?? '';
        document.querySelectorAll<HTMLButtonElement>('#grid-1 .opt').forEach(b => {
          b.classList.remove('opt--selected');
          b.setAttribute('aria-pressed', 'false');
          b.disabled = true;
          if (b !== btn) b.classList.add('opt--fade');
        });
        btn.classList.add('opt--selected', 'opt--punch');
        btn.addEventListener('animationend', () => btn.classList.remove('opt--punch'), { once: true });
        btn.setAttribute('aria-pressed', 'true');
        addRipple(btn, e);
        sndChoose();
        haptic(14);

        const sc = SCORES_D1[val] ?? {};
        for (const [k, v] of Object.entries(sc)) {
          state.scores[k] = (state.scores[k] ?? 0) + v;
        }

        const total = Object.values(state.scores).reduce((a, b) => a + b, 0);
        animatePts('pts-val-2', total);
        pulsePts('pts-badge-1');

        // Feedback chip en la card
        const label = D1_LABELS[val] ?? val;
        const score = sc[val] ?? 40;
        showFeedback('fb1', [{ label: `+${score} ${label}`, positive: true }]);

        // Floating number desde el botón
        const d1Color = AREA_COLORS[val] ?? '#2d9253';
        spawnFloats([{ label: `+${score} ${label}`, color: d1Color }], btn);

        // World state 2: escuela colorida + personas
        setWorldState(2);
        setAvatarState(2);

        // Personalizar contexto de S4 con la decisión tomada
        const gs4Context = document.querySelector<HTMLElement>('#gs4 .q-context');
        if (gs4Context) {
          gs4Context.innerHTML = `<span aria-hidden="true">📍</span> Invertiste en <strong>${label}</strong>. Esta situación es real para miles de jóvenes en Lima.`;
        }

        // World flash → luego S4
        setTimeout(() => {
          showWorldFlash(2, [{ label: `+${score} ${label}`, color: d1Color }], () => goToScreen(4));
        }, 140);
      });
    });

    // S4: Decisión 2
    document.querySelectorAll<HTMLButtonElement>('#grid-2 .opt').forEach(btn => {
      btn.addEventListener('click', (e: MouseEvent) => {
        if (state.isTransitioning) return;

        const val = btn.dataset.val ?? '';
        document.querySelectorAll<HTMLButtonElement>('#grid-2 .opt').forEach(b => {
          b.classList.remove('opt--selected');
          b.setAttribute('aria-pressed', 'false');
          b.disabled = true;
          if (b !== btn) b.classList.add('opt--fade');
        });
        btn.classList.add('opt--selected', 'opt--punch');
        btn.addEventListener('animationend', () => btn.classList.remove('opt--punch'), { once: true });
        btn.setAttribute('aria-pressed', 'true');
        addRipple(btn, e);
        sndChoose();
        haptic(14);

        const sc = SCORES_D2[val] ?? {};
        for (const [k, v] of Object.entries(sc)) {
          if (k === 'impact') {
            state.impactPct = v;
          } else {
            state.scores[k] = (state.scores[k] ?? 0) + v;
          }
        }

        pulsePts('pts-badge-2');

        // Chips de feedback en la card
        const chipLabels = D2_LABELS[val] ?? {};
        const toastChips = Object.values(chipLabels).map(l => ({ label: l, positive: true }));
        showFeedback('fb2', toastChips);

        // Chips para floats y flash
        const rawD2 = D2_CHIPS[val] ?? [];
        const d2FloatChips: FloatChip[] = rawD2.length > 0
          ? rawD2.map(c => ({ label: `+${c.pts} ${D1_LABELS[c.area]}`, color: AREA_COLORS[c.area] ?? '#2d9253' }))
          : [{ label: 'Decisión registrada', color: '#737373' }];

        // Floating numbers
        spawnFloats(d2FloatChips, btn);

        // World state 3: ciudad viva + avatar líder
        setWorldState(3);
        setAvatarState(3);

        // World flash → luego S5 (duda existencial)
        setTimeout(() => {
          showWorldFlash(3, d2FloatChips, () => goToScreen(5));
        }, 140);
      });
    });

    // S6: Ver misión → S7 CTA
    document.getElementById('btn-to-cta')?.addEventListener('click', () => {
      sndClick();
      buildCTA();
      goToScreen(7);
      setTimeout(launchConfetti, 250);
    });

    // S3/S4: Navegación con teclado en opt-grids (accesibilidad)
    ['grid-1', 'grid-2'].forEach(gridId => {
      const grid = document.getElementById(gridId);
      if (!grid) return;
      grid.addEventListener('keydown', (e: KeyboardEvent) => {
        const btns = Array.from(grid.querySelectorAll<HTMLButtonElement>('.opt:not(:disabled)'));
        const idx  = btns.indexOf(document.activeElement as HTMLButtonElement);
        if (idx === -1) return;
        let next = idx;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown')  next = (idx + 1) % btns.length;
        if (e.key === 'ArrowLeft'  || e.key === 'ArrowUp')    next = (idx - 1 + btns.length) % btns.length;
        if (next !== idx) { e.preventDefault(); btns[next]?.focus(); }
      });
    });

    // S3/S4: World peek hover (desktop only)
    if (!window.matchMedia('(hover: none)').matches) {
      document.querySelectorAll<HTMLButtonElement>('#grid-1 .opt').forEach(btn => {
        const pk = D1_PEEK[btn.dataset.val ?? ''];
        if (!pk) return;
        btn.addEventListener('mouseenter', () => showWorldPeek('world-peek-3', 'world-peek-label-3', pk.state, pk.msg));
        btn.addEventListener('mouseleave', () => hideWorldPeek('world-peek-3'));
      });
      document.querySelectorAll<HTMLButtonElement>('#grid-2 .opt').forEach(btn => {
        const pk = D2_PEEK[btn.dataset.val ?? ''];
        if (!pk) return;
        btn.addEventListener('mouseenter', () => showWorldPeek('world-peek-4', 'world-peek-label-4', pk.state, pk.msg));
        btn.addEventListener('mouseleave', () => hideWorldPeek('world-peek-4'));
      });
    }

    // S7: Compartir perfil → abre modal
    document.getElementById('btn-share')?.addEventListener('click', () => {
      sndClick();
      shareResult();
    });

    // Share modal: botón "Compartir" → share nativo
    document.getElementById('btn-share-go')?.addEventListener('click', () => {
      sndClick();
      doNativeShare();
    });

    // Share modal: botón "Copiar enlace"
    document.getElementById('btn-share-copy')?.addEventListener('click', () => {
      sndClick();
      doCopyLink();
    });

    // Share modal: cerrar
    document.getElementById('share-modal-close')?.addEventListener('click', closeShareModal);
    document.getElementById('share-modal-backdrop')?.addEventListener('click', closeShareModal);

    // Share modal: Escape para cerrar + focus trap (Tab/Shift+Tab)
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      const modal = document.getElementById('share-modal');
      const isOpen = modal?.classList.contains('show');
      if (!isOpen) return;

      if (e.key === 'Escape') { closeShareModal(); return; }

      if (e.key === 'Tab') {
        const focusable = [
          document.getElementById('share-modal-close'),
          document.getElementById('btn-share-go'),
          document.getElementById('btn-share-copy'),
        ].filter((el): el is HTMLElement => el !== null);
        const first = focusable[0];
        const last  = focusable[focusable.length - 1];
        if (e.shiftKey) {
          if (document.activeElement === first) { e.preventDefault(); last?.focus(); }
        } else {
          if (document.activeElement === last)  { e.preventDefault(); first?.focus(); }
        }
      }
    });

    // S7: Unirse → Hero
    document.getElementById('btn-join')?.addEventListener('click', scrollToHero);

    // S7: Replay
    document.getElementById('btn-replay')?.addEventListener('click', () => {
      resetGame();
      hardGoToScreen1();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGame);
  } else {
    initGame();
  }
</script>
