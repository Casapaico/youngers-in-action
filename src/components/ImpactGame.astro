  // ════════════════════════════════════════════════════════════
  // S2 — POWER DELIVERY SEQUENCE
  // ════════════════════════════════════════════════════════════
  function runPowerSequence(): void {
    const container = document.getElementById('power-text');
    const btn = document.getElementById('btn-power');
    if (!container) return;

    // "Te entregamos:"
    setTimeout(() => {
      const label = document.createElement('p');
      label.className = 'power-line power-line--label';
      label.textContent = 'Te entregamos:';
      container.appendChild(label);
      rAF2(() => label.classList.add('show'));
    }, 500);

    // Contador 0 → 100
    setTimeout(() => {
      const wrap = document.createElement('div');
      wrap.className = 'power-line power-line--counter';

      const numEl = document.createElement('span');
      numEl.className = 'power-num';
      numEl.textContent = '0';
      numEl.id = 'power-num';

      const unitEl = document.createElement('span');
      unitEl.className = 'power-unit';
      unitEl.textContent = 'puntos de impacto';

      wrap.appendChild(numEl);
      wrap.appendChild(unitEl);
      container.appendChild(wrap);

      rAF2(() => {
        wrap.classList.add('show');
        animateCounter(numEl, 0, 100, 1400);
      });
    }, 1100);

    // "Todo empieza con una decisión."
    setTimeout(() => {
      const msg = document.createElement('p');
      msg.className = 'power-line power-line--msg';
      msg.textContent = 'Todo empieza con una decisión.';
      container.appendChild(msg);
      rAF2(() => msg.classList.add('show'));
    }, 2900);

    // Pulso del mundo al completar el contador (1400ms + 100ms buffer)
    setTimeout(() => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const ww = document.querySelector<HTMLElement>('.world-wrap');
      if (!ww) return;
      ww.classList.add('world-wrap--pulse');
      setTimeout(() => ww.classList.remove('world-wrap--pulse'), 800);
    }, 1500);

    // Celebración power-num cuando el contador llega a 100 (1100ms inicio + 1400ms duración)
    setTimeout(() => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const numEl = document.getElementById('power-num');
      if (!numEl) return;
      numEl.classList.add('power-num--done');
      setTimeout(() => numEl.classList.remove('power-num--done'), 700);
    }, 2550);

    // Botón continuar
    setTimeout(() => {
      if (btn) {
        btn.classList.add('show');
        btn.removeAttribute('aria-hidden');
      }
    }, 3800);
  }

