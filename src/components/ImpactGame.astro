  // ════════════════════════════════════════════════════════════
  function showWorldPeek(peekId: string, labelId: string, peekState: number, msg: string): void {
    const peek = document.getElementById(peekId);
    if (!peek) return;
    const svg = peek.querySelector<SVGSVGElement>('.world-peek-svg');
    if (svg) {
      svg.classList.remove('ws-0', 'ws-1', 'ws-2', 'ws-3');
      svg.classList.add(`ws-${peekState}`);
    }
    const label = document.getElementById(labelId);
    if (label) label.textContent = msg;
    peek.classList.add('show');
  }

