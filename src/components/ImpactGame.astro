  function setPts(elId: string, val: number): void {
    const el = document.getElementById(elId);
    if (el) el.textContent = String(val);
  }

  function animateNum(el: HTMLElement, from: number, to: number, dur = 700): void {
    const t0 = performance.now();
    const run = (now: number) => {
      const prog  = Math.min((now - t0) / dur, 1);
      const eased = 1 - Math.pow(1 - prog, 3); // ease-out cubic
      el.textContent = String(Math.round(from + (to - from) * eased));
      if (prog < 1) requestAnimationFrame(run);
      else el.textContent = String(to);
    };
    requestAnimationFrame(run);
  }

  function animatePts(elId: string, to: number): void {
    const el = document.getElementById(elId);
    if (!el) return;
    const from = parseInt(el.textContent ?? '0', 10);
    if (from === to) return;
    const dur = 500;
    const t0  = performance.now();
    const run = (now: number) => {
      const prog  = Math.min((now - t0) / dur, 1);
      const eased = 1 - Math.pow(1 - prog, 2); // ease-out quad
      el.textContent = String(Math.round(from + (to - from) * eased));
      if (prog < 1) requestAnimationFrame(run);
      else el.textContent = String(to);
    };
    requestAnimationFrame(run);
  }

