---
// ImpactGame.astro — Experiencia conversacional de impacto v2
// Youngers in Action · 7 pantallas · Sistema conversacional · World SVG
---

<section
  id="game"
  class="fullpage-section yia-game"
  aria-label="Experiencia interactiva: Tu decisión cambia el mundo"
>

  <!-- ════════════════════════════════════════════════════════
       S1 — HOOK CONVERSACIONAL
       ════════════════════════════════════════════════════════ -->
  <div class="gs gs--active" id="gs1" role="region" aria-label="Inicio">
    <!-- Foto de fondo: /public/images/game/lima-hero.png
         Actualmente usa fondo_de_inicio.png. Reemplazar con foto de Lima/juventud si se desea.
         Recomendado: 1280×720px WebP, <180KB para mejor rendimiento. -->
    <div class="gs1-bg-img" aria-hidden="true"></div>
    <div class="orb-bg" aria-hidden="true">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
    </div>

    <div class="conv-stage">
      <div class="conv-lines" id="conv-lines" aria-live="polite" aria-atomic="false"></div>
      <div class="conv-cta" id="conv-cta" aria-hidden="true">
        <p class="game-meta">⚡ 2 min &nbsp;·&nbsp; 2 decisiones &nbsp;·&nbsp; 1 perfil único</p>
        <button class="yia-btn yia-btn--yellow" id="btn-start">
          Comenzar
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </button>
        <button class="yia-btn yia-btn--ghost" id="btn-skip">Saltar al contenido ↓</button>
      </div>
    </div>

  </div>

  <!-- ════════════════════════════════════════════════════════
       S2 — POWER DELIVERY + WORLD SVG
       ════════════════════════════════════════════════════════ -->
  <div class="gs" id="gs2" role="region" aria-label="Tus puntos de impacto" aria-hidden="true">
    <div class="gs-inner gs-inner--power">

      <!-- World SVG illustration -->
      <div class="world-wrap">
        <div class="world-float">
          <svg
            viewBox="0 0 360 220"
            class="world-svg ws-0"
            id="world-svg"
            xmlns="http://www.w3.org/2000/svg"
            role="img"
            aria-label="Ciudad de Lima"
          >
            <!-- SKY -->
            <rect class="ws-sky" x="0" y="0" width="360" height="220"/>

            <!-- SUN + RAYS -->
            <g class="ws-sun-group">
              <circle class="ws-sun" cx="308" cy="42" r="20"/>
              <g class="ws-rays" stroke-linecap="round">
                <line x1="308" y1="14" x2="308" y2="6"/>
                <line x1="308" y1="78" x2="308" y2="70"/>
                <line x1="272" y1="42" x2="264" y2="42"/>
                <line x1="344" y1="42" x2="336" y2="42"/>
                <line x1="283" y1="17" x2="277" y2="11"/>
                <line x1="333" y1="67" x2="327" y2="61"/>
                <line x1="328" y1="16" x2="334" y2="10"/>
                <line x1="278" y1="68" x2="284" y2="62"/>
              </g>
            </g>

            <!-- MOUNTAINS -->
            <polygon class="ws-mtn" points="0,178 75,92 150,178"/>
            <polygon class="ws-mtn" points="70,178 175,100 280,178"/>
            <polygon class="ws-mtn" points="210,178 298,108 360,178"/>

            <!-- GROUND -->
            <rect class="ws-ground" x="0" y="175" width="360" height="45"/>

            <!-- ROAD -->
            <rect class="ws-road" x="0" y="183" width="360" height="14"/>
            <rect class="ws-rdash" x="30"  y="189" width="28" height="3" rx="1.5"/>
            <rect class="ws-rdash" x="110" y="189" width="28" height="3" rx="1.5"/>
            <rect class="ws-rdash" x="190" y="189" width="28" height="3" rx="1.5"/>
            <rect class="ws-rdash" x="270" y="189" width="28" height="3" rx="1.5"/>

            <!-- BUILDING 1 (tall, left) -->
            <rect class="ws-bldg ws-b1" x="20"  y="92"  width="54" height="86" rx="2"/>
            <rect class="ws-win" x="28" y="100" width="10" height="8" rx="1"/>
            <rect class="ws-win" x="46" y="100" width="10" height="8" rx="1"/>
            <rect class="ws-win" x="28" y="114" width="10" height="8" rx="1"/>
            <rect class="ws-win" x="46" y="114" width="10" height="8" rx="1"/>
            <rect class="ws-win" x="28" y="128" width="10" height="8" rx="1"/>
            <rect class="ws-win" x="46" y="128" width="10" height="8" rx="1"/>
            <rect class="ws-win" x="28" y="142" width="10" height="8" rx="1"/>
            <rect class="ws-win" x="46" y="142" width="10" height="8" rx="1"/>

            <!-- BUILDING 2 (medium) -->
            <rect class="ws-bldg ws-b2" x="88"  y="112" width="42" height="66" rx="2"/>
            <rect class="ws-win" x="96"  y="120" width="9" height="8" rx="1"/>
            <rect class="ws-win" x="113" y="120" width="9" height="8" rx="1"/>
            <rect class="ws-win" x="96"  y="134" width="9" height="8" rx="1"/>
            <rect class="ws-win" x="113" y="134" width="9" height="8" rx="1"/>
            <rect class="ws-win" x="96"  y="148" width="9" height="8" rx="1"/>
            <rect class="ws-win" x="113" y="148" width="9" height="8" rx="1"/>

            <!-- BUILDING 3 — ESCUELA (centro) -->
            <g class="ws-school">
              <polygon class="ws-school-roof" points="143,104 182,80 221,104"/>
              <rect   class="ws-school-body" x="148" y="102" width="68" height="76" rx="2"/>
              <rect   class="ws-school-door" x="170" y="148" width="24" height="30" rx="2"/>
              <rect   class="ws-win ws-school-win" x="156" y="112" width="12" height="10" rx="1"/>
              <rect   class="ws-win ws-school-win" x="196" y="112" width="12" height="10" rx="1"/>
              <rect   class="ws-win ws-school-win" x="156" y="128" width="12" height="10" rx="1"/>
              <rect   class="ws-win ws-school-win" x="196" y="128" width="12" height="10" rx="1"/>
              <circle class="ws-school-star" cx="182" cy="76" r="5"/>
            </g>

            <!-- BUILDING 4 (tall, right) -->
            <rect class="ws-bldg ws-b4" x="234" y="78"  width="40" height="100" rx="2"/>
            <rect class="ws-win" x="242" y="86"  width="9" height="8" rx="1"/>
            <rect class="ws-win" x="257" y="86"  width="9" height="8" rx="1"/>
            <rect class="ws-win" x="242" y="100" width="9" height="8" rx="1"/>
            <rect class="ws-win" x="257" y="100" width="9" height="8" rx="1"/>
            <rect class="ws-win" x="242" y="114" width="9" height="8" rx="1"/>
            <rect class="ws-win" x="257" y="114" width="9" height="8" rx="1"/>
            <rect class="ws-win" x="242" y="128" width="9" height="8" rx="1"/>
            <rect class="ws-win" x="257" y="128" width="9" height="8" rx="1"/>
            <rect class="ws-win" x="242" y="142" width="9" height="8" rx="1"/>
            <rect class="ws-win" x="257" y="142" width="9" height="8" rx="1"/>

            <!-- BUILDING 5 (small, right) -->
            <rect class="ws-bldg ws-b5" x="290" y="128" width="55" height="50" rx="2"/>
            <rect class="ws-win" x="298" y="136" width="9" height="8" rx="1"/>
            <rect class="ws-win" x="314" y="136" width="9" height="8" rx="1"/>
            <rect class="ws-win" x="330" y="136" width="9" height="8" rx="1"/>
            <rect class="ws-win" x="298" y="150" width="9" height="8" rx="1"/>
            <rect class="ws-win" x="314" y="150" width="9" height="8" rx="1"/>

            <!-- TREES -->
            <g class="ws-tree">
              <rect  class="ws-trunk" x="78.5"  y="163" width="3" height="15" rx="1.5"/>
              <ellipse class="ws-leaf"  cx="80"   cy="152" rx="13" ry="14"/>
            </g>
            <g class="ws-tree">
              <rect  class="ws-trunk" x="138.5" y="165" width="3" height="13" rx="1.5"/>
              <ellipse class="ws-leaf"  cx="140"  cy="154" rx="11" ry="13"/>
            </g>
            <g class="ws-tree">
              <rect  class="ws-trunk" x="224.5" y="165" width="3" height="13" rx="1.5"/>
              <ellipse class="ws-leaf"  cx="226"  cy="154" rx="11" ry="13"/>
            </g>
            <g class="ws-tree">
              <rect  class="ws-trunk" x="279.5" y="165" width="3" height="13" rx="1.5"/>
              <ellipse class="ws-leaf"  cx="281"  cy="154" rx="11" ry="13"/>
            </g>
            <g class="ws-tree">
              <rect  class="ws-trunk" x="348.5" y="168" width="3" height="10" rx="1.5"/>
              <ellipse class="ws-leaf"  cx="350"  cy="159" rx="9"  ry="11"/>
            </g>

            <!-- PERSONAS (ocultas en estado 0) -->
            <g class="ws-people" stroke-linecap="round">
              <g class="ws-person">
                <circle cx="115" cy="174" r="4"/>
                <line x1="115" y1="178" x2="115" y2="188"/>
                <line x1="111" y1="182" x2="115" y2="180"/>
                <line x1="119" y1="182" x2="115" y2="180"/>
              </g>
              <g class="ws-person">
                <circle cx="130" cy="173" r="3.5"/>
                <line x1="130" y1="177" x2="130" y2="186"/>
              </g>
              <g class="ws-person">
                <circle cx="210" cy="174" r="4"/>
                <line x1="210" y1="178" x2="210" y2="188"/>
                <line x1="206" y1="182" x2="210" y2="180"/>
              </g>
              <g class="ws-person">
                <circle cx="226" cy="173" r="3.5"/>
                <line x1="226" y1="177" x2="226" y2="186"/>
                <line x1="222" y1="181" x2="226" y2="179"/>
                <line x1="230" y1="181" x2="226" y2="179"/>
              </g>
            </g>
          </svg>
        </div>
      </div>

      <!-- Avatar que evoluciona -->
      <div class="avatar-wrap" aria-hidden="true">
        <svg
          viewBox="0 0 100 160"
          class="avatar-svg av-0"
          id="avatar-svg"
          xmlns="http://www.w3.org/2000/svg"
        >
          <!-- Cabeza -->
          <circle class="av-head" cx="50" cy="34" r="18"/>
          <!-- Cuello -->
          <rect  class="av-body" x="44" y="50" width="12" height="8" rx="3"/>
          <!-- Cuerpo -->
          <rect  class="av-body" x="30" y="56" width="40" height="46" rx="8"/>
          <!-- Brazo izq -->
          <rect  class="av-arm"  x="14" y="58" width="16" height="36" rx="6" transform="rotate(-8,22,76)"/>
          <!-- Brazo der -->
          <rect  class="av-arm"  x="70" y="58" width="16" height="36" rx="6" transform="rotate(8,78,76)"/>
          <!-- Pierna izq -->
          <rect  class="av-leg"  x="32" y="98" width="15" height="42" rx="6"/>
          <!-- Pierna der -->
          <rect  class="av-leg"  x="53" y="98" width="15" height="42" rx="6"/>
          <!-- Cara: ojos -->
          <circle class="av-face" cx="44" cy="31" r="2.5"/>
          <circle class="av-face" cx="56" cy="31" r="2.5"/>
          <!-- Cara: boca (neutral → smile) -->
          <path   class="av-mouth av-mouth--neutral" d="M44 40 Q50 42 56 40" stroke-linecap="round" fill="none"/>
          <path   class="av-mouth av-mouth--smile"   d="M44 39 Q50 44 56 39" stroke-linecap="round" fill="none"/>
          <!-- Estrella / emblema (aparece en estado 3) -->
          <g class="av-badge">
            <circle cx="50" cy="16" r="9"/>
            <text x="50" y="20" text-anchor="middle" class="av-badge-star">★</text>
          </g>
          <!-- Capa / aura (estado 3) -->
          <path class="av-cape" d="M30 56 Q18 90 22 130 Q36 116 50 120 Q64 116 78 130 Q82 90 70 56Z"/>
        </svg>
        <p class="avatar-label" id="avatar-label">Tú</p>
      </div>

      <!-- Secuencia de texto de poder -->
      <div class="power-text" id="power-text" aria-live="polite"></div>

      <!-- Botón continuar -->
      <button class="yia-btn yia-btn--yellow power-cta" id="btn-power" aria-hidden="true">
        ¿Dónde invierto?
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════
       S3 — DECISIÓN 1
       ════════════════════════════════════════════════════════ -->
  <div class="gs" id="gs3" role="region" aria-label="Decisión 1 de 2" aria-hidden="true">
    <!-- World peek: preview mini del mundo al hacer hover sobre opciones -->
    <div class="world-peek" id="world-peek-3" aria-hidden="true">
      <svg viewBox="0 0 120 74" class="world-svg world-peek-svg ws-0" xmlns="http://www.w3.org/2000/svg">
        <rect class="ws-sky"   x="0"  y="0"  width="120" height="74"/>
        <circle class="ws-sun" cx="102" cy="14" r="8"/>
        <rect class="ws-ground" x="0" y="60" width="120" height="14"/>
        <rect class="ws-bldg ws-b1" x="6"  y="28" width="18" height="34" rx="1"/>
        <rect class="ws-bldg ws-b2" x="28" y="36" width="14" height="26" rx="1"/>
        <g class="ws-school">
          <polygon class="ws-school-roof" points="50,28 62,20 74,28"/>
          <rect    class="ws-school-body" x="50" y="28" width="24" height="34" rx="1"/>
          <circle  class="ws-school-star" cx="62" cy="17" r="4"/>
        </g>
        <rect class="ws-bldg ws-b4" x="82" y="22" width="14" height="40" rx="1"/>
        <ellipse class="ws-leaf" cx="27" cy="47" rx="5" ry="6"/>
        <ellipse class="ws-leaf" cx="80" cy="49" rx="4" ry="5"/>
        <g class="ws-people" stroke-linecap="round">
          <circle cx="44" cy="56" r="3"/>
          <line x1="44" y1="59" x2="44" y2="65"/>
          <circle cx="55" cy="55" r="2.5"/>
          <line x1="55" y1="58" x2="55" y2="64"/>
        </g>
      </svg>
      <p class="world-peek-label" id="world-peek-label-3"></p>
    </div>

    <div class="gs-inner gs-inner--decision">
      <div class="game-topbar">
        <div class="step-dots">
          <span class="sd sd--active" aria-label="Paso 1 de 2">1</span>
          <div class="sd-line"></div>
          <span class="sd" aria-label="Paso 2">2</span>
        </div>
        <div class="pts-badge" id="pts-badge-1">
          <span aria-hidden="true">⚡</span>
          <strong id="pts-val-1">100</strong>&nbsp;pts
        </div>
      </div>

      <div class="q-block">
        <span class="q-eyebrow">Decisión 1 de 2</span>
        <h2 class="q-h2">Tienes 100 puntos de impacto.<br/>¿Dónde los inviertes?</h2>
      </div>

      <div class="opt-grid" id="grid-1" role="group" aria-label="Elige un área">
        <button class="opt" data-val="educacion" aria-pressed="false" style="--opt-accent:#C5192D">
          <span class="opt-emoji" aria-hidden="true">📚</span>
          <strong class="opt-title">Educación</strong>
          <span class="opt-desc">Formás mentes, cambiás vidas</span>
          <span class="ripple-origin" aria-hidden="true"></span>
        </button>
        <button class="opt" data-val="igualdad" aria-pressed="false" style="--opt-accent:#E63946">
          <span class="opt-emoji" aria-hidden="true">⚖️</span>
          <strong class="opt-title">Igualdad</strong>
          <span class="opt-desc">Todos merecen las mismas oportunidades</span>
          <span class="ripple-origin" aria-hidden="true"></span>
        </button>
        <button class="opt" data-val="salud" aria-pressed="false" style="--opt-accent:#2D9253">
          <span class="opt-emoji" aria-hidden="true">💚</span>
          <strong class="opt-title">Salud mental</strong>
          <span class="opt-desc">El bienestar es la base del cambio</span>
          <span class="ripple-origin" aria-hidden="true"></span>
        </button>
        <button class="opt" data-val="comunidad" aria-pressed="false" style="--opt-accent:#1565C0">
          <span class="opt-emoji" aria-hidden="true">🌍</span>
          <strong class="opt-title">Comunidad</strong>
          <span class="opt-desc">Unidos somos más fuertes</span>
          <span class="ripple-origin" aria-hidden="true"></span>
        </button>
      </div>

      <div class="feedback-toast" id="fb1" aria-live="assertive"></div>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════
       S4 — DECISIÓN 2 (historia emocional)
       ════════════════════════════════════════════════════════ -->
  <div class="gs" id="gs4" role="region" aria-label="Decisión 2 de 2" aria-hidden="true">
    <div class="world-peek" id="world-peek-4" aria-hidden="true">
      <svg viewBox="0 0 120 74" class="world-svg world-peek-svg ws-0" xmlns="http://www.w3.org/2000/svg">
        <rect class="ws-sky"   x="0"  y="0"  width="120" height="74"/>
        <circle class="ws-sun" cx="102" cy="14" r="8"/>
        <rect class="ws-ground" x="0" y="60" width="120" height="14"/>
        <rect class="ws-bldg ws-b1" x="6"  y="28" width="18" height="34" rx="1"/>
        <rect class="ws-bldg ws-b2" x="28" y="36" width="14" height="26" rx="1"/>
        <g class="ws-school">
          <polygon class="ws-school-roof" points="50,28 62,20 74,28"/>
          <rect    class="ws-school-body" x="50" y="28" width="24" height="34" rx="1"/>
          <circle  class="ws-school-star" cx="62" cy="17" r="4"/>
        </g>
        <rect class="ws-bldg ws-b4" x="82" y="22" width="14" height="40" rx="1"/>
        <ellipse class="ws-leaf" cx="27" cy="47" rx="5" ry="6"/>
        <ellipse class="ws-leaf" cx="80" cy="49" rx="4" ry="5"/>
        <g class="ws-people" stroke-linecap="round">
          <circle cx="44" cy="56" r="3"/>
          <line x1="44" y1="59" x2="44" y2="65"/>
          <circle cx="55" cy="55" r="2.5"/>
          <line x1="55" y1="58" x2="55" y2="64"/>
        </g>
      </svg>
      <p class="world-peek-label" id="world-peek-label-4"></p>
    </div>

    <div class="gs-inner gs-inner--decision">
      <div class="game-topbar">
        <div class="step-dots">
          <span class="sd sd--done" aria-label="Paso 1 completado">✓</span>
          <div class="sd-line sd-line--done"></div>
          <span class="sd sd--active" aria-label="Paso 2 activo">2</span>
        </div>
        <div class="pts-badge" id="pts-badge-2">
          <span aria-hidden="true">⚡</span>
          <strong id="pts-val-2">100</strong>&nbsp;pts
        </div>
      </div>

      <div class="q-block">
        <span class="q-eyebrow">Historia real · Lima, Perú</span>
        <h2 class="q-h2">Una niña quiere liderar.<br/>Pero nadie cree en ella.</h2>
        <p class="q-context">
          <span aria-hidden="true">📍</span> Esta situación es real para miles de jóvenes.
        </p>
      </div>

      <div class="opt-grid" id="grid-2" role="group" aria-label="¿Qué haces?">
        <button class="opt opt--neutral" data-val="ignora" aria-pressed="false" style="--opt-accent:#737373">
          <span class="opt-emoji" aria-hidden="true">😶</span>
          <strong class="opt-title">La ignoras</strong>
          <span class="opt-desc">No es tu problema ahora mismo</span>
          <span class="ripple-origin" aria-hidden="true"></span>
        </button>
        <button class="opt" data-val="motiva" aria-pressed="false" style="--opt-accent:#2D9253">
          <span class="opt-emoji" aria-hidden="true">💬</span>
          <strong class="opt-title">La motivas</strong>
          <span class="opt-desc">Le decís que puede lograrlo</span>
          <span class="ripple-origin" aria-hidden="true"></span>
        </button>
        <button class="opt" data-val="proyecto" aria-pressed="false" style="--opt-accent:#E63946">
          <span class="opt-emoji" aria-hidden="true">🚀</span>
          <strong class="opt-title">Creas un proyecto</strong>
          <span class="opt-desc">Diseñás algo para apoyarla</span>
          <span class="ripple-origin" aria-hidden="true"></span>
        </button>
        <button class="opt" data-val="une" aria-pressed="false" style="--opt-accent:#1565C0">
          <span class="opt-emoji" aria-hidden="true">🤝</span>
          <strong class="opt-title">Te unes a una org.</strong>
          <span class="opt-desc">Buscás quién ya lo está haciendo</span>
          <span class="ripple-origin" aria-hidden="true"></span>
        </button>
      </div>

      <div class="feedback-toast" id="fb2" aria-live="assertive"></div>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════
       S5 — DUDA EXISTENCIAL (escena nueva)
       ════════════════════════════════════════════════════════ -->
  <div class="gs gs--doubt" id="gs5" role="region" aria-label="Reflexión" aria-hidden="true">
    <div class="orb-bg" aria-hidden="true">
      <div class="orb orb-doubt-1"></div>
      <div class="orb orb-doubt-2"></div>
    </div>
    <div class="doubt-stage">
      <div class="doubt-lines" id="doubt-lines" aria-live="polite" aria-atomic="false"></div>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════
       S6 — REVELACIÓN DE IDENTIDAD + RESULTADO
       ════════════════════════════════════════════════════════ -->
  <div class="gs gs--result-screen" id="gs6" role="region" aria-label="Tu perfil de impacto" aria-hidden="true">
    <div class="result-bg" id="result-bg" aria-hidden="true"></div>
    <div class="gs-inner gs-inner--result">

      <!-- Secuencia reveal de texto -->
      <div class="reveal-stage" id="reveal-stage" aria-live="polite" aria-atomic="false"></div>

      <!-- Badge del perfil (aparece tras reveal) -->
      <div class="result-badge-group" id="result-badge-group">
