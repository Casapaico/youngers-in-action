  function buildResult(): void {
    const cat = getTopCategory();
    const p = PROFILES[cat];

    const iconEl   = document.getElementById('result-icon');
    const titleEl  = document.getElementById('result-title');
    const descEl   = document.getElementById('result-desc');
    const bgEl     = document.getElementById('result-bg');
    const ringEl   = document.getElementById('result-ring');
    const tagsEl   = document.getElementById('ods-tags');
    const ctaTxtEl = document.getElementById('result-cta-txt');

    if (iconEl)  iconEl.textContent  = p.icon;
    if (titleEl) {
      titleEl.textContent = p.title;
      titleEl.style.textShadow = `0 0 32px ${p.color}55`;
    }
    if (descEl)  descEl.textContent  = p.desc;
    if (ctaTxtEl) ctaTxtEl.textContent = p.cta;

    if (bgEl) bgEl.style.background = `radial-gradient(ellipse at 50% -10%, ${p.colorAlpha} 0%, #0f0f16 58%)`;
    if (ringEl) {
      ringEl.style.background   = p.colorAlpha;
      ringEl.style.borderColor  = `${p.color}55`;
    }
    if (tagsEl) {
      tagsEl.innerHTML = p.ods
        .map(o => {
          const c = ODS_COLORS[o] ?? '#ffffff';
          return `<span class="ods-tag" style="border-color:${c}55;background:${c}18;color:${c}">${o}</span>`;
        })
        .join('');
    }

    // Desglose por área
    const breakdownEl = document.getElementById('area-breakdown');
    if (breakdownEl) {
      const scores = AREA_META.map(a => state.scores[a.key] ?? 0);
      const maxScore = Math.max(...scores, 1);
      breakdownEl.innerHTML =
        `<p class="area-breakdown-title">Desglose de impacto</p>` +
        AREA_META.map((a, i) => {
          const pts = scores[i];
          const pct = Math.round((pts / maxScore) * 100);
          return `
            <div class="area-row">
              <span class="area-row-icon" aria-hidden="true">${a.icon}</span>
              <span class="area-row-label">${a.label}</span>
              <div class="area-row-track">
                <div class="area-row-fill" data-pct="${pct}" style="background:${a.color}cc"></div>
              </div>
              <span class="area-row-val" data-target="${pts}" style="color:${a.color}">0</span>
            </div>`;
        }).join('');
    }

    setWorldState(3);
  }

  function animateImpactBar(): void {
    const pct     = state.impactPct;
    const cat     = getTopCategory();
    const color   = PROFILES[cat].color;
    const fillEl  = document.getElementById('im-fill');
    const trackEl = document.getElementById('im-track');
    const pctEl   = document.getElementById('im-pct');

    if (fillEl) {
      fillEl.style.background = color;
      fillEl.style.width = `${pct}%`;
    }
    if (trackEl) trackEl.setAttribute('aria-valuenow', String(pct));

    if (pctEl) {
      pctEl.style.color = color;
      let cur = 0;
      const dur = 1700;
      const t0  = performance.now();
      const run = (now: number) => {
        const prog   = Math.min((now - t0) / dur, 1);
        const eased  = 1 - Math.pow(1 - prog, 3);
        cur = Math.round(pct * eased);
        pctEl.textContent = `${cur}%`;
        if (prog < 1) requestAnimationFrame(run);
        else pctEl.textContent = `${pct}%`;
      };
      requestAnimationFrame(run);
    }

    // ODS tags pop-in stagger
    const tags = document.querySelectorAll<HTMLElement>('#ods-tags .ods-tag');
    if (tags.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      tags.forEach((tag, i) => {
        tag.style.animation = `tagPop 0.4s cubic-bezier(0.34,1.56,0.64,1) ${i * 100}ms both`;
      });
    }

    // Sheen en la barra al llegar al valor final
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setTimeout(() => {
        fillEl?.classList.add('im-fill--sheen');
      }, 1750);
    }
  }

  // ════════════════════════════════════════════════════════════
  // CTA BUILDER
  // ════════════════════════════════════════════════════════════
  function buildCTA(): void {
    const cat = getTopCategory();
    const p = PROFILES[cat];

    const nameEl  = document.getElementById('cta-profile-name');
    const statsEl = document.getElementById('cta-stats');

    if (nameEl) {
      nameEl.textContent = `${p.icon} ${p.title}`;
      nameEl.style.textDecorationColor = p.color;
    }

    const quoteEl = document.getElementById('cta-quote');
    if (quoteEl) quoteEl.innerHTML = p.quote;

    // Social proof count-up: 2,800 → 2,847
    const spNum = document.getElementById('social-proof-num');
    if (spNum && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const target = 2847;
      const from   = 2800;
      const dur    = 900;
      setTimeout(() => {
        const t0 = performance.now();
        const run = (now: number) => {
          const prog  = Math.min((now - t0) / dur, 1);
          const eased = 1 - Math.pow(1 - prog, 3);
          const val   = Math.round(from + (target - from) * eased);
          spNum.textContent = val.toLocaleString('en-US');
          if (prog < 1) requestAnimationFrame(run);
          else spNum.textContent = target.toLocaleString('en-US');
        };
        requestAnimationFrame(run);
      }, 350);
    }
    if (statsEl) {
      statsEl.innerHTML =
        `<div class="stat-chip">
          <span class="stat-chip-val" data-target="${state.impactPct}" data-suffix="%">0%</span>
          <span class="stat-chip-lbl">Impacto</span>
        </div>` +
        AREA_META.map(a => `
          <div class="stat-chip">
            <span class="stat-chip-val" data-target="${state.scores[a.key] ?? 0}" data-suffix="" style="color:${a.color}">0</span>
            <span class="stat-chip-lbl">${a.icon} ${a.label}</span>
          </div>`).join('');

      // Stagger de entrada por chip
      statsEl.querySelectorAll<HTMLElement>('.stat-chip').forEach((chip, i) => {
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          chip.style.animation = `siIn 0.38s cubic-bezier(0.22,1,0.36,1) both ${280 + i * 75}ms`;
        }
      });

      // Count-up por chip con stagger
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        statsEl.querySelectorAll<HTMLElement>('.stat-chip-val').forEach((el, i) => {
          const target = parseInt(el.dataset.target ?? '0', 10);
          const suffix = el.dataset.suffix ?? '';
          setTimeout(() => {
            const dur = 650;
            const t0  = performance.now();
            const run = (now: number) => {
              const prog  = Math.min((now - t0) / dur, 1);
              const eased = 1 - Math.pow(1 - prog, 3);
              el.textContent = `${Math.round(target * eased)}${suffix}`;
              if (prog < 1) requestAnimationFrame(run);
              else el.textContent = `${target}${suffix}`;
            };
            requestAnimationFrame(run);
          }, 420 + i * 90);
        });
      }
    }
  }

  // ════════════════════════════════════════════════════════════
  // CONFETTI
  // ════════════════════════════════════════════════════════════
  function launchConfetti(): void {
    sndCelebrate();
    haptic([18, 35, 18, 35, 45, 35, 80]);
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const wrap = document.getElementById('confetti-wrap');
    if (!wrap) return;
    wrap.innerHTML = '';

    // Colores de marca YIA
    const colors = ['#FFB800','#FFB800','#FFD152','#C5192D','#E63946','#1565C0','#ffffff','#ffffff'];

    function spawnBatch(count: number, delayBase: number): void {
      for (let i = 0; i < count; i++) {
        const el = document.createElement('div');
        el.className = 'confetti-piece';
        const rand = Math.random();
        // Forma: 30% streamer (largo), 40% círculo, 30% cuadro
        const isStreamer = rand > 0.70;
        const isCircle   = rand > 0.30;
        const baseSize   = 5 + Math.random() * 9;
        const w = isStreamer ? baseSize * 0.38 : baseSize;
        const h = isStreamer ? baseSize * 2.8  : baseSize;
        el.style.cssText = `
          left:${Math.random()*100}%;
          background:${colors[Math.floor(Math.random()*colors.length)]};
          width:${w}px; height:${h}px;
          border-radius:${isStreamer ? '2px' : (isCircle ? '50%' : '3px')};
          animation-duration:${2.0 + Math.random()*2.4}s;
          animation-delay:${delayBase + Math.random()*0.55}s;
          opacity:1;
        `;
        wrap.appendChild(el);
      }
    }

    spawnBatch(50, 0);                               // primera oleada
    setTimeout(() => spawnBatch(35, 0), 650);        // segunda oleada
  }

  // ════════════════════════════════════════════════════════════
  // RIPPLE
  // ════════════════════════════════════════════════════════════
  function addRipple(btn: HTMLElement, e: MouseEvent | null): void {
    const origin = btn.querySelector<HTMLElement>('.ripple-origin');
    if (!origin) return;
    const rect = btn.getBoundingClientRect();
    const size = Math.max(rect.width, rect.height) * 2.2;
    const cx = e ? e.clientX - rect.left : rect.width / 2;
    const cy = e ? e.clientY - rect.top  : rect.height / 2;
    const ripple = document.createElement('span');
    ripple.className = 'ripple';
    ripple.style.cssText = `width:${size}px;height:${size}px;left:${cx-size/2}px;top:${cy-size/2}px`;
    origin.appendChild(ripple);
    ripple.addEventListener('animationend', () => ripple.remove());
  }

  function pulsePts(id: string): void {
