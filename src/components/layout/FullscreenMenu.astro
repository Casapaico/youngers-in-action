---
const menuLinks = [
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'ODS', href: '/ods' },
  { label: 'Voluntariado', href: '/voluntariado' },
  { label: 'Contacto', href: '/contacto' },
];

const socialLinks = [
  { label: 'Instagram', href: 'https://www.instagram.com/youngersinaction/', icon: 'instagram' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/youngers-in-action/', icon: 'linkedin' },
  { label: 'Facebook', href: 'https://www.facebook.com/YoungersinAction/', icon: 'facebook' },
];

const currentPath = Astro.url.pathname;
---

<nav class="fullscreen-menu fixed inset-0 z-[60] flex flex-col bg-neutral-900" aria-label="Menú principal">

  <!-- Botón cerrar -->
  <div class="flex justify-end px-8 pt-6 md:px-16 lg:px-24">
    <button
      id="menu-close-btn"
      aria-label="Cerrar menú"
      class="flex h-12 w-12 items-center justify-center rounded-full transition-colors duration-200 hover:bg-white/10 group"
    >
      <svg class="h-6 w-6 text-white transition-colors duration-200 group-hover:text-[#FFB800]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <div class="flex flex-1 flex-col justify-center px-8 md:px-16 lg:px-24">
    <ul class="menu-links space-y-2 md:space-y-4" role="list">
      {menuLinks.map((link, i) => (
        <li
          class="menu-link-item overflow-hidden"
          style={`--stagger: ${i}`}
        >
          <a
            href={link.href}
            class:list={[
              'menu-link block font-display text-4xl font-bold text-white/80 transition-colors duration-200 hover:text-[#FFB800] md:text-6xl lg:text-7xl',
              currentPath === link.href || currentPath.startsWith(link.href + '/') ? 'text-[#FFB800]' : '',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Bottom: Contact + Social -->
  <div class="menu-footer border-t border-white/10 px-8 py-6 md:px-16 lg:px-24">
    <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <div class="text-sm text-white/50">
        <a href="mailto:youngers.global@gmail.com" class="transition-colors hover:text-white">
          youngers.global@gmail.com
        </a>
        <span class="mx-2">·</span>
        <span>Lima, Perú</span>
      </div>

      <div class="flex gap-4">
        {socialLinks.map((social) => (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/50 transition-colors hover:text-[#FFB800]"
            aria-label={social.label}
          >
            {social.icon === 'instagram' && (
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            )}
            {social.icon === 'linkedin' && (
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            )}
            {social.icon === 'facebook' && (
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>

<style>
  /* Menu hidden by default */
  .fullscreen-menu {
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .fullscreen-menu.is-open {
    pointer-events: auto;
    opacity: 1;
    visibility: visible;
  }

  /* Stagger animation for links */
  .menu-link-item .menu-link {
    transform: translateY(100%);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--stagger) * 60ms);
  }

  .fullscreen-menu.is-open .menu-link-item .menu-link {
    transform: translateY(0);
  }

  /* Footer slide up */
  .menu-footer {
    transform: translateY(20px);
    opacity: 0;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.3s,
                opacity 0.5s ease 0.3s;
  }

  .fullscreen-menu.is-open .menu-footer {
    transform: translateY(0);
    opacity: 1;
  }

  /* Hamburger X transformation when menu is open */
  :global(.fullscreen-menu.is-open ~ .minimal-header [data-line="1"]) {
    transform: translateY(4px) rotate(45deg);
  }

  :global(.fullscreen-menu.is-open ~ .minimal-header [data-line="2"]) {
    opacity: 0;
    transform: scaleX(0);
  }

  :global(.fullscreen-menu.is-open ~ .minimal-header [data-line="3"]) {
    width: 1.5rem;
    transform: translateY(-4px) rotate(-45deg);
  }
</style>

<script>
  // Close menu on link click
  function initMenuLinks() {
    const links = document.querySelectorAll('.fullscreen-menu .menu-link');
    const menu = document.querySelector('.fullscreen-menu');
    const toggle = document.querySelector('[data-menu-toggle]') as HTMLButtonElement;
    const closeBtn = document.getElementById('menu-close-btn');

    closeBtn?.addEventListener('click', () => {
      menu?.classList.remove('is-open');
      if (toggle) {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Abrir menú');
      }
      document.body.style.overflow = '';
    });

    links.forEach(link => {
      link.addEventListener('click', () => {
        menu?.classList.remove('is-open');
        if (toggle) {
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Abrir menú');
        }
        document.body.style.overflow = '';
      });
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu?.classList.contains('is-open')) {
        menu.classList.remove('is-open');
        if (toggle) {
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Abrir menú');
        }
        document.body.style.overflow = '';
        toggle?.focus();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMenuLinks);
  } else {
    initMenuLinks();
  }
  document.addEventListener('astro:page-load', initMenuLinks);
</script>
