---
interface FooterLink {
  label: string;
  href: string;
}

interface FooterSection {
  title: string;
  links: FooterLink[];
}

const footerSections: FooterSection[] = [
  {
    title: 'Navegación',
    links: [
      { label: 'Inicio', href: '/' },
      { label: 'Nosotros', href: '/nosotros' },
      { label: 'Proyectos', href: '/proyectos' },
      { label: 'Equipo', href: '/equipo' },
    ],
  },
  {
    title: 'ODS',
    links: [
      { label: 'Nuestros ODS', href: '/ods' },
      { label: 'Educación de Calidad', href: '/ods/educacion' },
      { label: 'Trabajo Decente', href: '/ods/trabajo' },
      { label: 'Acción por el Clima', href: '/ods/clima' },
    ],
  },
  {
    title: 'Involúcrate',
    links: [
      { label: 'Voluntariado', href: '/voluntariado' },
      { label: 'Donar', href: '/dona' },
      { label: 'Alianzas', href: '/alianzas' },
      { label: 'Contacto', href: '/contacto' },
    ],
  },
];

