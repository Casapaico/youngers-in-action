const currentYear = new Date().getFullYear();
---

<footer class="bg-neutral-900" role="contentinfo">
  <!-- Sección principal -->
  <div class="container-custom py-16">
    <div class="grid gap-12 lg:grid-cols-12">
      <!-- Columna de marca -->
      <div class="lg:col-span-4">
        <a href="/" class="inline-flex items-center gap-3" aria-label="Youngers in Action - Inicio">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-primary-400">
            <svg
              class="h-7 w-7 text-neutral-900"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
              <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
          </span>
          <span class="font-display text-2xl font-bold text-white">
            Youngers <span class="text-primary-400">in Action</span>
          </span>
        </a>
        <p class="mt-6 max-w-sm text-neutral-400 leading-relaxed">
          Somos una organización de jóvenes comprometidos con los Objetivos de Desarrollo
          Sostenible. Juntos construimos un futuro más justo y sostenible.
        </p>

        <!-- Redes sociales -->
        <div class="mt-8 flex gap-3">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                class="flex h-10 w-10 items-center justify-center rounded-full bg-neutral-800 text-neutral-400 transition-all hover:bg-primary-400 hover:text-neutral-900"
                aria-label={social.name}
              >
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={social.icon} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Columnas de enlaces -->
      <div class="grid gap-8 sm:grid-cols-3 lg:col-span-8">
        {
          footerSections.map((section) => (
            <div>
              <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-white">
                {section.title}
              </h3>
              <ul class="mt-4 space-y-3">
                {section.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-neutral-400 transition-colors hover:text-primary-400"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Barra inferior -->
  <div class="border-t border-neutral-800">
    <div class="container-custom flex flex-col items-center justify-between gap-4 py-6 sm:flex-row">
      <p class="text-sm text-neutral-500">
        &copy; {currentYear} Youngers in Action. Todos los derechos reservados.
      </p>
      <div class="flex gap-6 text-sm">
        <a href="/privacidad" class="text-neutral-500 transition-colors hover:text-neutral-300">
          Política de Privacidad
        </a>
        <a href="/terminos" class="text-neutral-500 transition-colors hover:text-neutral-300">
          Términos de Uso
        </a>
      </div>
    </div>
  </div>
</footer>
