---
interface Props {
  variant?: 'light' | 'dark' | 'yellow';
}

const { variant = 'light' } = Astro.props;
---

<header
  class:list={[
    'minimal-header fixed top-0 left-0 right-0 z-50 transition-all duration-300 [transition:opacity_0.3s,background-color_0.3s]',
    variant === 'yellow' ? 'bg-[#FFB800]' : '',
  ]}
  data-variant={variant}
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8">
    <!-- Logo -->
    <a href="/" class="relative z-10" aria-label="Youngers in Action - Inicio">
      <img
        src="/images/logoyia.png"
        alt="Youngers in Action"
        class="h-12 w-auto rounded-lg transition-all duration-300 sm:h-14"
        data-logo
      />
    </a>

    <!-- Hamburger Button -->
    <button
      class="menu-toggle relative z-10 flex h-12 w-12 flex-col items-center justify-center gap-[9px]"
      aria-label="Abrir menú"
      aria-expanded="false"
      data-menu-toggle
    >
      <span
        class:list={[
          'menu-line block h-[2.5px] w-[28px] rounded-full transition-all duration-300',
          variant === 'dark' ? 'bg-white' : 'bg-neutral-900',
        ]}
        data-line="1"
      />
      <span
        class:list={[
          'menu-line block h-[2.5px] w-[28px] rounded-full transition-all duration-300',
          variant === 'dark' ? 'bg-white' : 'bg-neutral-900',
        ]}
        data-line="2"
      />
      <span
        class:list={[
          'menu-line block h-[2.5px] w-[28px] rounded-full transition-all duration-300',
          variant === 'dark' ? 'bg-white' : 'bg-neutral-900',
        ]}
        data-line="3"
      />
    </button>
  </div>
</header>

<script>
  function initHeader() {
    const header = document.querySelector('.minimal-header') as HTMLElement;
    if (!header) return;

    const variant = header.dataset.variant;
    const logo = header.querySelector('[data-logo]') as HTMLImageElement;
    const lines = header.querySelectorAll('.menu-line') as NodeListOf<HTMLElement>;

    // Scroll detection — escucha el contenedor fullpage, no window
    const container = document.querySelector('.fullpage-container') as HTMLElement;
    const scrollTarget = container || window;

    const onScroll = () => {
      const scrollY = container ? container.scrollTop : window.scrollY;
      if (scrollY > 80) {
        header.setAttribute('data-scrolled', '');
        lines.forEach(l => {
          l.classList.remove('bg-white');
          l.classList.add('bg-neutral-900');
        });
      } else {
        header.removeAttribute('data-scrolled');
        if (variant === 'dark') {
          lines.forEach(l => {
            l.classList.add('bg-white');
            l.classList.remove('bg-neutral-900');
          });
        }
      }
    };

    scrollTarget.addEventListener('scroll', onScroll, { passive: true });

    // Hamburger toggle
    const toggle = header.querySelector('[data-menu-toggle]') as HTMLButtonElement;
    toggle?.addEventListener('click', () => {
      const menu = document.querySelector('.fullscreen-menu') as HTMLElement;
      const isOpen = menu?.classList.contains('is-open');

      if (isOpen) {
        menu?.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Abrir menú');
        document.body.style.overflow = '';
        // Restore lines based on scroll state
        lines.forEach(l => l.classList.remove('bg-white'));
        if (header.hasAttribute('data-scrolled') || variant !== 'dark') {
          lines.forEach(l => l.classList.add('bg-neutral-900'));
        } else {
          lines.forEach(l => l.classList.add('bg-white'));
        }
      } else {
        menu?.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Cerrar menú');
        document.body.style.overflow = 'hidden';
        // When menu is open, lines are always white (menu bg is dark)
        lines.forEach(l => {
          l.classList.remove('bg-neutral-900');
          l.classList.add('bg-white');
        });
      }
    });
  }

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }
  document.addEventListener('astro:page-load', initHeader);
</script>
