---
import Button from '../ui/Button.astro';

type Size = 'sm' | 'md' | 'lg' | 'full';
type Align = 'left' | 'center';

interface CTA {
  label: string;
  href: string;
}

interface Image {
  src: string;
  alt: string;
}

interface Props {
  title: string;
  subtitle?: string;
  image?: Image;
  images?: Image[];
  slideInterval?: number;
  overlay?: boolean;
  align?: Align;
  primaryCTA?: CTA;
  secondaryCTA?: CTA;
  size?: Size;
}

const {
  title,
  subtitle,
  image,
  images,
  slideInterval = 5000,
  overlay = true,
  align = 'center',
  primaryCTA,
  secondaryCTA,
  size = 'lg',
} = Astro.props;

const sizeStyles: Record<Size, string> = {
  sm: 'min-h-[50vh]',
  md: 'min-h-[65vh]',
  lg: 'min-h-[80vh]',
  full: 'min-h-screen',
};

const alignStyles: Record<Align, string> = {
  left: 'text-left items-start',
  center: 'text-center items-center',
};

const contentAlignStyles: Record<Align, string> = {
  left: 'items-start',
  center: 'items-center',
};

const hasSlideshow = images && images.length > 1;
const allImages = images || (image ? [image] : []);
---

<section
  class:list={[
    'relative flex items-center justify-center overflow-hidden',
    sizeStyles[size],
  ]}
>
  {/* Slideshow de imágenes */}
  {allImages.length > 0 && (
    <div class="hero-slideshow absolute inset-0 -z-10">
      {allImages.map((img, index) => (
        <picture
          class:list={[
            'hero-slide absolute inset-0 transition-opacity duration-1000',
            index === 0 ? 'opacity-100' : 'opacity-0'
          ]}
          data-slide-index={index}
        >
          <img
            src={img.src}
            alt={img.alt}
            class="h-full w-full object-cover"
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </picture>
      ))}
    </div>
  )}

  {/* Overlay */}
  {allImages.length > 0 && overlay && (
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-b from-neutral-900/70 via-neutral-900/50 to-neutral-900/70"
      aria-hidden="true"
    />
  )}

  {/* Fondo degradado si no hay imágenes */}
  {allImages.length === 0 && (
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-br from-secondary-900 via-secondary-800 to-neutral-900"
      aria-hidden="true"
    />
  )}

  {/* Contenido */}
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <div
      class:list={[
        'flex max-w-4xl flex-col gap-6',
        alignStyles[align],
        align === 'center' && 'mx-auto',
      ]}
    >
      <h1
        class="font-display text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl lg:text-7xl animate-fade-up"
      >
        {title}
      </h1>

      {subtitle && (
        <p
          class="max-w-2xl text-lg text-neutral-200 sm:text-xl md:text-2xl animate-fade-up"
          style="animation-delay: 100ms;"
        >
          {subtitle}
        </p>
      )}

      {(primaryCTA || secondaryCTA) && (
        <nav
          class:list={[
            'mt-4 flex flex-col gap-4 sm:flex-row',
            contentAlignStyles[align],
          ]}
          style="animation-delay: 200ms;"
          aria-label="Acciones principales"
        >
          {primaryCTA && (
            <Button href={primaryCTA.href} variant="primary" size="lg">
              {primaryCTA.label}
            </Button>
          )}
          {secondaryCTA && (
            <Button href={secondaryCTA.href} variant="outline" size="lg" class="border-white text-white hover:bg-white/10">
              {secondaryCTA.label}
            </Button>
          )}
        </nav>
      )}

      <slot />
    </div>
  </div>

  {/* Indicadores del slideshow */}
  {hasSlideshow && (
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex gap-2 z-10">
      {allImages.map((_, index) => (
        <button
          type="button"
          class:list={[
            'hero-indicator h-2 w-8 rounded-full transition-all duration-300',
            index === 0 ? 'bg-white' : 'bg-white/40 hover:bg-white/60'
          ]}
          data-indicator-index={index}
          aria-label={`Ir a imagen ${index + 1}`}
        />
      ))}
    </div>
  )}
</section>

{hasSlideshow && (
  <script define:vars={{ slideInterval, totalSlides: allImages.length }}>
    document.addEventListener('DOMContentLoaded', () => {
      const slides = document.querySelectorAll('.hero-slide');
      const indicators = document.querySelectorAll('.hero-indicator');
      let currentSlide = 0;
      let intervalId;

      function showSlide(index) {
        slides.forEach((slide, i) => {
          slide.classList.toggle('opacity-100', i === index);
          slide.classList.toggle('opacity-0', i !== index);
        });
        indicators.forEach((indicator, i) => {
          indicator.classList.toggle('bg-white', i === index);
          indicator.classList.toggle('bg-white/40', i !== index);
        });
        currentSlide = index;
      }

      function nextSlide() {
        const next = (currentSlide + 1) % totalSlides;
        showSlide(next);
      }

      function startAutoplay() {
        intervalId = setInterval(nextSlide, slideInterval);
      }

      function resetAutoplay() {
        clearInterval(intervalId);
        startAutoplay();
      }

      // Click en indicadores
      indicators.forEach((indicator, index) => {
        indicator.addEventListener('click', () => {
          showSlide(index);
          resetAutoplay();
        });
      });

      // Iniciar autoplay
      startAutoplay();
    });
  </script>
)}
