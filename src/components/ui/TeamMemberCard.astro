---
interface SocialLink {
  platform: 'linkedin' | 'instagram' | 'twitter' | 'email';
  url: string;
}

interface Props {
  name: string;
  role: string;
  image?: {
    src: string;
    alt?: string;
  };
  bio?: string;
  socials?: SocialLink[];
  featured?: boolean;
}

const { name, role, image, bio, socials = [], featured = false } = Astro.props;

const socialIcons: Record<string, string> = {
  linkedin: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>`,
  instagram: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>`,
  twitter: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  email: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
};
---

<article
  class:list={[
    'group relative overflow-hidden rounded-2xl bg-white transition-all duration-300',
    featured
      ? 'ring-2 ring-primary-400 shadow-lg hover:shadow-xl'
      : 'ring-1 ring-neutral-200 hover:ring-primary-300 hover:shadow-lg',
  ]}
>
  <!-- Image -->
  <div class="relative aspect-[4/5] overflow-hidden bg-neutral-100">
    {image ? (
      <img
        src={image.src}
        alt={image.alt || name}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-primary-100 to-secondary-100">
        <span class="text-6xl text-primary-400">
          {name.split(' ').map(n => n[0]).join('').slice(0, 2)}
        </span>
      </div>
    )}

    <!-- Featured badge -->
    {featured && (
      <div class="absolute left-4 top-4">
        <span class="inline-flex items-center rounded-full bg-primary-400 px-3 py-1 text-xs font-semibold text-neutral-900">
          Fundador/a
        </span>
      </div>
    )}

    <!-- Social overlay -->
    {socials.length > 0 && (
      <div class="absolute inset-0 flex items-end justify-center bg-gradient-to-t from-neutral-900/80 via-neutral-900/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
        <div class="flex gap-3 pb-6">
          {socials.map((social) => (
            <a
              href={social.url}
              target={social.platform !== 'email' ? '_blank' : undefined}
              rel={social.platform !== 'email' ? 'noopener noreferrer' : undefined}
              class="flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-neutral-700 transition-all hover:bg-primary-400 hover:text-neutral-900 hover:scale-110"
              aria-label={`${name} en ${social.platform}`}
            >
              <Fragment set:html={socialIcons[social.platform]} />
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="p-5">
    <h3 class="font-display text-lg font-bold text-neutral-900">
      {name}
    </h3>
    <p class="mt-1 text-sm font-medium text-primary-600">
      {role}
    </p>
    {bio && (
      <p class="mt-3 text-sm leading-relaxed text-neutral-600 line-clamp-3">
        {bio}
      </p>
    )}
  </div>
</article>
