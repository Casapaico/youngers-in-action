---
import type { HTMLAttributes } from 'astro/types';

type Background = 'white' | 'gray' | 'primary' | 'secondary' | 'dark';
type Spacing = 'sm' | 'md' | 'lg' | 'xl' | 'none';

interface Props extends HTMLAttributes<'section'> {
  id?: string;
  background?: Background;
  spacing?: Spacing;
  container?: boolean;
}

const {
  id,
  background = 'white',
  spacing = 'lg',
  container = true,
  class: className,
  ...attrs
} = Astro.props;

const backgroundStyles: Record<Background, string> = {
  white: 'bg-white',
  gray: 'bg-neutral-50',
  primary: 'bg-primary-400 text-neutral-900',
  secondary: 'bg-secondary-600 text-white',
  dark: 'bg-neutral-900 text-white',
};

const spacingStyles: Record<Spacing, string> = {
  none: '',
  sm: 'py-8 md:py-12',
  md: 'py-12 md:py-16',
  lg: 'py-16 md:py-24',
  xl: 'py-24 md:py-32',
};

const classes = [
  backgroundStyles[background],
  spacingStyles[spacing],
  className,
].filter(Boolean).join(' ');

const containerClasses = container ? 'mx-auto max-w-7xl px-4 sm:px-6 lg:px-8' : '';
---

<section
  id={id}
  class={classes}
  {...attrs}
>
  {container ? (
    <div class={containerClasses}>
      <slot />
    </div>
  ) : (
    <slot />
  )}
</section>
