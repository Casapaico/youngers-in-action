---
type Size = 'sm' | 'md' | 'lg';

interface Props {
  number: number;
  title: string;
  description?: string;
  href?: string;
  size?: Size;
}

const {
  number,
  title,
  description,
  href,
  size = 'md',
} = Astro.props;

// Colores oficiales ONU para cada ODS
const odsColors: Record<number, string> = {
  1: '#E5243B',   // Fin de la pobreza
  2: '#DDA63A',   // Hambre cero
  3: '#4C9F38',   // Salud y bienestar
  4: '#C5192D',   // Educación de calidad
  5: '#FF3A21',   // Igualdad de género
  6: '#26BDE2',   // Agua limpia y saneamiento
  7: '#FCC30B',   // Energía asequible
  8: '#A21942',   // Trabajo decente
  9: '#FD6925',   // Industria e innovación
  10: '#DD1367',  // Reducción de desigualdades
  11: '#FD9D24',  // Ciudades sostenibles
  12: '#BF8B2E',  // Producción responsable
  13: '#3F7E44',  // Acción por el clima
  14: '#0A97D9',  // Vida submarina
  15: '#56C02B',  // Vida terrestre
  16: '#00689D',  // Paz y justicia
  17: '#19486A',  // Alianzas
};

// Nombres oficiales de los ODS
const odsNames: Record<number, string> = {
  1: 'Fin de la pobreza',
  2: 'Hambre cero',
  3: 'Salud y bienestar',
  4: 'Educación de calidad',
  5: 'Igualdad de género',
  6: 'Agua limpia y saneamiento',
  7: 'Energía asequible y no contaminante',
  8: 'Trabajo decente y crecimiento económico',
  9: 'Industria, innovación e infraestructura',
  10: 'Reducción de las desigualdades',
  11: 'Ciudades y comunidades sostenibles',
  12: 'Producción y consumo responsables',
  13: 'Acción por el clima',
  14: 'Vida submarina',
  15: 'Vida de ecosistemas terrestres',
  16: 'Paz, justicia e instituciones sólidas',
  17: 'Alianzas para lograr los objetivos',
};

const color = odsColors[number] || '#666666';
const officialName = odsNames[number] || title;

const sizeStyles: Record<Size, { card: string; number: string; title: string; desc: string }> = {
  sm: {
    card: 'p-4',
    number: 'text-3xl',
    title: 'text-sm',
    desc: 'text-xs',
  },
  md: {
    card: 'p-5',
    number: 'text-4xl',
    title: 'text-base',
    desc: 'text-sm',
  },
  lg: {
    card: 'p-6',
    number: 'text-5xl',
    title: 'text-lg',
    desc: 'text-base',
  },
};

const Tag = href ? 'a' : 'article';
---

<Tag
  href={href}
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-xl transition-all duration-300',
    href && 'cursor-pointer hover:scale-[1.02] hover:shadow-xl',
    sizeStyles[size].card,
  ]}
  style={`background-color: ${color};`}
  aria-label={href ? `Ver más sobre ODS ${number}: ${officialName}` : undefined}
>
  <header class="flex items-start justify-between gap-4">
    <span
      class:list={[
        'font-display font-bold text-white/90',
        sizeStyles[size].number,
      ]}
      aria-hidden="true"
    >
      {number}
    </span>

    {href && (
      <span
        class="flex h-8 w-8 items-center justify-center rounded-full bg-white/20 text-white opacity-0 transition-opacity group-hover:opacity-100"
        aria-hidden="true"
      >
        <svg
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"
          />
        </svg>
      </span>
    )}
  </header>

  <div class="mt-auto pt-4">
    <h3
      class:list={[
        'font-display font-semibold leading-tight text-white',
        sizeStyles[size].title,
      ]}
    >
      {title || officialName}
    </h3>

    {description && (
      <p
        class:list={[
          'mt-2 leading-relaxed text-white/80',
          sizeStyles[size].desc,
        ]}
      >
        {description}
      </p>
    )}
  </div>

  <span class="sr-only">
    Objetivo de Desarrollo Sostenible {number}: {officialName}
  </span>
</Tag>
