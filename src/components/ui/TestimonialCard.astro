---
import Card from './Card.astro';

interface Image {
  src: string;
  alt: string;
}

interface Props {
  quote: string;
  author: string;
  role?: string;
  image?: Image;
  rating?: number;
}

const {
  quote,
  author,
  role,
  image,
  rating,
} = Astro.props;

// Limitar rating entre 1 y 5
const safeRating = rating ? Math.min(5, Math.max(1, Math.round(rating))) : null;
---

<Card variant="outlined" hoverable={false} class="h-full">
  <figure class="flex h-full flex-col">
    {safeRating && (
      <div class="mb-4 flex gap-1" role="img" aria-label={`Valoración: ${safeRating} de 5 estrellas`}>
        {[1, 2, 3, 4, 5].map((star) => (
          <svg
            class:list={[
              'h-5 w-5',
              star <= safeRating ? 'text-primary-400' : 'text-neutral-200',
            ]}
            fill="currentColor"
            viewBox="0 0 20 20"
            aria-hidden="true"
          >
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
      </div>
    )}

    <blockquote class="flex-1">
      <svg
        class="mb-3 h-8 w-8 text-primary-300"
        fill="currentColor"
        viewBox="0 0 32 32"
        aria-hidden="true"
      >
        <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z" />
      </svg>

      <p class="text-lg leading-relaxed text-neutral-700">
        {quote}
      </p>
    </blockquote>

    <figcaption class="mt-6 flex items-center gap-4 border-t border-neutral-100 pt-6">
      {image ? (
        <img
          src={image.src}
          alt={image.alt}
          class="h-12 w-12 rounded-full object-cover ring-2 ring-primary-100"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span
          class="flex h-12 w-12 items-center justify-center rounded-full bg-primary-100 text-lg font-semibold text-primary-600"
          aria-hidden="true"
        >
          {author.charAt(0).toUpperCase()}
        </span>
      )}

      <div>
        <cite class="not-italic font-semibold text-neutral-900">
          {author}
        </cite>
        {role && (
          <p class="text-sm text-neutral-500">
            {role}
          </p>
        )}
      </div>
    </figcaption>
  </figure>
</Card>
