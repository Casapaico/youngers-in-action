---
import type { HTMLAttributes } from 'astro/types';

type InputType = 'text' | 'email' | 'password' | 'tel' | 'url' | 'number' | 'search';

interface Props extends Omit<HTMLAttributes<'input'>, 'type'> {
  type?: InputType;
  label?: string;
  error?: string;
  hint?: string;
  required?: boolean;
  fullWidth?: boolean;
  textarea?: boolean;
  rows?: number;
}

const {
  type = 'text',
  label,
  error,
  hint,
  required = false,
  fullWidth = true,
  textarea = false,
  rows = 4,
  id,
  name,
  class: className,
  ...attrs
} = Astro.props;

const inputId = id || name || `input-${Math.random().toString(36).slice(2, 9)}`;
const errorId = error ? `${inputId}-error` : undefined;
const hintId = hint ? `${inputId}-hint` : undefined;

const inputClasses = [
  'block w-full rounded-xl border px-4 py-3',
  'text-neutral-900 placeholder:text-neutral-400',
  'transition-colors duration-200',
  'focus:outline-none focus:ring-2 focus:ring-offset-0',
  error
    ? 'border-red-300 focus:border-red-500 focus:ring-red-500/20'
    : 'border-neutral-300 focus:border-primary-400 focus:ring-primary-400/20',
  'disabled:bg-neutral-100 disabled:cursor-not-allowed',
].join(' ');

const labelClasses = [
  'block text-sm font-medium text-neutral-700 mb-2',
].join(' ');
---

<div class:list={['relative', fullWidth && 'w-full', className]}>
  <!-- Label -->
  {label && (
    <label for={inputId} class={labelClasses}>
      {label}
      {required && (
        <span class="ml-1 text-red-500" aria-hidden="true">*</span>
      )}
    </label>
  )}

  <!-- Input o Textarea -->
  {textarea ? (
    <textarea
      id={inputId}
      name={name}
      rows={rows}
      class={inputClasses}
      required={required}
      aria-required={required}
      aria-invalid={!!error}
      aria-describedby={[errorId, hintId].filter(Boolean).join(' ') || undefined}
      {...attrs}
    />
  ) : (
    <input
      type={type}
      id={inputId}
      name={name}
      class={inputClasses}
      required={required}
      aria-required={required}
      aria-invalid={!!error}
      aria-describedby={[errorId, hintId].filter(Boolean).join(' ') || undefined}
      {...attrs}
    />
  )}

  <!-- Hint text -->
  {hint && !error && (
    <p id={hintId} class="mt-2 text-sm text-neutral-500">
      {hint}
    </p>
  )}

  <!-- Error message -->
  {error && (
    <p id={errorId} class="mt-2 flex items-center gap-1.5 text-sm text-red-600" role="alert">
      <svg
        class="h-4 w-4 flex-shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
        />
      </svg>
      {error}
    </p>
  )}
</div>
