---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'default' | 'elevated' | 'outlined' | 'filled';

interface Props extends HTMLAttributes<'article'> {
  variant?: Variant;
  href?: string;
  image?: string;
  imageAlt?: string;
  aspectRatio?: 'video' | 'square' | 'portrait';
  hoverable?: boolean;
}

const {
  variant = 'default',
  href,
  image,
  imageAlt = '',
  aspectRatio = 'video',
  hoverable = true,
  class: className,
  ...attrs
} = Astro.props;

const baseStyles = [
  'group relative flex flex-col overflow-hidden rounded-2xl',
  'transition-all duration-300',
];

const variantStyles: Record<Variant, string> = {
  default: 'bg-white',
  elevated: 'bg-white shadow-lg shadow-neutral-200/50',
  outlined: 'bg-white border border-neutral-200',
  filled: 'bg-neutral-50',
};

const hoverStyles = hoverable
  ? 'hover:shadow-xl hover:shadow-neutral-200/50 hover:-translate-y-1'
  : '';

const aspectStyles: Record<string, string> = {
  video: 'aspect-video',
  square: 'aspect-square',
  portrait: 'aspect-[3/4]',
};

const classes = [
  ...baseStyles,
  variantStyles[variant],
  hoverStyles,
  className,
].filter(Boolean).join(' ');

const Tag = href ? 'a' : 'article';
---

<Tag
  href={href}
  class={classes}
  {...attrs}
>
  <!-- Imagen -->
  {image && (
    <div class:list={['relative overflow-hidden bg-neutral-100', aspectStyles[aspectRatio]]}>
      <img
        src={image}
        alt={imageAlt}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
      <!-- Slot para overlay sobre la imagen -->
      <slot name="image-overlay" />
    </div>
  )}

  <!-- Header opcional -->
  <slot name="header" />

  <!-- Contenido principal -->
  <div class="flex flex-1 flex-col p-6">
    <slot />
  </div>

  <!-- Footer opcional -->
  <slot name="footer" />

  <!-- Link overlay para cards clickeables -->
  {href && (
    <span class="absolute inset-0 z-10" aria-hidden="true" />
  )}
</Tag>
